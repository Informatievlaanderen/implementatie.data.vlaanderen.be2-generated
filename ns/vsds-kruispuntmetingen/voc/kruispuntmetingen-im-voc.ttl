@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Instant> a rdfs:Class;
  rdfs:label "Moment"@nl .

<http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Object> a rdfs:Class;
  rdfs:label "TemporeleEntiteit"@nl .

<http://def.isotc211.org/iso19115/2006/DataQualityInformation#DQ_Element> a rdfs:Class;
  rdfs:label "Kwaliteitselement"@nl .

skos:Concept a rdfs:Class;
  rdfs:label "Verkeerskenmerktype"@nl,
    "Voertuigtype"@nl,
    "Verkeersdeelnemertype"@nl,
    "Rijstrooktype"@nl .

prov:Location a rdfs:Class;
  rdfs:label "Locatie"@nl .

<https://data.vlaanderen.be/ns/weg#Rijrichting> a rdfs:Class;
  rdfs:label "Rijrichting"@nl .

<https://data.vlaanderen.be/ns/verkeersmetingen#Fietspad> a owl:Class;
  rdfs:label "Fietspad"@nl;
  <http://purl.org/vocab/vann/usageNote> "Maakt geen deel uit vd rijbaan (deel van de wegbaan ingericht voor het verkeer van Voertuigen), bvb auto's mogen niet op een Fietspad rijden of stationeren. OPGELET: Niet te verwarren met fietssuggestiestroken (wel deel vd rijbaan) of met de zijstroken ve middenrijbaan (geen deel vd rijbaan maar waarop mag gereden worden door auto's om tegenliggers te ontwijken). Fietspaden kunnen aanliggend zijn aan de rijbaan of vrijliggend of zelfs een eigen wegbaan hebben (in dat laatste geval worden ze door een eigen Wegsegment voorgesteld)."@nl;
  rdfs:comment "Deel van de wegbaan uitsluitend bedoeld voor fietsverkeer."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:subClassOf <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersdomeinobject>,
    <https://data.vlaanderen.be/ns/transportnetwerk#Transporteigenschap>,
    <https://data.vlaanderen.be/ns/verkeersmetingen#Wegdeel> .

<https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeettraject.netwerkreferentie> a owl:ObjectProperty;
  rdfs:label "netwerkReferentie"@nl;
  <http://purl.org/vocab/vann/usageNote> """Nuttig als men weet langs welk Wegsegment het traject loopt en aan welke kant van de weg en op welke afstand van het beginpunt. Alternatief voor of aanvulling op coördinaten. Ook noodzakelijk om aan te geven over welk Wegsegment en aan welke kant ervan de Voertuigen rijden waarvan men bvb de snelheid meet.
"""@nl;
  rdfs:comment "Referentie naar het Netwerkelement waarlangs het Verkeersmeettraject loopt of dat door dat traject bemonsterd wordt."@nl;
  rdfs:domain <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeettraject>;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:range <https://data.vlaanderen.be/ns/netwerk#Netwerkreferentie> .

<https://data.vlaanderen.be/ns/verkeersmetingen#Voetpad> a owl:Class;
  rdfs:label "Voetpad"@nl;
  <http://purl.org/vocab/vann/usageNote> "Is per defintie afgescheiden van de rijbaan, typisch via een boordsteen en verhoogde ligging."@nl;
  rdfs:comment "Deel van de wegbaan bedoeld voor voetgangers."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:subClassOf <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersdomeinobject>,
    <https://data.vlaanderen.be/ns/transportnetwerk#Transporteigenschap>,
    <https://data.vlaanderen.be/ns/verkeersmetingen#Wegdeel> .

<https://data.vlaanderen.be/ns/verkeersmetingen#bemonsterdObject> a owl:ObjectProperty;
  rdfs:label "bemonsterdObject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb het Voertuig of het Wegsegment waarvan men een Verkeerskenmerk bepaalt."@nl;
  rdfs:comment "Verwijzing naar het Verkeersdomeinobject waarop de meting betrekking heeft en waarvoor het Verkeersbemonsteringsobject representatief is."@nl;
  rdfs:domain <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersbemonsteringsobject>;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:range <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersdomeinobject>;
  rdfs:subPropertyOf <http://def.isotc211.org/iso19156/2011/SamplingFeature#SF_SamplingFeature.sampledFeature> .

<https://data.vlaanderen.be/ns/verkeersmetingen#geobserveerdKenmerk> a rdf:Property;
  rdfs:label "Verkeerstelling.geobserveerdKenmerk"@nl,
    "Verkeerssnelheidsmeting.geobserveerdKenmerk"@nl;
  rdfs:comment """Object dat door de Verkeerstelling wordt geobserveerd.	"""@nl,
    """Object dat door de Verkeerssnelheidsmetingen wordt geobserveerd.	"""@nl;
  rdfs:domain <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerstelling>,
    <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerssnelheidsmeting>;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen> .

<https://data.vlaanderen.be/ns/verkeersmetingen#geobserveerdObject> a owl:ObjectProperty;
  rdfs:label "geobserveerdObject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Dat kan het Verkeersdomeinobject zelf zijn of een proxy ervan, ttz een Verkeersbemonsteringsobject. OPMERKING: In dat laatste geval weet men soms pas na het observeren welk real-world Object men juist geobserveerd heeft. Bvb in een Verkeersmeetpunt weet men niet op voorhand welke de objecten zullen zijn waarvan men de snelheid wil vaststellen."@nl;
  rdfs:comment "Het Verkeersobject dat geobserveerd wordt."@nl;
  rdfs:domain <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeting>;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:range <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersobject>;
  rdfs:subPropertyOf <http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.featureOfInterest> .

<https://data.vlaanderen.be/ns/verkeersmetingen#kenmerktype> a rdf:Property;
  rdfs:label "Verkeerstellingkenmerk.kenmerktype"@nl,
    "Verkeerssnelheidsmetingkenmerk.kenmerktype"@nl;
  rdfs:comment "Kenmerktype 'aantal' is het specifieke kenmerktype van de verkeerstelling"@nl,
    "Kenmerktype 'snelheid' is het specifieke kenmerktype van de verkeerssnelheidsmeting"@nl;
  rdfs:domain <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerstellingskenmerk>,
    <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerssnelheidskenmerk>;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen> .

<https://data.vlaanderen.be/ns/verkeersmetingen#ligging> a owl:ObjectProperty;
  rdfs:label "ligging"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb de coördinaten of het adres of een verwijzing naar een meetpunt of ander Bemonsteringsobject. Meerdere verschillende types van locaties kunnen worden opgegeven (bvb adres èn coördinaten). Als de Sensor een meetinstallatie is evt de verschillende meetpunten die worden omvat of een omschrijvende polygoon. OPGELET: De locatie van de Sensor is niet noodzakelijk de positie waar de Observatie gebeurt, die wordt in de eerste plaats gegeven door de ligging vh Bemonsteringsobject. Dit attribuut laat vooral toe om posities van Sensoren te beschrijven los vd metingen die er gebeuren."@nl;
  rdfs:comment "Locatie van de Sensor."@nl;
  rdfs:domain <http://www.w3.org/ns/sosa/Sensor>;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:range prov:Location .

<https://data.vlaanderen.be/ns/verkeersmetingen#rijstrook> a owl:ObjectProperty;
  rdfs:label "rijstrook"@nl;
  <http://purl.org/vocab/vann/usageNote> "De identificator moet getypeerd worden bvb volgens het systeem dat werd gehanteerd om de Rijstroken te nummeren. Bvb het schema van DATEX II waar over de volledige breedte van de weg van links naar rechts wordt genummerd."@nl;
  rdfs:comment "Identificator van de Rijstrook."@nl;
  rdfs:domain <https://data.vlaanderen.be/ns/verkeersmetingen#Rijstrook>;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:range <http://www.w3.org/ns/adms#Identifier> .

<https://data.vlaanderen.be/ns/verkeersmetingen#tellingresultaat> a owl:DatatypeProperty;
  rdfs:label "Verkeerstelling.tellingresultaat"@nl;
  rdfs:comment "De waarde van het geobserveerdKenmerk als resultaat van de Verkeerstelling (aantal)."@nl;
  rdfs:domain <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerstelling>;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:range xsd:double .

<https://data.vlaanderen.be/ns/verkeersmetingen#verkeersdeelnemerType> a owl:ObjectProperty;
  rdfs:label "verkeersdeelnemertype"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb \"Voetganger\" als men enkel het aantal Voertgangers wil tellen in een Meetpunt. Enkel noodzakelijk voor Verkeersdomeinobjecten die zelf geen Verkeersdeelnemer zijn maar bvb een Wegsegment of Rijstrook etc."@nl;
  rdfs:comment "Soort Verkeersdeelnemer waarvan men het Verkeerskenmerk meet."@nl;
  rdfs:domain <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerskenmerk>;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:range skos:Concept .

<https://data.vlaanderen.be/ns/verkeersmetingen#voertuigType> a owl:ObjectProperty;
  rdfs:label "voertuigType"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb \"Fiets\" als men enkel het aantal fietsen wil tellen in een Meetpunt. Enkel noodzakelijk voor Verkeersdomeinobjecten die zelf geen Voertuig zijn maar bvb een Wegsegment of Rijstrook etc."@nl;
  rdfs:comment "Soort Voertuig waarvan men het Verkeerskenmerk meet."@nl;
  rdfs:domain <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerskenmerk>;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:range <https://data.vlaanderen.be/ns/transportnetwerk#Voertuigtype> .

<https://data.vlaanderen.be/ns/verkeersmetingen#waardeverschaffer> a owl:ObjectProperty;
  rdfs:label "waardeverschaffer"@nl;
  <http://purl.org/vocab/vann/usageNote> "Die meting verschaft ahw een waarde voor het Verkeerskenmerk dat van het Verkeersobject wordt gemeten."@nl;
  rdfs:comment "Verwijzing naar een Verkeersmeting die op het geobserveerdObject plaatsvondt."@nl;
  rdfs:domain <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersobject>;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:range <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeting>;
  rdfs:subPropertyOf <https://data.vlaanderen.be/ns/observaties-en-metingen#Object.waardeverschaffer> .

<http://def.isotc211.org/iso19156/2011/Measurement#OM_Measurement.result> a rdf:Property;
  rdfs:label "resultaat"@nl .

<http://def.isotc211.org/iso19156/2011/SamplingCurve#SF_SamplingCurve.shape> a rdf:Property;
  rdfs:label "geometrie"@nl .

dc11:type a rdf:Property;
  rdfs:label "type"@nl,
    "rijstrooktype"@nl .

<https://data.vlaanderen.be/ns/netwerk#netwerkreferentie> a rdf:Property;
  rdfs:label "netwerkreferentie"@nl .

<https://data.vlaanderen.be/ns/verkeersmetingen#Rijstrook> a owl:Class;
  rdfs:label "Rijstrook"@nl;
  <http://purl.org/vocab/vann/usageNote> """Onder rijbaan verstaan we dat deel van de wegbaan ingericht om met een Voertuig over te rijden. Door de rijbaan op te splitsen krijgt men een meer gecontroleerde verkeersstroom, in de eerste plaats omdat de rijrichtingen of bvb doorgaand en afslaand verkeer gescheiden worden en ook door de breedte te beperken zodat er maar één Voertuig tegelijk doorkan. Rijstroken worden typisch afgebakend dmv wegmarkeringen, bvb een witte doorlopende of onderbroken streep. OPMERKING: Voetpaden of Fietspaden zijn geen Rijstroken aangezien ze niet bedoeld zijn om met een auto over te rijden en dus geen deel zijn van de rijbaan.
"""@nl;
  rdfs:comment "In de langsrichting begrensd deel van de rijbaan, bedoeld om de verkeersstroom te geleiden in een bepaalde richting en met doorgaans de breedte van één Voertuig."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:subClassOf <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersdomeinobject>,
    <https://data.vlaanderen.be/ns/transportnetwerk#Transporteigenschap>,
    <https://data.vlaanderen.be/ns/verkeersmetingen#Wegdeel> .

<https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeettraject> a owl:Class;
  rdfs:label "Verkeersmeettraject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Dit is een afstand langs de weg waar bvb de snelheid van Voertuigen wordt gemeten (een zgn trajectcontrole) of waarvoor enig ander Verkeerskenmerk wordt vastgesteld dat op het bemonsterd Verkeerdomeinobject betrekking heeft."@nl;
  rdfs:comment "Traject waarlangs men kenmerken van het voorbijkomend verkeer meet.."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:subClassOf <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersbemonsteringsobject>,
    <http://def.isotc211.org/iso19156/2011/SamplingCurve#SF_SamplingCurve> .

<https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerssnelheidskenmerk> a owl:Class;
  rdfs:label "Verkeerssnelheidsmetingkenmerk"@nl;
  rdfs:comment "Kenmerk van het Verkeersdomeinobject of het Verkeersbemonsteringsobject dat gemeten wordt en dat betrekking heeft op het verkeer over of langs dat object of op zijn deelname aan het verkeer."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen> .

<https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerssnelheidsmeting> a owl:Class;
  rdfs:label "Verkeerssnelheidsmeting"@nl;
  rdfs:comment "Het vaststellen van de snelheid van voertuigen op een bepaalde locatie op een bepaald tijdstip of gedurende een specifiek tijdsinterval."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen> .

<https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerstellingskenmerk> a owl:Class;
  rdfs:label "Verkeerstellingkenmerk"@nl;
  rdfs:comment "Kenmerk van het Verkeersdomeinobject of het Verkeersbemonsteringsobject dat gemeten wordt en dat betrekking heeft op het verkeer over of langs dat object of op zijn deelname aan het verkeer."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen> .

<https://data.vlaanderen.be/ns/weg#rijrichting> a rdf:Property;
  rdfs:label "rijrichting"@nl .

<https://def.isotc211.org/iso19156/2011/Observation#OM_Observation.phenomenonTime> a rdf:Property;
  rdfs:label "fenomeenTijd"@nl .

<https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersbemonsteringsobject> a owl:Class;
  rdfs:label "Verkeersbemonsteringsobject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Van belang als men dit object niet rechtstreeks kan observeren. Bvb om de snelheid ve Voertuig te bepalen kan men moeilijk dat Voertuig gaan volgen, in plaats daarvan zet men een meetpunt op langs de weg om te zien hoe snel passerende Voertuigen rijden. Gelijkaardig voor bvb verkeersintensiteit: men telt in een meetpunt langs de weg doorkomsten van Voertuigen en gaat ervan uit dat dit cijfer representatief is voor  het Wegsegment (deel van de weg tussen twee opeenvolgende kruispunten). OPGELET: Deze klasse is abstract, ze mag niet geinstantieerd worden. Gebruik in de plaats de subklassen Verkeersmeetpunt of Verkeersmeettraject"@nl;
  rdfs:comment "Object dat representatief is voor het object waarvan men het Verkeerskenmerk meet."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:subClassOf <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersobject>,
    <http://def.isotc211.org/iso19156/2011/SamplingFeature#SF_SamplingFeature> .

<https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerskenmerk> a owl:Class;
  rdfs:label "Verkeerskenmerk"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bvb de gemiddelde snelheid van auto's langs een Meetpunt of de verkeersIntensiteit van fietsen op een Wegsegment bvb uitgedrukt in aantal voertuigen of de snelheid van een individueel Voertuig etc."@nl;
  rdfs:comment "Kenmerk van het Verkeersdomeinobject of het Verkeersbemonsteringsobject dat gemeten wordt en dat betrekking heeft op het verkeer over of langs dat object of op zijn deelname aan het verkeer."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:subClassOf <http://def.isotc211.org/iso19109/2005/GeneralFeatureModel#GF_PropertyType> .

<https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeting> a owl:Class;
  rdfs:label "Verkeersmeting"@nl;
  <http://purl.org/vocab/vann/usageNote> """Verkeer wordt gedefinieerd als de verplaatsing van objecten zoals personen, vracht, data etc over media zoals land, water, lucht, kabels. Verkeer kan betrekking hebben op objecten die zichzelf verplaatsen (al dan niet met een vervoermiddel) of objecten die vervoerd worden, maar ook op objecten waarover verkeer plaatsvindt. De meting kan het vaststellen van de waarde van een kenmerk van een individueel object tijdens zijn verplaatsing zijn (bvb zijn snelheid) of van een kenmerk van de infrastructuur waarover het verkeer zich beweegt (bv de verkeersintensiteit). Verkeersmetingen  zijn Observaties, maw op de waarde zit een zekere foutmarge door de gebruikte meettechniek.
"""@nl;
  rdfs:comment "Het vaststellen van de waarde van een bepaald kenmerk van het verkeer op een bepaald tijdstip of tussen twee tijdstippen."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:subClassOf <http://def.isotc211.org/iso19156/2011/Observation#OM_Observation> .

<https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerstelling> a owl:Class;
  rdfs:label "Verkeerstelling"@nl;
  rdfs:comment "Het vaststellen van het aantal voertuigen op een bepaalde locatie op een bepaald tijdstip of gedurende een specifiek tijdsinterval."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen> .

<https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersdomeinobject> a owl:Class;
  rdfs:label "Verkeersdomeinobject"@nl;
  <http://purl.org/vocab/vann/usageNote> "Hieronder verstaan we een real-world object uit het verkeer, ttz een Voertuig of Verkeersdeelnemer of een Wegsegment of gelijkaardig waarover verkeer plaatsvindt. Vallen hier niet onder: Verkeersbemonsteringsobjecten zoals Verkeersmeetpunten of Verkeersmeettrajecten, dat zijn de objecten die het Verkeersdomein bemonsteren. OPGELET: Deze klasse is abstract, ze mag maw niet geinstantieerd worden. Gebruik in de plaats subklassen zoal Wegsegment, Rijstrook, Voertuig etc."@nl;
  rdfs:comment "Object uit het verkeersdomein waarvan men een Verkeerskenmerk meet."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:subClassOf <https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersobject>,
    <http://def.isotc211.org/iso19156/2011GeneralFeatureInstance#GFI_DomainFeature> .

<https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersobject> a owl:Class;
  rdfs:label "Verkeersobject"@nl;
  <http://purl.org/vocab/vann/usageNote> "OPGELET: Deze klasse is abstract, ze moet gespecialiseerd worden als Verkeersdomeinobject of als Verkeersbemonsteringsobject. Als Verkeersdomeinobject als de meting direct betrekking heeft op het object dat men wil observeren of als Verkeersbemonsteringsobject als de meting onrechtstreeks gebeurt (bvb via een Verkeersmeetpunt)."@nl;
  rdfs:comment "Object waarop of waarlangs zich verkeer voordoet of dat deel uitmaakt vh verkeer."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/verkeersmetingen>;
  rdfs:subClassOf <http://def.isotc211.org/iso19156/2011/GeneralFeatureInstance#GFI_Feature> .

<https://data.vlaanderen.be/ns/verkeersmetingen> a owl:Ontology;
