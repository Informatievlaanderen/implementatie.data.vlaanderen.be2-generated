          "@type": "http://www.w3.org/2004/02/skos/core#Concept"
        },
        "registratie": {
          "@container": "@set",
          "@id": "https://data.vlaanderen.be/ns/persoon#registratie",
          "@type": "http://www.w3.org/ns/adms#Identifier"
        },
        "volledigeNaam": {
          "@id": "https://data.vlaanderen.be/ns/persoon#volledigeNaam",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        },
        "voornaam": {
          "@container": "@set",
          "@id": "http://xmlns.com/foaf/0.1/givenName",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      },
      "@id": "https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon"
    },
    "GeregistreerdeOrganisatie": {
      "@context": {
        "rechtspersoonlijkheid": {
          "@id": "http://www.w3.org/ns/regorg#rechtspersoonlijkheid",
