      "diagramLabel": [
        {
          "@value": "id"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Identifier of the event which uniquely distinct events in combination with source."
        },
        {
          "@language": "nl",
          "@value": "Identificator van het event om deze uniek te onderscheiden van andere events samen met de source."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Retransmission of a duplicate may reuse the same source and id. The value is not a globally unique event IRI by itself."
        },
        {
          "@language": "nl",
          "@value": "Herpublicatie van een duplicaat mag dezelfde source en id gebruiken, de waarde zelf is niet een globale unieke event IRI."
        }
      ],
      "domain": {
