  "classes": [
    {
      "@id": "urn:oslo-toolchain:bb4f0e41290d00d169eebdde48c1ce6650d082cceab2e290a0e6da81361901b4",
      "@type": "Class",
      "assignedURI": "https://w3id.org/cloudevents#CloudEvent",
      "apLabel": [
        {
          "@language": "en",
          "@value": "CloudEvent"
        },
        {
          "@language": "nl",
          "@value": "CloudEvent"
        }
      ],
      "diagramLabel": [
        {
          "@value": "CloudEvent"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "An event record expressing an occurrence and its context."
        },
        {
          "@language": "nl",
          "@value": "Een neerslag van een event dat plaatsvond in een bepaalde context."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Its RDF subject is not determined by its id attribute alone: the CloudEvents identity of an event is the combination of source and id."
        },
        {
          "@language": "nl",
          "@value": "Het RDF subject is een combinatie van het attribuut 'id' en zijn attribuut 'source'."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ZonderStatus"
    },
    {
      "@id": "urn:oslo-toolchain:a2725b298c58b8afc3f1d3142b44e503b51661ee36092fd93042a45cdbcc638e",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2000/01/rdf-schema#Literal",
      "apLabel": [
        {
          "@language": "en",
          "@value": "Payload"
        },
        {
          "@language": "nl",
          "@value": "Inhoud"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Literal"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Information about the event."
        },
        {
          "@language": "nl",
          "@value": "Informatie over het event."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Abstracte klasse die steeds voor elk gebruik vervangen moet worden door de effectieve inhoud, bijvoorbeeld: een andere klasse of een primitief datatype. Gebruikers moeten de inhoud steeds parsen volgens de waarde van het datacontenttype veld en valideren volgens het schema voorzien in het dataschema veld."
        },
        {
          "@language": "en",
          "@value": "Abstract class which always must be replaced by the actual content such as another class or primitive datatype. Clients must parse it according to the datacontenttype attribute and validatie it with schema provided by the dataschema attribute."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ZonderStatus"
    }
  ],
  "attributes": [
