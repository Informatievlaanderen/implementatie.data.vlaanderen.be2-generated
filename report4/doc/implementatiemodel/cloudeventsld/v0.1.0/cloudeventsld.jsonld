        {
          "@value": "time"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Timestamp of the occurrence, or a consistently selected substitute time if the actual occurrence time cannot be determined."
        },
        {
          "@language": "nl",
          "@value": "Tijdstip waarop het event gebeurde."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Not the time the event record was created or delivered. See ce:Timestamp for normalising RFC 3339 values."
        },
        {
          "@language": "nl",
          "@value": "Tijdstip van het event op het terrein, niet het tijdstip waarop het event was aangemaakt of afgeleverd in de data."
        }
      ],
