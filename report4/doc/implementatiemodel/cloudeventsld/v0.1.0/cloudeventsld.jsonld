      "apDefinition": [
        {
          "@language": "en",
          "@value": "Producer-defined event type string."
        },
        {
          "@language": "nl",
          "@value": "Soort event benaming gekozen door de dataproducent."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Reverse-DNS prefixes are recommended. This is NOT rdf:type: a CloudEvents type string does not automatically identify an RDF class."
        },
        {
          "@language": "nl",
          "@value": "Reverse-DNS prefixes zijn aangeraden. Dit is geen rdf:type omdat een CloudEvents type string niet automatisch een RDF klasse aangeeft."
        }
      ],
