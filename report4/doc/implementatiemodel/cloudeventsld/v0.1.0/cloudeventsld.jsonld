      "apDefinition": [
        {
          "@language": "en",
          "@value": "Version of the CloudEvents specification that defines the event's context."
        },
        {
          "@language": "nl",
          "@value": "De versie van de CloudEvents specificatie dat het event volgt."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "For CloudEvents core 1.0.2 this has the literal value '1.0', not '1.0.2'."
        },
        {
          "@language": "nl",
          "@value": "Voor CloudEvents core 1.0.2 is de waarde '1.0' en niet '1.0.2'."
        }
      ],
