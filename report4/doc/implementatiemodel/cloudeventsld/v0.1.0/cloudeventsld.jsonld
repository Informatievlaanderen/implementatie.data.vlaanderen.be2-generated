        {
          "@value": "source"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Identifying the context where the occurrence happened."
        },
        {
          "@language": "nl",
          "@value": "Identificieert de context waarin het event gebeurd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "An absolute URI is recommended but not required. Preserve the lexical value rather than resolving relative references against the RDF document base; this is a literal attribute, not an RDF relation to a ce:SourceContext resource."
        },
        {
          "@language": "nl",
          "@value": "Een absolute IRI is aangeraden maar niet verplicht."
        }
      ],
      "domain": {
