          "@value": "Identifier of the subject of the event within the context of source."
        },
        {
          "@language": "nl",
          "@value": "Identificatie van het onderwerp van het event binnen de context van de source."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "It is not necessarily a URI and should not be treated as dct:subject or an RDF resource without an explicit mapping."
        },
        {
          "@language": "nl",
          "@value": "Dit is niet altijd een URI en mag dus niet zomaar gebruikt worden als dcterms:subject of een RDF resource zonder mapping."
        }
      ],
