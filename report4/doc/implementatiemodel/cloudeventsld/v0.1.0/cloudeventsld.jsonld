      "apDefinition": [
        {
          "@language": "en",
          "@value": "The schema to which the event data adheres."
        },
        {
          "@language": "nl",
          "@value": "Het schema dat de inhoud van het event volgt."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Represented as an IRI (named node), so the schema can be dereferenced and linked; as the value is always absolute, no base IRI is involved. No equivalence to an RDF class or SHACL shape is implied."
        },
        {
          "@language": "nl",
          "@value": "Voorgesteld als een IRI zodat het schema steeds opgehaald kan worden. Het schema is geen equivalent van een RDF klasse of SHACL shape."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:bb4f0e41290d00d169eebdde48c1ce6650d082cceab2e290a0e6da81361901b4"
