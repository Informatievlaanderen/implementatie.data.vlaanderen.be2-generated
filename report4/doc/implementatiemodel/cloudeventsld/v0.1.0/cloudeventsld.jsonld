      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Media type of the event data, as defined by RFC 2046. In certain event formats, absence may imply a media type."
        },
        {
          "@language": "nl",
          "@value": "Mediatype van de inhoud van het event in het attribuut 'data' volgens RFC 2046."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "For example: application/json"
        },
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld: application/json."
        }
      ],
