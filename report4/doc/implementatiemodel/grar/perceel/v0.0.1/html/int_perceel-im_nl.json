    {
      "id": "https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel",
      "vocabularyLabel": {
        "nl": "KadastraalPlanperceel"
      },
      "applicationProfileLabel": {
        "nl": "KadastraalPlanperceel"
      },
      "vocabularyDefinition": {
        "nl": "Een gedeelte van het Belgische grondgebied, geografische afgebakend en geïdentificeerd door de AAPD op het kadastraal percelenplan, dat overeenstemt met het grondoppervlak van één of meerdere kadastrale patrimoniale percelen."
      },
      "applicationProfileDefinition": {
        "nl": "Een gedeelte van het Belgische grondgebied, geografische afgebakend en geïdentificeerd door de AAPD op het kadastraal percelenplan, dat overeenstemt met het grondoppervlak van één of meerdere kadastrale patrimoniale percelen."
      },
      "vocabularyUsageNote": {
        "nl": "Kadastraal Planperceel komt overeen met de entiteit CadastralParcel uit INSPIRE Cadastral Parcel."
      },
      "applicationProfileUsageNote": {
        "nl": "Kadastraal Planperceel komt overeen met de entiteit CadastralParcel uit INSPIRE Cadastral Parcel. De identificator die gedefinieerd kan worden voor een Kadastraal planperceel komt overeen met de CaPaKey (bijvoorbeeld 11111A2222/33B444)."
      },
