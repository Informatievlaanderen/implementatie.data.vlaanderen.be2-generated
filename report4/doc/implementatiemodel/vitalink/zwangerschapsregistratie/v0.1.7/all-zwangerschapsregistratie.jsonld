    {
      "@id": "urn:oslo-toolchain:80fb995a70f347e03f9a5d0740391eddfb3578007def2965a27d289d1abfcc86",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/person#Person",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Persoon"
        }
      ],
      "apLabel": [
