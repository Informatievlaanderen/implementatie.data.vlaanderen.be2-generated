      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Natuurlijk persoon."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Natuurlijk persoon."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, het is te zeggen met eigen rechtspersoonlijkheid) van de menselijke soort, het is te zeggen een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bijvoorbeeld ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, het is te zeggen met eigen rechtspersoonlijkheid) van de menselijke soort, het is te zeggen een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bijvoorbeeld ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
