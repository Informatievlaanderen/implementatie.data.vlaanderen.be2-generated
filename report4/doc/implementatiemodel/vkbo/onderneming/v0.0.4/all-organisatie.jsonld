      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Verwijst naar de belangrijkste Vestiging van de Organisatie, niet noodzakelijk het formele hoofdkwartier maar wel de Vestiging waarop de Organisatie standaard kan worden gecontacteerd."
        }
      ],
