        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Vorm- en positiekenmerken van een object."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Beschrijft deze kenmerken door middel van punten, lijnen, polygonen en coördinaten."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
