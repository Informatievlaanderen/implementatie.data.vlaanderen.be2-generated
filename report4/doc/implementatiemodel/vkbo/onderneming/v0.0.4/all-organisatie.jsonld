          "@value": "Identificator"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie gebruikt om een object uniek te identificeren."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
