  "classes": [
    {
      "@id": "urn:oslo-toolchain:95720ce982042b7641adcf5dc9f8ac1e7919d33b5ab85f710369d76164bfd263",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/regorg#RegisteredOrganization",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "GeregistreerdeOrganisatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GeregistreerdeOrganisatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Organisatie met een juridisch statuut vastgelegd door registratie. Vergelijk met een FormeleOrganisatie waarbij dit statuut ook op een andere manier verkregen kan zijn."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In België moeten onder andere volgende Organisaties zich registreren: vennootschap (NV, BV, etc), eenmanszaak, overheidsorgaan, stichting, … Bij registratie krijgt de Organisatie een ondernemingsnummer en worden zijn gegevens ingevoerd in de Kruispuntbank van Ondernemingen (KBO)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:30cd267a114f5e5ffcc2b721a095bfd65677597b1265558eff8264522941e679"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:30cd267a114f5e5ffcc2b721a095bfd65677597b1265558eff8264522941e679",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#FormalOrganization",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "FormeleOrganisatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "FormeleOrganisatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een erkende Organisatie, erkend in brede zin of  meer specifiek in juridische zin met bijbehorende rechten en plichten."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld een bedrijf, een vzw, een overheidsorgaan, een kerkgemeenschap."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:1a5d11580fc42d42bf464c4a73a9970b630c125bb102c959b57ef346f7f9e14e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:1a5d11580fc42d42bf464c4a73a9970b630c125bb102c959b57ef346f7f9e14e",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#Organization",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Organisatie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Organisatie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een Organisatie heeft dikwijls een hiërarchische structuur."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:f4d4156ba67eefb9002e9a692d143bfedf6be8564bd99cf76a99a0bb90e0a67b"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:ad8cc46e035270088a084c621cca5b959f4a176ac6ad4cd8f91d02a0ac735d43",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#ChangeEvent",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Veranderingsgebeurtenis"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Veranderingsgebeurtenis"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Gebeurtenis waardoor een Organisatie een belangrijke wijziging ondergaat zoals een fusie of een herstructurering."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Is bedoeld voor situaties waarbij de de resulterende Organisatie zodanig verschilt van de oorspronkelijke dat ze beschouwd kan worden als een nieuwe Organisatie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:4842f50f60e07dd0cf376158a4e474e5cdce07e15353211c98cc558bb3d555d1"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:8efe4d2e55ae333e5eea4a43336168a028c18fa467255b54c301a5b0f436a3b9",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#Site",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Vestiging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Vestiging"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een kantoor of ander pand waar een Organisatie gevestigd is. Organisaties kunnen over meerdere Vestigingen verspreid zijn en Vestigingen kunnen op meerdere locaties slaan."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Meestal zal de Vestiging een fysieke locatie zijn. Niet-fysieke locaties worden echter niet uitgesloten, bijvoorbeeld een virtueel kantoor met bijbehorend postnummer en telefonische receptie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:4842f50f60e07dd0cf376158a4e474e5cdce07e15353211c98cc558bb3d555d1"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:3600984f0073786ad3686b9af8ca30f964b27cc7ac43323a21f5fb2b7e9d4500",
