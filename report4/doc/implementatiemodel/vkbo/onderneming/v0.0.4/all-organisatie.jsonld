        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Verwijst naar het Veranderingsmoment dat deze Organisatie heeft veranderd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Als het Veranderingsmoment bijvoorbeeld een Stopzetting is hield de Organisatie daarna op met bestaan. Merk op dat deze relatie zinloos is als het Veranderingsmoment een Oprichting is (de Organisatie bestond nog niet en kan dus niet veranderd zijn ten gevolge van de Oprichting)."
        }
      ],
