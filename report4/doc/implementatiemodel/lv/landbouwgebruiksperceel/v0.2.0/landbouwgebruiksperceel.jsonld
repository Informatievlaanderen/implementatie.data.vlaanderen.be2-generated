    {
      "@id": "urn:oslo-toolchain:b105d1e124f6369500c6ef61a54c22b224bc66bb1aaa74bf9b5e8ae63ad0a7dd",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://data.vlaanderen.be/ns/organisatie#rechtspersoonlijkheid",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "rechtspersoonlijkheid"
        }
      ],
      "diagramLabel": [
        {
          "@value": "rechtspersoonlijkheid"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Geeft aan of de rechtspersoonlijkheid van de GeregistreerdeOrganisatie deze is van een natuurlijk persoon of van een rechtspersoon."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aard van de rechtspersoonlijkheid."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Een rechtspersoon is een juridische constructie die een organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bijvoorbeeld ook schulden hebben, contracten afsluiten, aangeklaagd worden, etc.). Voorbeelden privaatrechterlijke rechtspersonen: vennootschappen, vzw's, etc.; Voorbeelden publiekrechterlijke rechtspersonen: steden, gemeenten etc. Een feitelijke vereniging is in principe geen rechtspersoon maar wordt als ze geregistreerd is in KBO toch als dusdanig geklasseerd."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Rechtspersoonlijkheid betekent dat men een rechtssubject is, dit wil zeggen drager van rechten en plichten. Natuurlijke personen hebben vanzelf rechtspersoonlijkheid, rechtspersonen (bijvoorbeeld: vennootschappen) moeten die van rechtswege toegekend krijgen."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:5c1fb002dbfc31f7e92bc5bda28b90b2d3ca6a60e3f0cc3e9c7ca3bac9f66e91"
      },
      "range": {
        "@id": "urn:oslo-toolchain:66d7707dd62cfa8f8252c1f5548c8ca1b2011e22c69cc4f686d88a5f6dcc6468"
      },
      "parent": {
        "@id": "http://www.w3.org/ns/regorg#orgType"
      },
      "minCount": {
        "@value": "0",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "maxCount": {
        "@value": "1",
