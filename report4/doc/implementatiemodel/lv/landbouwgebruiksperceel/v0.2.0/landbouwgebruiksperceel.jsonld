    {
      "@id": "urn:oslo-toolchain:66d7707dd62cfa8f8252c1f5548c8ca1b2011e22c69cc4f686d88a5f6dcc6468",
      "@type": "Class",
      "assignedURI": "https://implementatie.data.vlaanderen.be/ns/vkbo/onderneming#Rechtspersoonlijkheidtype",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Rechtspersoonlijkheidtype"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Rechtspersoonlijkheidtype"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aard van de rechtspersoonlijkheid."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Rechtspersoonlijkheid betekent dat men een rechtssubject is, dit wil zeggen drager van rechten en plichten. Natuurlijke personen hebben vanzelf rechtspersoonlijkheid, rechtspersonen (bijvoorbeeld venootschappen) moeten die van rechtswege toegekend krijgen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:a5b7c48dda7c90fb3919ff746f776e36b5aefe8748878659ae1d36ffa82849e8"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ZonderStatus"
    },
    {
      "@id": "urn:oslo-toolchain:550e1d2cdc641d8d894f0148ce8c87ac44a42a6f91f180b5bf73ad3cead3a4a5",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/adres#Adres",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Adres"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Adres"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid, een ligplaats, een standplaats of een perceel op basis van een gemeentenaam, een straatnaam, een huisnummer en eventueel een busnummer en een postcode."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid, een ligplaats, een standplaats of een perceel op basis van een gemeentenaam, een straatnaam, een huisnummer en eventueel een busnummer en een postcode."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De definitie heeft betrekking op Belgische adressen. In andere landen kan een adres eventueel verwijzen naar andere geografisch objecten (niet gebouweenheid of perceel) of bestaan uit andere aanduidingen (verschillend van huisnummer en busnummer) of uit andere componenten dan straatnaam, gemeentenaam of postcode. Alternatieve adresaanduidingen dan huisnummer of busnummer (bijvoorbeeld ingangaanduiding, trapaanduiding, verdiepaanduiding...) of een gebouwnaam of kamernaam en dergelijke zijn mogelijk door middel van een associatie met adresuitbreiding. Uitwisseling van buitenlandse adressen moet gebeuren met behulp van het object adresvoorstelling."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De definitie heeft betrekking op Belgische adressen. In andere landen kan een adres eventueel verwijzen naar andere geografisch objecten (niet gebouweenheid of perceel) of bestaan uit andere aanduidingen (verschillend van huisnummer en busnummer) of uit andere componenten dan straatnaam, gemeentenaam of postcode. Alternatieve adresaanduidingen dan huisnummer of busnummer (bijvoorbeeld ingangaanduiding, trapaanduiding, verdiepaanduiding...) of een gebouwnaam of kamernaam en dergelijke zijn mogelijk door middel van een associatie met adresuitbreiding. Uitwisseling van buitenlandse adressen moet gebeuren met behulp van het object adresvoorstelling."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ZonderStatus"
    },
