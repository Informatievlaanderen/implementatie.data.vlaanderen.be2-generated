    {
      "@id": "urn:oslo-toolchain:7d0c74a1a85e6f13ed5c9c1239ce01e15ad4b7c4f609f7b5894147b62773e730",
      "@type": "Class",
      "assignedURI": "https://implementatie.data.vlaanderen.be/ns/lv/landbouwgebruiksperceel#Landbouwgebruiksperceel",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Landbouwgebruiksperceel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Landbouwgebruiksperceel"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een landbouwgebruiksperceel is een aaneengesloten stuk grond dat door een landbouwer wordt gebruikt voor landbouwactiviteiten."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Een Landbouwgebruikersperceel is gebruikt door 1 landbouwer en omvat niet meer dan één enkele voor-, hoofd-, en/of maximaal 2 nateelten of wordt begrensd door toepassing van een milieu-, klimaat-, of biodiversiteitsmaatregel. Ook landbouwproductiefaciliteiten en bepaalde landschapselementen worden als landbouwgebruiksperceel aanzien."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:db3bc304cb82fc17f05d06bd308a55c0ed10c124b28c670ce20d96ed497a7456"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ZonderStatus"
    }
  ],
