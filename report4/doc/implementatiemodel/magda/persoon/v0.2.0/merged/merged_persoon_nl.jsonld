    {
      "@id": "urn:oslo-toolchain:af8fedb0d5238bc38958f7d21100e4e885fc8a98957a8d3455111c98594506e6",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Gezin",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Gezin"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Gezin"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Samenwerkingsvorm die een herkenbare sociale eenheid vormt (bijvoorbeeld ten gevolge van een huwelijk), met al dan niet verwante personen die duurzame banden hebben en elkaar onderling steun en verzorging verlenen."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Ruimer begrip dan familie waar het Gezin louter bestaat uit nabije bloedverwanten, bijvoorbeeld een Eenpersoonsgezin of een Living Together Apart Gezin. Gezinsleden hebben doorgaans dezelfde Verblijfplaats."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
