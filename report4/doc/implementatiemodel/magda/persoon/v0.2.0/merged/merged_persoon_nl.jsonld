      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Juridisch vastgelegde verblijplaats."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Voor gevallen waar wettelijk een verblijplaats is bepaald, bijvoorbeeld bij kinderen wanneer de ouders niet meer samenleven. Bedoeld voor wanneer de persoon daar (nog) niet officieel zijn hoofdverblijfplaats heeft."
        }
      ],
