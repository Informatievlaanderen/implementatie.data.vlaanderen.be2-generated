        {
          "@language": "nl",
          "@value": "Referentieadres"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Referentieadres"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Adres van een andere persoon of rechtspersoon voor personen zonder vaste verblijfplaats."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld in het geval van mobiele woning (tytpisch binnenscheepvaart), dakloosheid, hechtenis (zonder woonst), opdracht in het buitenland (typuisch voor militairen) en dergelijke meer."
        }
      ],
