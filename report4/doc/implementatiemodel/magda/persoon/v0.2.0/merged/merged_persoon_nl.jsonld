      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Uitzondering geeft miet-kritieke problemen weer bij het uitwisselen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld: nieuwe INSZ nummer bij het Rijksregister."
        }
