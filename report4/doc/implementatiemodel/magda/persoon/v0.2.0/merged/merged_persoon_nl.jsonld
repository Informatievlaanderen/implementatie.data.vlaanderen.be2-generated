    {
      "@id": "urn:oslo-toolchain:7371303fba49763aac9dca5045e5aaff7279bae1097bb085cc4a7c5af02d1cc0",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "GeregistreerdPersoon"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GeregistreerdPersoon"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Persoon waarvan de gegevens zijn ingeschreven in een register."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Doorgaans is dit register een bevolkingsregister maar het kan bijvoorbeeld ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (voorbeeld: naam en voornaam) en de Verblijfplaats van de persoon en op belangrijke levensgebeurtenissen zoals geboorte, huwelijk, overlijden etc. Deze gegevens worden typisch geregistreerd door de overheid, ze bieden de ingeschreven persoon wettelijke bescherming en laten de overheid toe om basisstatistieken op te stellen over zijn bevolking."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:edfcac56a241620ce740b3a0aa12e8c908fbbfcfe4d1e98aa813227f3f19c862"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:de099dc1385d817cf323fe0e3f42c68714378ca9a8014d48935f334518528536",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Domicilie",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Domicilie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Domicilie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Hoofdverblijfplaats van een Persoon."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Plaats waar de Persoon het grootste deel van de tijd verblijft binnen de Jurisdictie waarvan de persoon Inwoner is. Dit wordt doorgaans officieel vastgesteld en geregistreerd in het bevolkingsregister. Kan in praktijk verschillend zijn van de feitelijke verblijfplaats."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d7e2610cb34b487f7d46a20db498b5b5e07750db1014d0f145eae62bc38a0425"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
