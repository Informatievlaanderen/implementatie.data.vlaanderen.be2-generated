    },
    {
      "@id": "urn:oslo-toolchain:6c8563199f6c094897abf06663e474fe4c1384cdf11d7d7f7c3c14dfedd6d22c",
      "@type": "Class",
      "assignedURI": "https://implementatie.data.vlaanderen.be/ns/magda/persoon#VerblijfplaatsBuitenlandDomicilie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "VerblijfplaatsBuitenlandDomicilie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VerblijfplaatsBuitenlandDomicilie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Hoofdverblijplaats in het buitenland."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Persoon in het buitenland gedomicilieerd bij een diplomatieke post in plaats van op een BelgischAdres, het is te zeggen zonder nog een hoofdverblijfplaats in België en dus ook niet daar tijdelijk afwezig."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Plaats waar de Persoon het grootste deel van de tijd verblijft binnen de jurisdictie waarvan hij Inwoner is. Dit wordt doorgaans officieel vastgesteld en geregistreerd in het bevolkingsregister. Kan in praktijk verschillend zijn van de feitelijke verblijfplaats."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:de099dc1385d817cf323fe0e3f42c68714378ca9a8014d48935f334518528536"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
