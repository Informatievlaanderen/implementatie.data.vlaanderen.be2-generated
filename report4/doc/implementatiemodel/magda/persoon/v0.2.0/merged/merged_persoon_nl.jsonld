      "@type": "Class",
      "assignedURI": "https://implementatie.data.vlaanderen.be/ns/magda/persoon#VoorlopigeInschrijving",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "VoorlopigeInschrijving"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VoorlopigeInschrijving"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De Persoon is voorlopig ingeschreven in het bevolkingsregister wanneer deze Persoon zich gevestigd heeft in een woning waar permanente bewoning niet toegelaten is."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De inschrijving blijft voorlopig zolang de administratieve beheerder geen beslissing heeft genomen om de onregelmatige toestand te beëindigen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
