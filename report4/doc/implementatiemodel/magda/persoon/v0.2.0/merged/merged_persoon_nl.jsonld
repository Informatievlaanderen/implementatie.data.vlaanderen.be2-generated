          "@language": "nl",
          "@value": "Verblijfplaats"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Verblijfplaats"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Plaats waar een Persoon al dan niet tijdelijk woont of logeert."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:71c28580fbd014b3ab05151064ed239579adc3f5c7ea6d4d56685d63f245311d",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/persoon#Afstamming",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Afstamming"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Afstamming"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Afstamming is de dalende lijn van bloedverwantschap tussen verschillende generaties."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De afstamming kan ook niet-biologisch zijn, bijvoorbeeld adoptie. Afstamming kan ook in opgaande lijn worden bekeken. Het begrip is enger dan verwantschap dat onder andere ook Huwelijk inhoudt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:99072ac6ed2bdb4341e8ac9959c89778951d9da2fa460562d9e632c1c2926bb6"
        }
      ],
