    {
      "@id": "urn:oslo-toolchain:0844ae6744c15efd314dabd86bfd02e69737cee89d4b98fd268298309326d58e",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/adres#Adres",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Belgisch Adres"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Adres"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid, een ligplaats, een standplaats of een perceel op basis van een gemeentenaam, een straatnaam, een huisnummer en eventueel een busnummer en een postcode."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De definitie heeft betrekking op Belgische adressen. In andere landen kan een adres eventueel verwijzen naar andere geografisch objecten (niet gebouweenheid of perceel) of bestaan uit andere aanduidingen (verschillend van huisnummer en busnummer) of uit andere componenten dan straatnaam, gemeentenaam of postcode. Alternatieve adresaanduidingen dan huisnummer of busnummer (bijvoorbeeld: ingangaanduiding, trapaanduiding, verdiepaanduiding...) of een gebouwnaam of kamernaam etc. zijn mogelijk door middel van een associatie met adresuitbreiding. Uitwisseling van buitenlandse adressen moet gebeuren met behulp van het object Adresvoorstelling."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
