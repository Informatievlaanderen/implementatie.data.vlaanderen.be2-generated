    {
      "@id": "urn:oslo-toolchain:3221e3c54ad1e0619c4dc8d58c47346a4d0f3ba406c02a992eb9d87b2a1ddc13",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/person#Person",
