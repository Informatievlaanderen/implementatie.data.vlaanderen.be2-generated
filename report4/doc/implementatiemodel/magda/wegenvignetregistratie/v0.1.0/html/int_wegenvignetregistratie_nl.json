      "vocabularyLabel": {
        "nl": "MotorSpecificatie"
      },
      "applicationProfileLabel": {
        "nl": "MotorSpecificatie"
      },
      "applicationProfileDefinition": {
        "nl": "Informatie over de motor of motoren van een Voertuig."
      },
      "applicationProfileUsageNote": {
        "nl": "Een motorspecificatie komt overeen met één geregistreerde motor in de bron en niet noodzakelijk met één fysieke motor. Eén motorspecificatie kan een combinatie van een verbrandingsmotor en een elektromotor beschrijven, bijvoorbeeld bij een hybride voertuig. Het aantal motorspecificaties van een voertuig is daarom geen betrouwbare aanduiding van het werkelijke aantal motoren."
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
