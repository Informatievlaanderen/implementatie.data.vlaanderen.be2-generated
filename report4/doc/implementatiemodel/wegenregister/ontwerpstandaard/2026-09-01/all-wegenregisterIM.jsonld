    {
      "@id": "urn:oslo-toolchain:3f1784aa65fbf2214063655377f37ea3ef61c7f413f6102d0234e1586855b541",
      "@type": "Datatype",
      "assignedURI": "https://schema.org/QuantitativeValue",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "KwantitatieveWaarde"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KwantitatieveWaarde"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van de kwantiteit van een bepaald kenmerk van een object."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld de hoogte van een object,het gewicht,de temperatuur etc. Het gaat om een kenmerk dat numeriek uitgedrukt kan worden en in een bepaalde eenheid. Kwalitatieve aanduidingen zoals hoog,laag en dergelijke vallen hier dus niet onder."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f3023ff36c70b39b0ff6a02fa08830a6cff3eacc37387fde3cde266fc395b34c",
      "@type": "Datatype",
      "assignedURI": "http://www.opengis.net/ont/sf#Curve",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Curve"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Curve"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een 1-dimensionele geometrische primitieve."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Dimensie is te verstaan in wiskundige zin: het minimum aantal coördinaten nodig om een willekeurig punt voor te stellen dat deel uitmaakt van de primitieve. In het coördinaatsysteem dat door een Curve zelf gevormd wordt volstaat 1 coördinaat om een punt op de Curve te lokaliseren, bijvoorbeeld de afstand langs de Curve vanaf het vertrekpunt. Een Curve heeft een lengte maar geen breedte of hoogte, wat niet wegneemt dat ze door de 3D ruimte kan kronkelen. Curves worden doorgaans voorgesteld door polylijnen, dit zijn sets van opeenvolgende punten waarbij de tussenliggende punten van de Curve bekomen worden door middel van interpolatie. Als de interpolatiemethode lineair is krijg je een Lijnstring (een hoekige lijn die de opeenvolgende punten verbindt middels een rechte lijn), andere manieren om te interpoleren resulteren in circulaire bogen, cubic splines, Bézier curves etc (waarbij de controlepunten niet noodzakelijk op de Curve liggen). Een Curve wordt begrensd door zijn begin- en eindpunt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:79e5c0ac7353342ff1c992dbe83f3d5b8ffa08cc34dad8befaab1ba24880d62b"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:035f8790c1cde09f7218c0c43c1be9b44f765e543e0836a677dfdf78c8262dcd",
      "@type": "Datatype",
      "assignedURI": "https://data.vlaanderen.be/ns/netwerk#Netwerkreferentie",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Netwerkreferentie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Netwerkreferentie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Verwijzing naar een Netwerkelement."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Laat toe om een Netwerkeigenschap aan een Netwerkelement te koppelen, bijvoorbeeld om aan te geven op welk wegsegment een snelheidsbeperking van toepassing is of langs welke wegsegmenten een fietspad ligt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:b6aa4e1d0c892f90199412acd3175e29fada73c533852afb712521a1de36df53",
      "@type": "Datatype",
      "assignedURI": "https://data.vlaanderen.be/ns/netwerk#Linkreferentie",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Linkreferentie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Linkreferentie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Netwerkreferentie die verwijst naar een lineair netwerkelement."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:035f8790c1cde09f7218c0c43c1be9b44f765e543e0836a677dfdf78c8262dcd"
