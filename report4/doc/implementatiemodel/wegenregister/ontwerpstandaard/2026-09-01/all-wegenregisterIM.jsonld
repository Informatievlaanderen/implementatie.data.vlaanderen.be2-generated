    {
      "@id": "urn:oslo-toolchain:b62b64f56efed058a3cace9590363baa8a6b36b37307d8c804d8c6037ac5a828",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://data.vlaanderen.be/ns/netwerk#toepassingsRichting",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "toepassingsrichting"
        }
      ],
      "diagramLabel": [
        {
          "@value": "toepassingsRichting"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Richting van de link waarop de referentie van toepassing is."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Onder richting wordt de digitalisatierichting van de Link verstaan ten opzichte van waarvan het fenomeen op of langs de weg wordt beschouwd. Loopt het fenomeen mee met de digitalisatierichting dan is de richting \"meelopend\", in tegenzin is het \"tegengesteld\". Dit kan zowel longitudonaal als transversaal bekeken worden: longitudonaal in de richting van de link (met waarden heen en terug) maar ook transversaal of dwars op de Link. In het tweede geval betekent meelopend de rechterkant van de Link en tegengesteld de linkerkant. In dit model beperken we de waarden per default tot links en rechts (bijvoorbeeld voor de linker- en rechterstraatnaam) en is heen en terug voorbehouden voor specifieke gevallen (bijvoorbeeld autoverkeer heen en terug)."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:b6aa4e1d0c892f90199412acd3175e29fada73c533852afb712521a1de36df53"
      },
      "range": {
        "@id": "urn:oslo-toolchain:99d464af628c46c1bcb39f60488f2f92d15934e5152f9f27f80a2c81a7e2fbbf"
      },
      "minCount": {
        "@value": "0",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "maxCount": {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/OntwerpStandaard"
    },
