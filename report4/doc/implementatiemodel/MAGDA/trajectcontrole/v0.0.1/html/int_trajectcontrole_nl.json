    {
      "id": "https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon",
      "vocabularyLabel": {
        "nl": "GeregistreerdPersoon"
      },
      "applicationProfileLabel": {
        "nl": "GeregistreerdPersoon"
      },
      "vocabularyDefinition": {
        "nl": "Persoon waarvan de gegevens zijn ingeschreven in een register."
      },
      "applicationProfileDefinition": {
        "nl": "Persoon waarvan de gegevens zijn ingeschreven in een register."
      },
      "vocabularyUsageNote": {
        "nl": "Doorgaans is dit register een bevolkingsregister maar het kan bv ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (vb naam en voornaam) en de Verblijfplaats vd persoon en op belangrijke levensgebeurtenissen zoals geboorte, huwelijk, overlijden etc. Deze gegevens worden typisch geregistreerd door de overheid, ze bieden de ingeschreven persoon wettelijke bescherming en laten de overheid toe om basisstatistieken op te stellen over zijn bevolking."
      },
      "applicationProfileUsageNote": {
        "nl": "Doorgaans is dit register een bevolkingsregister maar het kan bv ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (vb naam en voornaam) en de Verblijfplaats vd persoon en op belangrijke levensgebeurtenissen zoals geboorte, huwelijk, overlijden etc. Deze gegevens worden typisch geregistreerd door de overheid, ze bieden de ingeschreven persoon wettelijke bescherming en laten de overheid toe om basisstatistieken op te stellen over zijn bevolking."
      },
