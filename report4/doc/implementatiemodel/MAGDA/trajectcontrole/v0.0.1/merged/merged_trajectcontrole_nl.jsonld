      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Meer gedetailleerde beschrijving van de fout in een HTTP response."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit ter aanvulling van een HTTP statuscode,bijvoorbeeld bij een 400 (Bad request) statuscode om aan te geven waarom de request slecht was. Gebaseerd op <a href=\"https://www.rfc-editor.org/rfc/rfc7807\">RFC7807</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ZonderStatus"
    },
    {
