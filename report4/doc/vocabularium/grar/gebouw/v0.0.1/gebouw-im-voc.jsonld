    {
      "@id": "urn:oslo-toolchain:09b3879d32fc370bced794afaa654efa7f8fb04817c29b7b910a53541efc07ae",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/gebouw#Gebouw",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Gebouw"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Gebouw"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een gesloten en/of overdekt, bovengronds of ondergronds bouwwerk, dat dient of bestemd is, ofwel om mensen, dieren en voorwerpen onder te brengen, ofwel om economische goederen te vervaardigen of diensten te verstrekken. Een gebouw verwijst naar gelijk welke structuur die op blijvende wijze op een terrein opgetrokken of gebouwd wordt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:727e0979687feb9597bc546f4245f8aacaccf36857ce9897fe9c88b24618e4b7"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/Standaard"
    },
    {
      "@id": "urn:oslo-toolchain:5e652661d4f16838548beedc8ae3dc90120c9690a89ef0e307c5f6754168703d",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/gebouw#Gebouweenheid",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Gebouweenheid"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Gebouweenheid"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De kleinste eenheid binnen een gebouw die geschikt is voor woon-, bedrijfsmatige, of recreatieve doeleinden en die ontsloten wordt via een eigen afsluitbare toegang vanaf de openbare weg, een erf of een gedeelde circulatieruimte. Een gebouweenheid is in functioneel opzicht zelfstandig. Daarnaast kan een gebouweenheid ook een gemeenschappelijk deel zijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:4a3c77f6f5910944e9350e6bab5b2cd61b3c092f4434fe6c9f95a6776b11a365"
