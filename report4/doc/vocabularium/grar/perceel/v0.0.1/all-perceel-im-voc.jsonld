    {
      "@id": "urn:oslo-toolchain:6059c482b504166bd63bdc17b88684afc046c6f5431f0d91d827540c184d1654",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/perceel#RuimtelijkeEenheid",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "RuimtelijkeEenheid"
        }
      ],
      "diagramLabel": [
        {
          "@value": "RuimtelijkeEenheid"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Eén gebied (of meerdere gebieden) van land en/of water, of één enkel volume (of meerdere volumes) ruimte, afgebakend voor een bepaald doel."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Eén gebied (of meerdere gebieden) van land en/of water, of één enkel volume (of meerdere volumes) ruimte, afgebakend voor een bepaald doel."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Definitie conform ISO 19152 - Land Administration Domain Model."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
