        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Juridisch statuut van een GeregistreerdeOrganisatie."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Stemt in de KBO overeen met rechtsvorm, bijvoorbeeld: NV, VZW, Stad/Gemeente, OCMW, etc."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
