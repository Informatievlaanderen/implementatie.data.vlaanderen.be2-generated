    {
      "@id": "urn:oslo-toolchain:f925ad8a7914f922f868fd9e29172277f40183b186465b009fac37ae2eee87aa",
      "@type": "Class",
      "assignedURI": "https://schema.org/Vehicle",
      "apLabel": [
        {
          "@language": "nl",
          "@value": "Voertuig"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Voertuig"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een voertuig is een apparaat dat ontworpen of gebruikt is om mensen of vracht te vervoeren over land, water, lucht, of door de ruimte."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ZonderStatus"
    },
    {
