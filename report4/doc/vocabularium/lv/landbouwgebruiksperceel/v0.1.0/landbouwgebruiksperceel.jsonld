        }
      ],
      "diagramLabel": [
        {
          "@value": "Landbouwgebruiksperceel"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een perceel dat gebruikt is voor een bepaalde landbouwactiviteit."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De AGPAKEY die, het Landbouwgebruiksperceel uniek identificeert, bevat 3 componenten: tijd, geometrie, en uitbating. Indien een component wijzigt, ontstaat er een nieuwe AGPAKEY."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
