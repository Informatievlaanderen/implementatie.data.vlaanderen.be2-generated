        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Afwijking van een algemene regel."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In dit geval een niet-kritiek probleem weer bij het uitwisselen van gegevens. Bijvoorbeeld: nieuw INSZ nummer bij het Rijksregister."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
