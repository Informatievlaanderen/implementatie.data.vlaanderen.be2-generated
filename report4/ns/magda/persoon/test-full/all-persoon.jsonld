      "diagramLabel": [
        {
          "@value": "Periode"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Temporele Entiteit waarvan de omvang en duurtijd verschilt van nul, dit wil zeggen, waarvoor de begin- en eindtijd verschillend zijn."
        }
      ],
