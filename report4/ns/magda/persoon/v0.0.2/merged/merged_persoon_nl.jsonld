        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Adres dat door een persoon wordt opgegeven als hoofdverblijplaats."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "In het Rijksregister bedoeld voor personen in het Wachtregister, ttz voor voorlopig ipv defintief ingeschreven personen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
