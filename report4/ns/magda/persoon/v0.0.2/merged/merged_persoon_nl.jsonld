      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Adres van een andere persoon of rechtspersoon voor personen zonder vaste verblijfplaats."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bvb in het geval van mobiele woning (tytpisch binnenscheepvaart), dakloosheid, hechtenis (zonder woonst), opdracht in het buitenland (typuisch voor militairen) edm."
        }
      ],
