    {
      "@id": "urn:oslo-toolchain:d9ea7e2c3d18f20d357fce2f43ac5f15f08426b35f87c5c4d433630b3ea2e0b2",
      "@type": "Class",
      "assignedURI": "https://test.data.vlaanderen.be/ns/magda/persoon#AangegevenAdres",
