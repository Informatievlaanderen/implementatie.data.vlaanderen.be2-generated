          "@value": "Jurisdictie"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Het gebied waarover de rechtsmacht van een overheid zich uitstrekt."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Doorgaans een land of deelstaat."
        }
      ],
