        {
          "id": "https://data.vlaanderen.be/ns/netwerk#toepassingsRichting",
          "vocabularyLabel": {
            "nl": "toepassingsRichting"
          },
          "applicationProfileLabel": {
            "nl": "toepassingsrichting"
          },
          "applicationProfileDefinition": {
            "nl": "Richting van de link waarop de referentie van toepassing is."
          },
          "applicationProfileUsageNote": {
            "nl": "Onder richting wordt de digitalisatierichting van de Link verstaan ten opzichte van waarvan het fenomeen op of langs de weg wordt beschouwd. Loopt het fenomeen mee met de digitalisatierichting dan is de richting \"meelopend\", in tegenzin is het \"tegengesteld\". Dit kan zowel longitudonaal als transversaal bekeken worden: longitudonaal in de richting van de link (met waarden heen en terug) maar ook transversaal of dwars op de Link. In het tweede geval betekent meelopend de rechterkant van de Link en tegengesteld de linkerkant. In dit model beperken we de waarden per default tot links en rechts (bijvoorbeeld voor de linker- en rechterstraatnaam) en is heen en terug voorbehouden voor specifieke gevallen (bijvoorbeeld autoverkeer heen en terug)."
          },
          "scope": "https://data.vlaanderen.be/id/concept/scope/External",
          "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/OntwerpStandaard",
          "domain": "https://data.vlaanderen.be/ns/netwerk#Linkreferentie",
