                    {
                        "key": "ap-definition-en",
                        "value": "Instance of any type.",
                        "note": "null"
                    },
                    {
                        "key": "ap-usageNote-en",
                        "value": "NOTE",
                        "note": "To be replaced by a suitable class or data type or by specializing the Observation class with a result of an imposed data type. These can be their own subclasses or standard specializations of the Observation class such as Measurement (where the result is a Quantitative Value, i.e. a value and a unit), Classification (with a qualitative value as a result), Count (with a result of type Integer) or even Observations resulting in a Time Series or Spatial Range. ATTENTION: More info about these standard subclasses of Observation in the application profile <a href=\"https://data.vlaanderen.be/doc/applicationprofile/observations-en-measurements/\">OSLO Observations and Measurements</a> ."
                    }
                ],
                "Scope": "NOTHING"
            },
            "name": "Any"
        },
