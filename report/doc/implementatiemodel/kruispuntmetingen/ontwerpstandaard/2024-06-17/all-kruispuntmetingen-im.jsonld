                    {
                        "key": "ap-usageNote-en",
                        "value": "NOTE",
                        "note": "These other entities are typically Sensors, Samplers, Actuators or other Platforms. In the context of TrafficMeasurements, we define the Device subclass as a possible basis for one or more Sensors. REMARK: For more details about this class see <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensors and Sampling</a>."
                    }
                ],
                "Scope": "NOTHING"
            },
