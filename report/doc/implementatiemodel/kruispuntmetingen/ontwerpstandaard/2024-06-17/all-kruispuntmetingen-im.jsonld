                "label": {
                    "nl": "Platform"
                },
                "definition": {
                    "nl": "Entiteit die fungeert als basis voor andere Entiteiten."
                },
                "usage": {
                    "nl": "Deze andere entiteiten zijn typisch Sensoren, Bemonsteraars, Actuators of andere Platformen. In de context van Verkeersmetingen definiëren we de subklasse Toestel als mogelijke basis voor één of meer Sensoren. OPMERKING: Voor meer details over deze klasse zie <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/sensoren-en-bemonstering/\">AP Sensoren en Bemonstering</a>."
                },
                "ap-label-nl": {
                    "nl": "Platform"
                },
                "ap-definition-nl": {
                    "nl": "Entiteit die fungeert als basis voor andere Entiteiten."
                },
                "ap-usageNote-nl": {
