                    {
                        "key": "ap-label-en",
                        "value": "SamplingObject",
                        "note": "null"
                    },
                    {
                        "key": "ap-definition-en",
                        "value": "Part of the Object that one wants to observe and that is representative of that Object.",
                        "note": "null"
                    },
                    {
                        "key": "ap-usageNote-en",
                        "value": "NOTE",
                        "note": "This part can be physical (a Sample) or spatial (a SpatialSamplingObject). One observes a SamplingObject instead of the actual Object if the latter cannot be observed in its entirety (e.g. because exhaustive observation would be impractical). The SamplingObject, together with the Process used for observation, forms the so-called observation protocol. ATTENTION: this class is abstract, it must be specialized according to the application domain."
                    }
                ],
                "Scope": "NOTHING"
            },
            "name": "Bemonsteringsobject"
        },
