                    },
                    {
                        "key": "ap-definition-en",
                        "value": "Location of the Sensor",
                        "note": "null"
                    },
                    {
                        "key": "ap-usageNote-en",
                        "value": "NOTE",
                        "note": "For example, the coordinates or the address or a reference to a measuring point or other SamplingObject. Several different types of locations can be specified (e.g. address and coordinates). If the Sensor is a measuring installation, possibly the various measuring points that are included or a descriptive polygon. NOTE: The location of the Sensor is not necessarily the position where the Observation takes place, which is primarily given by the location of the SamplingObject or DomainObject. This attribute mainly allows you to describe the positions of sensors, regardless of the measurements that take place."
                    }
                ],
                "Scope": "FULL_DEFINITON"
