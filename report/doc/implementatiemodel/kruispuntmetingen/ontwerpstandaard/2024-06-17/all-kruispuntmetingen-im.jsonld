        {
            "@id": "http://def.isotc211.org/iso19156/2011/SamplingCurve#SF_SamplingCurve",
            "@type": "http://www.w3.org/2002/07/owl#Class",
            "inpackage": "OTHER_PACKAGE",
            "ap-usageNote-nl": {
                "nl": "Van het Object dat men wil observeren wordt in dat geval een representatief lijnvormig deel beschouwd. Voorbeelden zijn trajecten, boorgaten, profielen, intervallen etc. Dikwijls specialiseert de Curve zich tot Lijnstring. OPMERKING: Meer info over deze klasse in het applicatieprofiel <a href=\"https://data.vlaanderen.be/doc/applicatieprofiel/observaties-en-metingen/\">OSLO Observaties en Metingen</a> ."
            },
            "usage": {
