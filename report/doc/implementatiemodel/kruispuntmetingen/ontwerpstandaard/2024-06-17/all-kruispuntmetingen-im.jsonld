                    }
                ],
                "parentclasses": "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersobject, http://def.isotc211.org/iso19156/2011/SamplingFeature#SF_SamplingFeature",
                "label": {
                    "nl": "Verkeersbemonsteringsobject"
                },
                "definition": {
                    "nl": "Object dat representatief is voor het object waarvan men het Verkeerskenmerk meet."
                },
                "usage": {
                    "nl": "Van belang als men dit object niet rechtstreeks kan observeren. Bvb om de snelheid ve Voertuig te bepalen kan men moeilijk dat Voertuig gaan volgen, in plaats daarvan zet men een meetpunt op langs de weg om te zien hoe snel passerende Voertuigen rijden. Gelijkaardig voor bvb verkeersintensiteit: men telt in een meetpunt langs de weg doorkomsten van Voertuigen en gaat ervan uit dat dit cijfer representatief is voor  het Wegsegment (deel van de weg tussen twee opeenvolgende kruispunten). OPGELET: Deze klasse is abstract, ze mag niet geinstantieerd worden. Gebruik in de plaats de subklassen Verkeersmeetpunt of Verkeersmeettraject"
                },
                "ap-label-nl": {
                    "nl": "Verkeersbemonsteringsobject"
                },
                "ap-definition-nl": {
                    "nl": "Object dat representatief is voor het object waarvan men het Verkeerskenmerk meet."
                },
                "ap-usageNote-nl": {
                    "nl": "Van belang als men dit object niet rechtstreeks kan observeren. Bvb om de snelheid ve Voertuig te bepalen kan men moeilijk dat Voertuig gaan volgen, in plaats daarvan zet men een meetpunt op langs de weg om te zien hoe snel passerende Voertuigen rijden. Gelijkaardig voor bvb verkeersintensiteit: men telt in een meetpunt langs de weg doorkomsten van Voertuigen en gaat ervan uit dat dit cijfer representatief is voor  het Wegsegment (deel van de weg tussen twee opeenvolgende kruispunten). OPGELET: Deze klasse is abstract, ze mag niet geinstantieerd worden. Gebruik in de plaats de subklassen Verkeersmeetpunt of Verkeersmeettraject"
                },
