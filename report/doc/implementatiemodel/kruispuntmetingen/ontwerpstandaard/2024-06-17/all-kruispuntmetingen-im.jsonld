                        "key": "ap-definition-en",
                        "value": "Class representing features of instances of any type.",
                        "note": "null"
                    },
                    {
                        "key": "ap-usageNote-en",
                        "value": "NOTE",
                        "note": "This is a characteristic of the observedObject (that is, of the DomainObject or of a proxy thereof, the SamplingObject) and in principle of all instances of that type of observedObject. In the context of Traffic Measurements, this concerns characteristics such as Speed (of a Vehicle - the observed Domain Object) or Number of Vehicles (passing a Measuring Point - the observed SamplingObject - along a Road Segment - the sampled Domain Object)."
                    }
                ],
                "Scope": "NOTHING"
            },
            "name": "Kenmerktype"
        },
