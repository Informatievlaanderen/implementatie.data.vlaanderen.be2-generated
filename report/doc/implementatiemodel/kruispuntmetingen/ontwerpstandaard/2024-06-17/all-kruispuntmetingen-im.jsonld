                        "key": "ap-definition-en",
                        "value": "Curvilinear network element that connects two positions and represents a homogeneous path in the Network. The connected positions are represented by Nodes.",
                        "note": "null"
                    },
                    {
                        "key": "ap-usageNote-en",
                        "value": "By a homogeneous path we mean a route that does not branch, for example a road between two intersections (where the intersections represent Nodes in the Network).",
                        "note": "null"
                    }
                ],
                "Scope": "NOTHING"
            },
            "name": "Link"
        },
