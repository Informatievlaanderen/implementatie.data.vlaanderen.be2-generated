                    {
                        "key": "ap-definition-en",
                        "value": "Reference to the NetworkElement along which the TrafficMeasurementSection runs or that is sampled by that trajectory.",
                        "note": "null"
                    },
                    {
                        "key": "ap-usageNote-en",
                        "value": "NOTE",
                        "note": "Useful if you know along which RoadSegment the route runs and on which side of the road and at what distance from the starting point. Alternative or addition to coordinates. Also necessary to indicate which RoadSegment and on which side the Vehicles whose speed is measured, for example, are driving."
                    }
