                "ap-codelist": "",
                "RawTags": [
                    {
                        "key": "ap-definition-nl",
                        "value": "Toestel of Agent (incl Personen of software) waarmee Observaties gemaakt worden.",
                        "note": "Device, agent (including humans), or software (simulation) involved in, or implementing, a procedure. Sensors respond to a stimulus, e.e., a change in the environment, or Input data composed from the Results of prior observations, and generate a result. Sensors can be hosted by platforms."
                    },
                    {
                        "key": "ap-label-nl",
                        "value": "Sensor",
                        "note": "null"
                    },
                    {
                        "key": "label-nl",
                        "value": "Sensor",
