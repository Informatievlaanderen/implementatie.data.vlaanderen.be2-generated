                    {
                        "key": "ap-label-en",
                        "value": "Lane",
                        "note": "null"
                    },
                    {
                        "key": "ap-definition-en",
                        "value": "Part of the carriageway limited in the longitudinal direction, intended to guide the flow of the traffic in a certain direction and with usually the width of one vehicle.",
                        "note": "null"
                    },
                    {
                        "key": "ap-usageNote-en",
                        "value": "NOTE",
                        "note": "The carriageway is the part of the roadarea designed for a Vehicle to drive over. By dividing the carriageway you get a more controlled traffic flow, firstly because the driving directions or, for example, through and turning traffic are separated and also by limiting the width so that only one Vehicle can pass through one time. Lanes are typically designated by road markings, for example a white continuous or interrupted line. NOTE: Sidewalks or BicyclePaths are not Lanes as they are not intended for a car to drive on and are therefore not part of the carriageway."
                    }
                ],
                "Scope": "FULL_DEFINITON"
            },
