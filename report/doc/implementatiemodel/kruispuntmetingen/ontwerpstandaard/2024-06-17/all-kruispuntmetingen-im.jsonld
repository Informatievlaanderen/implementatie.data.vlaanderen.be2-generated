                    {
                        "key": "ap-label-en",
                        "value": "BicyclePath",
                        "note": "null"
                    },
                    {
                        "key": "ap-definition-en",
                        "value": "Section of roadway intended exclusively for bicycle traffic.",
                        "note": "null"
                    },
                    {
                        "key": "ap-usageNote-en",
                        "value": "NOTE",
                        "note": "Is not part of the carriageway (the carriageway is the part of the roadarea designed for vehicle traffic), e.g. cars are not allowed to drive or station on a BicyclePath. ATTENTION: Not to be confused with bicycle lanes (part of the carriageway) or with the side lanes of the central carriageway (not part of the carriageway but on which cars may drive to avoid oncoming traffic). BicyclePaths can be adjacent to the carriageway or separate or even have their own road Lane (in the latter case they are represented by their own RoadSegment)."
                    }
                ],
                "Scope": "FULL_DEFINITON"
            },
