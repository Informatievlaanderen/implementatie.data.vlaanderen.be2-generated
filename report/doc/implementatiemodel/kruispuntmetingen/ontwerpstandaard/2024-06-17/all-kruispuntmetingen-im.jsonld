                    {
                        "key": "uri",
                        "value": "http://def.isotc211.org/iso19108/2006/TemporalObjects#TM_Object",
                        "note": "null"
                    },
                    {
                        "key": "ap-label-en",
                        "value": "TemporalEntity",
                        "note": "null"
                    },
                    {
                        "key": "ap-definition-en",
                        "value": "Abstract class for temporal objects.",
                        "note": "null"
                    },
                    {
                        "key": "ap-usageNote-en",
                        "value": "NOTE",
                        "note": "These temporal entities are temporal geometric primitives like Instant or Interval. Or they are composites of temporal primitives, for example to represent the history of a phenomenon (for example the successive periods during which the phenomenon occurred). To be used when the final temporal primitive is not yet known. REMARK: More info in <a href=\"https://iso.org/standard/26013.html\">ISO 19108 Geographic Information - Temporal schema</a>. Substitution by a simpler equivalent like Data/DateTime/Time or subclasses of time:TemporalEntity from  <a href=\"https://w3.org/TR/owl-time/\">W3C Time Ontology</a> is recommended."
                    }
                ],
                "Scope": "TRANSLATIONS_ONLY"
            },
            "name": "Temporeleentiteit"
        },
        {
            "@id": "http://def.isotc211.org/iso19109/2005/GeneralFeatureModel#GF_PropertyType",
            "@type": "http://www.w3.org/2002/07/owl#Class",
            "inpackage": "OTHER_PACKAGE",
            "ap-usageNote-nl": {
                "nl": "Dit is een kenmerk van het geobseveerdObject (ttz van het DomeinObject of van een proxy daarvan, het Bemonsteringsobject) en in principe van alle instanties van dat type geobserveerdObject. In de context van Verkeersmetingen gaat het om kenmerken zoals Snelheid (van een Voertuig - het geobserveerd Domeinobject) of AantalVoertuigen (dat passeert aan een Meetpunt - het geobserveerd Bemonsteringsobject - langs een Wegsegment - het bemonsterd Domeinobject)."
            },
