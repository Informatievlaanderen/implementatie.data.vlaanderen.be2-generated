                "label": {
                    "nl": "netwerkreferentie"
                },
                "definition": {
                    "nl": "Verwijzing naar het Netwerkelement waarop het Voetpad betrekking heeft."
                },
                "usage": {
                    "nl": "In de context van dit applicatieprofiel is het Netwerkelement een Wegsegment of een Weglinksequentie. De Netwerkreferentie laat ook toe om een Voetpad te specifiëren voor slechts een stuk van de weg of voor één bepaalde wegkant.\r\n"
                },
                "ap-label-nl": {
                    "nl": "netwerkreferentie"
                },
                "ap-definition-nl": {
                    "nl": "Verwijzing naar het Netwerkelement waarop het Voetpad betrekking heeft."
                },
                "ap-usageNote-nl": {
                    "nl": "In de context van dit applicatieprofiel is het Netwerkelement een Wegsegment of een Weglinksequentie. De Netwerkreferentie laat ook toe om een Voetpad te specifiëren voor slechts een stuk van de weg of voor één bepaalde wegkant.\r\n"
                },
