      ]
    },
    {
      "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#voertuigType",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "label": {
        "nl": "voertuigType"
      },
      "definition": {
        "nl": "Soort Voertuig waarvan men het Verkeerskenmerk meet."
      },
      "usage": {
        "nl": "Bvb \"Fiets\" als men enkel het aantal fietsen wil tellen in een Meetpunt. Enkel noodzakelijk voor Verkeersdomeinobjecten die zelf geen Voertuig zijn maar bvb een Wegsegment of Rijstrook etc."
      },
      "domain": [
        "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerskenmerk"
      ],
      "range": [
        "https://data.vlaanderen.be/ns/transportnetwerk#Voertuigtype"
      ],
      "generalization": []
    },
    {
      "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#verkeersdeelnemerType",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "label": {
        "nl": "verkeersdeelnemertype"
      },
      "definition": {
        "nl": "Soort Verkeersdeelnemer waarvan men het Verkeerskenmerk meet."
      },
      "usage": {
        "nl": "Bvb \"Voetganger\" als men enkel het aantal Voertgangers wil tellen in een Meetpunt. Enkel noodzakelijk voor Verkeersdomeinobjecten die zelf geen Verkeersdeelnemer zijn maar bvb een Wegsegment of Rijstrook etc."
      },
      "domain": [
        "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerskenmerk"
      ],
      "range": [
        "http://www.w3.org/2004/02/skos/core#Concept"
      ],
      "generalization": []
    },
    {
      "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#tellingresultaat",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "label": {
        "nl": "Verkeerstelling.tellingresultaat"
      },
      "definition": {
        "nl": "De waarde van het geobserveerdKenmerk als resultaat van de Verkeerstelling (aantal)."
      },
      "domain": [
        "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerstelling"
      ],
      "range": [
        "http://www.w3.org/2001/XMLSchema#double"
      ],
      "generalization": []
    },
    {
      "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#rijstrook",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "label": {
        "nl": "rijstrook"
      },
      "definition": {
        "nl": "Identificator van de Rijstrook."
      },
      "usage": {
        "nl": "De identificator moet getypeerd worden bvb volgens het systeem dat werd gehanteerd om de Rijstroken te nummeren. Bvb het schema van DATEX II waar over de volledige breedte van de weg van links naar rechts wordt genummerd."
      },
      "domain": [
        "https://data.vlaanderen.be/ns/verkeersmetingen#Rijstrook"
      ],
      "range": [
        "http://www.w3.org/ns/adms#Identifier"
      ],
      "generalization": []
    },
    {
      "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#ligging",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "label": {
        "nl": "ligging"
      },
      "definition": {
        "nl": "Locatie van de Sensor."
      },
      "usage": {
        "nl": "Bvb de coördinaten of het adres of een verwijzing naar een meetpunt of ander Bemonsteringsobject. Meerdere verschillende types van locaties kunnen worden opgegeven (bvb adres èn coördinaten). Als de Sensor een meetinstallatie is evt de verschillende meetpunten die worden omvat of een omschrijvende polygoon. OPGELET: De locatie van de Sensor is niet noodzakelijk de positie waar de Observatie gebeurt, die wordt in de eerste plaats gegeven door de ligging vh Bemonsteringsobject. Dit attribuut laat vooral toe om posities van Sensoren te beschrijven los vd metingen die er gebeuren."
      },
      "domain": [
        "http://www.w3.org/ns/sosa/Sensor"
      ],
      "range": [
        "http://www.w3.org/ns/prov#Location"
      ],
      "generalization": []
    },
    {
      "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#kenmerktype",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property",
      "label": {
        "nl": "Verkeerstellingkenmerk.kenmerktype"
      },
      "definition": {
        "nl": "Kenmerktype 'aantal' is het specifieke kenmerktype van de verkeerstelling"
      },
      "domain": [
        "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerstellingskenmerk"
      ],
      "range": [],
      "generalization": []
    },
    {
