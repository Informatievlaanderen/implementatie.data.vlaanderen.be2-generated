  "properties": [
    {
      "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#waardeverschaffer",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "label": {
        "nl": "waardeverschaffer"
      },
      "definition": {
        "nl": "Verwijzing naar een Verkeersmeting die op het geobserveerdObject plaatsvondt."
      },
      "usage": {
        "nl": "Die meting verschaft ahw een waarde voor het Verkeerskenmerk dat van het Verkeersobject wordt gemeten."
      },
      "domain": [
        "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersobject"
      ],
