    },
    {
      "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#geobserveerdObject",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "label": {
        "nl": "geobserveerdObject"
      },
      "definition": {
        "nl": "Het Verkeersobject dat geobserveerd wordt."
      },
      "usage": {
        "nl": "Dat kan het Verkeersdomeinobject zelf zijn of een proxy ervan, ttz een Verkeersbemonsteringsobject. OPMERKING: In dat laatste geval weet men soms pas na het observeren welk real-world Object men juist geobserveerd heeft. Bvb in een Verkeersmeetpunt weet men niet op voorhand welke de objecten zullen zijn waarvan men de snelheid wil vaststellen."
      },
      "domain": [
        "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeting"
      ],
      "range": [
        "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersobject"
      ],
      "generalization": [
        "http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.featureOfInterest"
      ]
    },
    {
      "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#geobserveerdKenmerk",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property",
      "label": {
        "nl": "Verkeerstelling.geobserveerdKenmerk"
      },
      "definition": {
        "nl": "Object dat door de Verkeerstelling wordt geobserveerd.\t"
      },
      "domain": [
        "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerstelling"
      ],
      "range": [],
      "generalization": []
    },
    {
      "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#geobserveerdKenmerk",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property",
      "label": {
        "nl": "Verkeerssnelheidsmeting.geobserveerdKenmerk"
      },
      "definition": {
        "nl": "Object dat door de Verkeerssnelheidsmetingen wordt geobserveerd.\t"
      },
      "domain": [
        "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeerssnelheidsmeting"
      ],
      "range": [],
      "generalization": []
    },
    {
      "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#bemonsterdObject",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "label": {
        "nl": "bemonsterdObject"
      },
      "definition": {
        "nl": "Verwijzing naar het Verkeersdomeinobject waarop de meting betrekking heeft en waarvoor het Verkeersbemonsteringsobject representatief is."
      },
      "usage": {
        "nl": "Bvb het Voertuig of het Wegsegment waarvan men een Verkeerskenmerk bepaalt."
      },
      "domain": [
        "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersbemonsteringsobject"
      ],
      "range": [
        "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersdomeinobject"
      ],
      "generalization": [
        "http://def.isotc211.org/iso19156/2011/SamplingFeature#SF_SamplingFeature.sampledFeature"
      ]
    },
    {
      "@id": "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeettraject.netwerkreferentie",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "label": {
        "nl": "netwerkReferentie"
      },
      "definition": {
        "nl": "Referentie naar het Netwerkelement waarlangs het Verkeersmeettraject loopt of dat door dat traject bemonsterd wordt."
      },
      "usage": {
        "nl": "Nuttig als men weet langs welk Wegsegment het traject loopt en aan welke kant van de weg en op welke afstand van het beginpunt. Alternatief voor of aanvulling op coördinaten. Ook noodzakelijk om aan te geven over welk Wegsegment en aan welke kant ervan de Voertuigen rijden waarvan men bvb de snelheid meet.\n"
      },
      "domain": [
        "https://data.vlaanderen.be/ns/verkeersmetingen#Verkeersmeettraject"
      ],
      "range": [
        "https://data.vlaanderen.be/ns/netwerk#Netwerkreferentie"
      ],
      "generalization": []
    }
  ],
