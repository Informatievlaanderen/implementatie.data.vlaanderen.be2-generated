      },
      "Adres": {
        "title": "Adres",
        "type": "object",
        "description": "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid, een ligplaats, een standplaats of een perceel op basis van een gemeentenaam, een straatnaam, een huisnummer en eventueel een busnummer en een postcode.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Adres)",
            "pattern": "^Adres$"
          },
          "isToegekendAan": {
            "type": "array",
            "description": "Lijst van AdresseerbaarObject items.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Gebouweenheid"
                },
                {
                  "$ref": "#/components/schemas/RuimtelijkeEenheid"
                }
              ],
              "discriminator": {
                "propertyName": "@type",
                "mapping": {
                  "Gebouweenheid": "#/components/schemas/Gebouweenheid",
                  "RuimtelijkeEenheid": "#/components/schemas/RuimtelijkeEenheid"
                }
              }
            },
            "minItems": 1
          },
          "identificator": {
            "$ref": "#/components/schemas/Identificator"
          }
        },
        "required": [
          "@type"
        ]
      },
      "Gebouw": {
        "title": "Gebouw",
        "type": "object",
        "description": "Een gesloten en/of overdekt, bovengronds of ondergronds bouwwerk, dat dient of bestemd is, ofwel om mensen, dieren en voorwerpen onder te brengen, ofwel om economische goederen te vervaardigen of diensten te verstrekken. Een gebouw verwijst naar gelijk welke structuur die op blijvende wijze op een terrein opgetrokken of gebouwd wordt.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Gebouw)",
            "pattern": "^Gebouw$"
          },
          "bestaatUit": {
            "type": "array",
            "description": "Lijst van Gebouweenheid items.",
            "items": {
              "$ref": "#/components/schemas/Gebouweenheid"
            },
            "minItems": 1
          },
          "ligtOp": {
            "type": "array",
            "description": "Lijst van RuimtelijkeEenheid items.",
            "items": {
              "$ref": "#/components/schemas/RuimtelijkeEenheid"
            },
            "minItems": 1
          },
          "identificator": {
            "$ref": "#/components/schemas/Identificator"
          }
        },
        "required": [
          "@type"
        ]
      },
      "Gebouweenheid": {
        "title": "Gebouweenheid",
        "type": "object",
        "description": "De kleinste eenheid binnen een gebouw die geschikt is voor woon-, bedrijfsmatige, of recreatieve doeleinden en die ontsloten wordt via een eigen afsluitbare toegang vanaf de openbare weg, een erf of een gedeelde circulatieruimte. Een gebouweenheid is in functioneel opzicht zelfstandig. Daarnaast kan een gebouweenheid ook een gemeenschappelijk deel zijn.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Gebouweenheid)",
            "pattern": "^Gebouweenheid$"
          },
          "afwijkingVastgesteld": {
            "type": "object",
            "description": "Wanneer de definitie van een gebouweenheid niet werd gevolgd en dus 'afwijkend' is.",
            "properties": {
              "@value": {
                "type": "boolean"
              },
              "@type": {
                "type": "string",
                "pattern": "^Boolean$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "positie": {
            "$ref": "#/components/schemas/GeografischePositie"
          },
          "isDeelVan": {
            "$ref": "#/components/schemas/Gebouw"
          },
          "toegekendAdres": {
            "type": "array",
            "description": "Lijst van Adres items.",
            "items": {
              "$ref": "#/components/schemas/Adres"
            },
            "minItems": 1
          },
          "identificator": {
            "$ref": "#/components/schemas/Identificator"
          }
        },
        "required": [
          "@type"
        ]
      },
      "RuimtelijkeEenheid": {
        "title": "RuimtelijkeEenheid",
        "type": "object",
        "description": "Eén gebied (of meerdere gebieden) van land en/of water, of één enkel volume (of meerdere volumes) ruimte, afgebakend voor een bepaald doel.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse RuimtelijkeEenheid)",
            "pattern": "^RuimtelijkeEenheid$"
          },
          "toegekendAdres": {
            "type": "array",
            "description": "Lijst van Adres items.",
            "items": {
              "$ref": "#/components/schemas/Adres"
            },
            "minItems": 1
          },
          "identificator": {
            "$ref": "#/components/schemas/Identificator"
          }
        },
        "required": [
          "@type"
        ]
      },
