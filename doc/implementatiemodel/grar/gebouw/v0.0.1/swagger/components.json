            "pattern": "^Identificator$"
          },
          "identificator": {
            "type": "object",
            "description": "String gebruikt om het object uniek te identificeren. Type van de string slaat op het identificatiesysteem (inclusief de versie ervan), de string zelf op de eigenlijke identificator.",
            "properties": {
              "@value": {
                "type": "string"
              },
              "@type": {
                "type": "string"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "gestructureerdeIdentificator": {
            "$ref": "#/components/schemas/GestructureerdeIdentificator"
