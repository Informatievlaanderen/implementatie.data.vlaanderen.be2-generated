{
  "title": "Straatnaam",
  "type": "object",
  "description": "Adrescomponent met de naam die officieel werd toegekend aan een straat (baan, doorgang, plein) of aan een gehucht en waaraan adressen kunnen zijn gekoppeld.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Straatnaam)",
      "pattern": "^Straatnaam$"
    },
    "homoniemToevoeging": {
      "type": "object",
      "description": "Toevoeging om dubbele straatnamen (straatnamen met dezelfde naam maar andere ligging in de gemeente en eigen adressen) van elkaar te onderscheiden.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "straatnaam": {
      "type": "array",
      "description": "Lijst van GeografischeNaam items.",
      "items": {
        "type": "object",
        "description": "Naam van de straat.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1
    },
    "status": {
      "$ref": "#/components/schemas/Statuswaarde"
    },
    "detail": {
      "type": "object",
      "description": "Een bron dat additionele info over het object bevat.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "isToegekendDoor": {
      "$ref": "#/components/schemas/Gemeente"
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    }
  },
  "required": [
    "@type",
    "straatnaam"
  ]
}