        "$ref": "#/components/schemas/AnyURI"
      },
      "minItems": 1
    },
    "detailGebouweenheden": {
      "type": "array",
      "description": "Lijst van AnyURI items.",
      "items": {
        "$ref": "#/components/schemas/AnyURI"
      },
      "minItems": 1
    },
    "detailPercelen": {
      "type": "array",
      "description": "Lijst van AnyURI items.",
      "items": {
        "$ref": "#/components/schemas/AnyURI"
      },
      "minItems": 1
    },
    "detailStraatnamen": {
      "type": "array",
      "description": "Lijst van AnyURI items.",
      "items": {
        "$ref": "#/components/schemas/AnyURI"
      },
      "minItems": 1
    },
    "detailAdressen": {
      "type": "array",
      "description": "Lijst van AnyURI items.",
      "items": {
        "$ref": "#/components/schemas/AnyURI"
      },
      "minItems": 1
