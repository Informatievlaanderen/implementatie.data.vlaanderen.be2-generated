{
  "title": "GeografischePositie",
  "type": "object",
  "description": "Geografische positie aangegeven door middel van een punt.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse GeografischePositie)",
      "pattern": "^GeografischePositie$"
    },
    "default": {
      "type": "object",
      "description": "Geeft aan of de positie een default positie is. Hieronder wordt de positie verstaan die per default moet worden gebruikt als het object meerdere posities heeft.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "geometrie": {
      "$ref": "#/components/schemas/Punt"
    },
    "methode": {
      "$ref": "#/components/schemas/GeometrieMethodeWaarde"
    },
    "specificatie": {
      "$ref": "#/components/schemas/GeometriSpecificatieWaarde"
    }
  },
  "required": [
    "@type",
    "default",
    "geometrie"
  ]
}