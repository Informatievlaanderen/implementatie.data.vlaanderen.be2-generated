{
  "title": "Identificator",
  "type": "object",
  "description": "Informatie gebruikt om een object uniek te identificeren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Identificator)",
      "pattern": "^Identificator$"
    },
    "identificator": {
      "type": "object",
      "description": "String gebruikt om het object uniek te identificeren. Type vd string slaat op het identificatiesysteem (incl de versie ervan), de string zelf op de eigenlijke identificator.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "toegekendDoor(String)": {
      "type": "object",
      "description": "Naam vd agent die de identificator heeft toegekend.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "toegekendOp": {
      "type": "object",
      "description": "Tijdstip waarop de identificator werd uitgegeven.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "gestructureerdeIdentificator": {
      "$ref": "#/components/schemas/GestructureerdeIdentificator"
    },
    "toegekendDoor": {
      "$ref": "#/components/schemas/Herkomstagent"
    }
  },
  "required": [
    "@type"
  ]
}