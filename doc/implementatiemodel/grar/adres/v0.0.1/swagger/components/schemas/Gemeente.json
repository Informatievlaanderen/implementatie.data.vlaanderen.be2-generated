{
  "title": "Gemeente",
  "type": "object",
  "description": "Officiële administratieve zone van het Belgisch grondgebied. De gemeente is het kleinste administratieve deel van het Belgisch grondgebied waarvan de grenzen enkel door de wetgever kunnen worden gewijzigd.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Gemeente)",
      "pattern": "^Gemeente$"
    },
    "officieleTaal": {
      "type": "array",
      "description": "Lijst van Literal items.",
      "items": {
        "type": "object",
        "description": "De officiële talen van de gemeente.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "faciliteitenTaal": {
      "type": "array",
      "description": "Lijst van Literal items.",
      "items": {
        "type": "object",
        "description": "De faciliteiten talen van de gemeente.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "detail": {
      "type": "object",
      "description": "Een bron dat additionele info over het object bevat.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "status": {
      "$ref": "#/components/schemas/Statuswaarde"
    },
    "naam": {
      "$ref": "#/components/schemas/Gemeentenaam"
    },
    "identificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}