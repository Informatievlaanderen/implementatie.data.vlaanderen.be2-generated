{
  "title": "Postinfo",
  "type": "object",
  "description": "Adrescomponent die verwijst naar informatie toegekend door de aanbieder van de universele postdienst voor de identificatie van een groepering van adressen in een geografisch gebied voor postale doeleinden.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Postinfo)",
      "pattern": "^Postinfo$"
    },
    "postcode": {
      "type": "object",
      "description": "Code waarmee het geografisch gebied dat de adressen voor postale doeleinden groepeert aanduidt.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "postnaam": {
      "type": "array",
      "description": "Lijst van GeografischeNaam items.",
      "items": {
        "type": "object",
        "description": "Naam waarmee het geografisch gebied dat de adressen voor postale doeleinden groepeert kan worden aangeduid. Typisch de namen van vroegere gemeenten waarmee het gebied samenvalt.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1
    },
    "nuts3": {
      "type": "object",
      "description": "De bijhorende NUTS 3 code.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "status": {
      "$ref": "#/components/schemas/Statuswaarde"
    },
    "detail": {
      "type": "object",
      "description": "Een bron dat additionele info over het object bevat.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "isToegekendAan": {
      "$ref": "#/components/schemas/Gemeente"
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    }
  },
  "required": [
    "@type"
  ]
}