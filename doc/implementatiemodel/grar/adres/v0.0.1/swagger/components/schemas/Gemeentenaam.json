{
  "title": "Gemeentenaam",
  "type": "object",
  "description": "Adrescomponent die verwijst naar de naam van een gemeente, het is te zeggen het kleinste administratieve deel van het Belgisch grondgebied waarvan de grenzen enkel door de wetgever kunnen worden gewijzigd.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Gemeentenaam)",
      "pattern": "^Gemeentenaam$"
    },
    "gemeentenaam": {
      "type": "array",
      "description": "Lijst van GeografischeNaam items.",
      "items": {
        "type": "object",
        "description": "Naam van de gemeente.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@language": {
            "type": "string",
            "pattern": "^nl$"
          }
        },
        "required": [
          "@value",
          "@language"
        ]
      },
      "minItems": 1
    },
    "isAfgeleidVan": {
      "$ref": "#/components/schemas/Gemeente"
    }
  },
  "required": [
    "@type",
    "gemeentenaam"
  ]
}