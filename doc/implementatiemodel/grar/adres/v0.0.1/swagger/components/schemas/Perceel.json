{
  "title": "Perceel",
  "type": "object",
  "description": "Eén gebied (of meerdere gebieden) van land en/of water, of één enkel volume (of meerdere volumes) ruimte, afgebakend voor een bepaald doel.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Perceel)",
      "pattern": "^Perceel$"
    },
    "identificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}