{
  "title": "Stopzetting",
  "type": "object",
  "description": "Gebeurtenis waarbij een Organisatie is stopgezet.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Stopzetting)",
      "pattern": "^Stopzetting$"
    },
    "redenStopzetting": {
      "$ref": "#/components/schemas/StopzettingType"
    },
    "datum": {
      "type": "object",
      "description": "Datum waarop de Veranderingsgebeurtenis plaatsvond. Zie Time and date & Recurring and partial dates van <a href=\"https://www.w3.org/TR/rdf11-concepts/#h2_section-Datatypes\"> XSD Datatypes</a>.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    }
  },
  "required": [
    "@type",
    "datum"
  ]
}