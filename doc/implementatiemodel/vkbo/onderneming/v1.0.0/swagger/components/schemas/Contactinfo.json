{
  "title": "Contactinfo",
  "type": "object",
  "description": "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Contactinfo)",
      "pattern": "^Contactinfo$"
    },
    "email": {
      "type": "object",
      "description": "Email-adres waarnaar men kan mailen.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "telefoon": {
      "type": "array",
      "description": "Lijst van Literal items.",
      "items": {
        "type": "object",
        "description": "Telefoonnummer waarop men kan bellen. Gebruik W3C VCard TelephoneType om het soort telefoonnummer aan te duiden.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "adres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    }
  },
  "required": [
    "@type"
  ]
}