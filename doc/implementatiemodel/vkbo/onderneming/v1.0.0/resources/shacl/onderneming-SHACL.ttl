    shacl:name "type"@nl;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/financiele-rapportering#FinancieelRapport> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v1.0.0#FormeleOrganisatieShape> a shacl:NodeShape;
  rdfs:label "FormeleOrganisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld een bedrijf,een vzw,een overheidsorgaan,een kerkgemeenschap."@nl;
  rdfs:comment "Een erkende Organisatie,erkend in brede zin of  meer specifiek in juridische zin met bijbehorende rechten en plichten."@nl;
  shacl:closed false;
