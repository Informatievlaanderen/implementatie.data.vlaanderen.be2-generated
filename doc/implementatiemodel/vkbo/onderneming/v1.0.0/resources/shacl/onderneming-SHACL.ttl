    rdfs:label "reden"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: geen neerlegging van de jaarrekening."@nl;
    rdfs:comment "De reden van de doorhaling."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v1.0.0#Doorhaling.Reden>;
    shacl:class skos:Concept;
    shacl:description "De reden van de doorhaling."@nl;
    shacl:maxCount 1;
    shacl:name "reden"@nl;
    shacl:path dc:provenance
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/vkbo/onderneming#Doorhaling> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v1.0.0#FinancieelRapportShape> a shacl:NodeShape;
