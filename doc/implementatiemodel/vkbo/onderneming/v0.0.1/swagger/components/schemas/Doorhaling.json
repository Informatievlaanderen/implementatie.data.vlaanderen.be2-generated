{
  "title": "Doorhaling",
  "type": "object",
  "description": "Gebeurtenis waarbij een Organisatie is geschrapt in het KBO.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Doorhaling)",
      "pattern": "^Doorhaling$"
    },
    "doorhalingstype": {
      "$ref": "#/components/schemas/Doorhalingstype"
    },
    "redenDoorhaling": {
      "$ref": "#/components/schemas/RedenDoorhaling"
    },
    "tijd": {
      "$ref": "#/components/schemas/Periode"
    },
    "datum": {
      "type": "object",
      "description": "Datum waarop de Veranderingsgebeurtenis plaatsvond. Zie Time and date & Recurring and partial dates van <a href=\"https://www.w3.org/TR/rdf11-concepts/#h2_section-Datatypes\"> XSD Datatypes</a>.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    }
  },
  "required": [
    "@type",
    "redenDoorhaling",
    "tijd",
    "datum"
  ]
}