<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld als attribuut van een persoon of gebouw, ... De adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "administratieve eenheid niveau 1"@nl;
    rdfs:comment "Hoogste Administratieve eenheid van het adres, doorgaans een land."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.AdministratieveEenheidNiveau1>;
    shacl:datatype rdf:langString;
    shacl:description "Hoogste Administratieve eenheid van het adres, doorgaans een land."@nl;
    shacl:maxCount "1";
    shacl:name "administratieve eenheid niveau 1"@nl;
    shacl:path <http://www.w3.org/ns/locn#adminUnitL1>
  ], [
    a shacl:PropertyShape;
    rdfs:label "administratieve eenheid niveau 2"@nl;
    rdfs:comment "De regio van het adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.AdministratieveEenheidNiveau2>;
    shacl:datatype rdf:langString;
    shacl:description "De regio van het adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    shacl:maxCount "1";
    shacl:name "administratieve eenheid niveau 2"@nl;
    shacl:path <http://www.w3.org/ns/locn#adminUnitL2>
  ], [
    a shacl:PropertyShape;
    rdfs:label "adresgebied"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bvb de naam van het gehucht waarin het adres ligt."@nl;
    rdfs:comment "Naam van een geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.Adresgebied>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van een geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is."@nl;
    shacl:maxCount "1";
    shacl:name "adresgebied"@nl;
    shacl:path <http://www.w3.org/ns/locn#addressArea>
  ], [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding ten behoeve van Belgische adressen."@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount "1";
    shacl:name "busnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    rdfs:comment "Gemeentenaam van het adres."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.Gemeentenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Gemeentenaam van het adres."@nl;
    shacl:maxCount "1";
    shacl:name "gemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Gemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding tbv Belgische adressen."@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount "1";
    shacl:name "huisnummer"@nl;
    shacl:path rdfs:label
  ], [
    a shacl:PropertyShape;
    rdfs:label "land"@nl;
    rdfs:comment "Land waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.Land>;
    shacl:datatype rdf:langString;
    shacl:description "Land waarin het adres gelegen is."@nl;
    shacl:maxCount "1";
    shacl:name "land"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#land>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatieaanduiding"@nl;
    rdfs:comment "Alfanumerieke code die de adreslocator uniek identificeert binnen de straat, administratieve eenheid etc."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.Locatieaanduiding>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code die de adreslocator uniek identificeert binnen de straat, administratieve eenheid etc."@nl;
    shacl:name "locatieaanduiding"@nl;
    shacl:path <http://www.w3.org/ns/locn#locatorDesignator>
  ], [
    a shacl:PropertyShape;
    rdfs:label "locatienaam"@nl;
    rdfs:comment "Naam of omschrijving van het het geografisch object dat de adreslocator aanduidt."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.Locatienaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam of omschrijving van het het geografisch object dat de adreslocator aanduidt."@nl;
    shacl:name "locatienaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#locatorName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postbus"@nl;
    rdfs:comment "Postbusnummer in een postkantoor."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.Postbus>;
    shacl:datatype xsd:string;
    shacl:description "Postbusnummer in een postkantoor."@nl;
    shacl:maxCount "1";
    shacl:name "postbus"@nl;
    shacl:path <http://www.w3.org/ns/locn#poBox>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    rdfs:comment "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.Postcode>;
    shacl:datatype xsd:string;
    shacl:description "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postcode"@nl;
    shacl:path <http://www.w3.org/ns/locn#postCode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postnaam"@nl;
    rdfs:comment "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.Postnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:name "postnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#postName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "Straatnaam van het adres."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.Straatnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Straatnaam van het adres."@nl;
    shacl:maxCount "1";
    shacl:name "straatnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#thoroughfare>
  ], [
    a shacl:PropertyShape;
    rdfs:label "volledigAdres"@nl;
    <http://purl.org/vocab/vann/usageNote> "Vermijdt fouten ten gevolge van het opsplitsen van een adres in zijn onderdelen. Geeft de voorgeschreven volgorde van de verschillende onderdelen weer."@nl;
    rdfs:comment "Het complete adres in één string, al dan niet geformatteerd."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.Volledigadres>;
    shacl:datatype rdf:langString;
    shacl:description "Het complete adres in één string, al dan niet geformatteerd."@nl;
    shacl:maxCount "1";
    shacl:name "volledigAdres"@nl;
    shacl:path <http://www.w3.org/ns/locn#fullAddress>
  ], [
    a shacl:PropertyShape;
    rdfs:label "verwijstNaar"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dit kan enkel voor Belgische adressen aangezien onder adres een Belgisch adres wordt verstaan."@nl;
    rdfs:comment "Adres waarvan de adresvoorstelling is afgeleid."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Adresvoorstelling.Verwijstnaar>;
    shacl:class <https://data.vlaanderen.be/ns/adres#Adres>;
    shacl:description "Adres waarvan de adresvoorstelling is afgeleid."@nl;
    shacl:maxCount 1;
    shacl:name "verwijstNaar"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#verwijstNaar>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#BelgischAdresShape> a shacl:NodeShape;
  rdfs:label "Belgisch Adres"@nl;
  <http://purl.org/vocab/vann/usageNote> "De definitie heeft betrekking op Belgische adressen. In andere landen kan een adres eventueel verwijzen naar andere geografisch objecten (niet gebouweenheid of perceel) of bestaan uit andere aanduidingen (verschillend van huisnummer en busnummer) of uit andere componenten dan straatnaam, gemeentenaam of postcode. Alternatieve adresaanduidingen dan huisnummer of busnummer (bv ingangaanduiding, trapaanduiding, verdiepaanduiding...) of een gebouwnaam of kamernaam ed zijn mogelijk dmv een associatie met adresuitbreiding. Uitwisseling van buitenlandse adressen moet gebeuren mbv het object adresvoorstelling."@nl;
  rdfs:comment "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid,een ligplaats,een standplaats of een perceel op basis van een gemeentenaam,een straatnaam,een huisnummer en eventueel een busnummer en een postcode."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Identificator van het Adres."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#BelgischAdres.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/adres#Adres> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#ContactinfoShape> a shacl:NodeShape;
  rdfs:label "Contactinfo"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen, etc."@nl;
  rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "email"@nl;
    rdfs:comment "Email-adres waarnaar men kan mailen."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Contactinfo.Email>;
    shacl:datatype xsd:string;
    shacl:description "Email-adres waarnaar men kan mailen."@nl;
    shacl:maxCount "1";
    shacl:name "email"@nl;
    shacl:path schemas:email
  ], [
    a shacl:PropertyShape;
    rdfs:label "telefoon"@nl;
    rdfs:comment "Telefoonnummer waarop men kan bellen."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Contactinfo.Telefoon>;
    shacl:datatype xsd:string;
    shacl:description "Telefoonnummer waarop men kan bellen."@nl;
    shacl:maxCount "1";
    shacl:name "telefoon"@nl;
    shacl:path schemas:telephone
  ], [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Adres dat men kan aanschrijven of bezoeken."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Contactinfo.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres dat men kan aanschrijven of bezoeken."@nl;
    shacl:maxCount "1";
    shacl:name "adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#address>
  ];
  shacl:targetClass schemas:ContactPoint .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#DateShape> a shacl:NodeShape;
  rdfs:label "Date";
  shacl:closed false;
  shacl:targetClass xsd:date .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#DoorhalingShape> a shacl:NodeShape;
  rdfs:label "Doorhaling"@nl;
  rdfs:comment "Gebeurtenis waarbij een Organisatie is geschrapt in het KBO."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "doorhalingstype"@nl;
    rdfs:comment "Reden waarom de Organisatie is geschrapt."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Doorhaling.Doorhalingstype>;
    shacl:class skos:Concept;
    shacl:description "Reden waarom de Organisatie is geschrapt."@nl;
    shacl:maxCount "1";
    shacl:name "doorhalingstype"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "reden";
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: geen neerlegging van de jaarrekening."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Doorhaling.Reden>;
    shacl:class skos:Concept;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "reden";
    shacl:path <https://data.vlaanderen.be/ns/organisatie#reden>
  ], [
    a shacl:PropertyShape;
    rdfs:label "tijd"@nl;
    rdfs:comment "Refereert naar de periode van tijd waarin de Doorhaling van kracht is."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Doorhaling.Tijd>;
    shacl:class <http://www.w3.org/2006/time#ProperInterval>;
    shacl:description "Refereert naar de periode van tijd waarin de Doorhaling van kracht is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "tijd"@nl;
    shacl:path prov:time
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/organisatie#Doorhaling> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#GeografischepositieShape> a shacl:NodeShape;
  rdfs:label "GeografischePositie"@nl;
  rdfs:comment "Geografische positie aangegeven door middel van een punt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    rdfs:comment "De cartografische coöordinaten van het punt."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geografischepositie.Geometrie>;
    shacl:class <http://www.opengis.net/ont/sf#Point>;
    shacl:description "De cartografische coöordinaten van het punt."@nl;
    shacl:maxCount "1";
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/generiek#GeografischePositie> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#GeometrieShape> a shacl:NodeShape;
  rdfs:label "Geometrie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Beschrijft deze kenmerken door middel van punten, lijnen, polygonen en coördinaten."@nl;
  rdfs:comment "Vorm- en positiekenmerken van een object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "gml"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik http://www.opengis.net/ont/geosparql#gmlLiteral als datatype."@nl;
    rdfs:comment "Geometrie uitgedrukt in GML-formaat."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geometrie.Gml>;
    shacl:description "Geometrie uitgedrukt in GML-formaat."@nl;
