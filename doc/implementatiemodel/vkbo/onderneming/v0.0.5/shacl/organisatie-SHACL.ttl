  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "redenStopzetting"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld pensionering, faillissement, etc."@nl;
    rdfs:comment "Reden waarom de Organisatie is stopgezet."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Stopzetting.Redenstopzetting>;
    shacl:class skos:Concept;
    shacl:description "Reden waarom de Organisatie is stopgezet."@nl;
    shacl:maxCount "1";
    shacl:name "redenStopzetting"@nl;
    shacl:path <https://data.vlaanderen.be/ns/organisatie#redenStopzetting>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/organisatie#Stopzetting> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#TemporeleentiteitShape> a shacl:NodeShape;
  rdfs:label "TemporeleEntiteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "TemporeleEntiteiten zijn temporele geometrische primitieven zoals Moment of Periode. Dit datatype is abstract, gebruik één van de subklassen."@nl;
  rdfs:comment "Abstracte klasse voor temporele objecten."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/2006/time#Instant>,
    <http://www.w3.org/2006/time#ProperInterval>,
    <http://www.w3.org/2006/time#TemporalEntity> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#VeranderingsgebeurtenisShape> a shacl:NodeShape;
  rdfs:label "Veranderingsgebeurtenis"@nl;
  <http://purl.org/vocab/vann/usageNote> "Is bedoeld voor situaties waarbij de de resulterende Organisatie zodanig verschilt van de oorspronkelijke dat ze beschouwd kan worden als een nieuwe Organisatie."@nl;
  rdfs:comment "Gebeurtenis waardoor een Organisatie een belangrijke wijziging ondergaat zoals een fusie of een herstructurering."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum"@nl;
    <http://purl.org/vocab/vann/usageNote> "Zie Time and date & Recurring and partial dates van <a href=\"https://www.w3.org/TR/rdf11-concepts/#h2_section-Datatypes\"> XSD Datatypes</a>."@nl;
    rdfs:comment "Datum waarop de Veranderingsgebeurtenis plaatsvond."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Veranderingsgebeurtenis.Datum>;
    shacl:datatype xsd:date;
    shacl:description "Datum waarop de Veranderingsgebeurtenis plaatsvond."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datum"@nl;
    shacl:path dc:date
  ];
  shacl:targetClass org:ChangeEvent,
    <https://data.vlaanderen.be/ns/organisatie#Stopzetting>,
    <http://data.europa.eu/m8g/FoundationEvent> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#VestigingShape> a shacl:NodeShape;
  rdfs:label "Vestiging"@nl;
  <http://purl.org/vocab/vann/usageNote> "Meestal zal de Vestiging een fysieke locatie zijn. Niet-fysieke locaties worden echter niet uitgesloten, bijvoorbeeld een virtueel kantoor met bijbehorend postnummer en telefonische receptie."@nl;
  rdfs:comment "Een kantoor of ander pand waar een Organisatie gevestigd is. Organisaties kunnen over meerdere Vestigingen verspreid zijn en Vestigingen kunnen op meerdere locaties slaan."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datumStart";
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Vestiging.Datumstart>;
    shacl:datatype xsd:date;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datumStart";
    shacl:path org:datumStart
  ], [
    a shacl:PropertyShape;
    rdfs:label "datumStopzetting";
