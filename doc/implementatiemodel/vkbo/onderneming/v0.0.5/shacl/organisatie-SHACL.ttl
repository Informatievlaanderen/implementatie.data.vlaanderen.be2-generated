    <http://www.opengis.net/ont/sf#Point> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#GeregistreerdeorganisatieShape> a shacl:NodeShape;
  rdfs:label "GeregistreerdeOrganisatie"@nl;
  <http://purl.org/vocab/vann/usageNote> "In België moeten onder andere volgende Organisaties zich registreren: vennootschap (NV, BV, etc), eenmanszaak, overheidsorgaan, stichting, … Bij registratie krijgt de Organisatie een ondernemingsnummer en worden zijn gegevens ingevoerd in de Kruispuntbank van Ondernemingen (KBO)."@nl;
  rdfs:comment "Organisatie met een juridisch statuut vastgelegd door registratie. Vergelijk met een FormeleOrganisatie waarbij dit statuut ook op een andere manier verkregen kan zijn."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "wettelijke naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Evt in verschillende talen."@nl;
    rdfs:comment "Wettelijk geregistreerde naam vd organisatie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geregistreerdeorganisatie.WettelijkeNaam>;
    shacl:datatype rdf:langString;
    shacl:description "Wettelijk geregistreerde naam vd organisatie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "wettelijke naam"@nl;
    shacl:path <http://www.w3.org/ns/regorg#legalName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    rdfs:comment "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geregistreerdeorganisatie.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieveNaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: commerciële naam, informele naam, etc."@nl;
    rdfs:comment "Andere naam waaronder de Organisatie bekend is."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geregistreerdeorganisatie.Alternatievenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Andere naam waaronder de Organisatie bekend is."@nl;
    shacl:name "alternatieveNaam"@nl;
    shacl:path skos:altLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechtspersoonlijkheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "Rechtspersoonlijkheid betekent dat men een rechtssubject is, dit wil zeggen drager van rechten en plichten. Natuurlijke personen hebben vanzelf rechtspersoonlijkheid, rechtspersonen (bvb venootschappen) moeten die van rechtswege toegekend krijgen."@nl;
    rdfs:comment "Aard van de rechtspersoonlijkheid."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geregistreerdeorganisatie.Rechtspersoonlijkheid>;
    shacl:class skos:Concept;
    shacl:description "Aard van de rechtspersoonlijkheid."@nl;
    shacl:maxCount "1";
    shacl:name "rechtspersoonlijkheid"@nl;
    shacl:path <https://data.vlaanderen.be/ns/organisatie#rechtspersoonlijkheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechtstoestand"@nl;
    <http://purl.org/vocab/vann/usageNote> "Stemt in de KBO overeen met de rechtstoestand van de Organisatie, bijvoorbeeld normale toestand, gerechtelijk akkoord, opening faillissement etc."@nl;
    rdfs:comment "Status van een GeregistreerdeOrganisatie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geregistreerdeorganisatie.Rechtstoestand>;
    shacl:class skos:Concept;
    shacl:description "Status van een GeregistreerdeOrganisatie."@nl;
    shacl:maxCount "1";
    shacl:name "rechtstoestand"@nl;
    shacl:path <https://data.vlaanderen.be/ns/organisatie#rechtstoestand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rechtsvorm"@nl;
    <http://purl.org/vocab/vann/usageNote> "Stemt in de KBO overeen met rechtsvorm, bvb NV, VZW, Stad/Gemeente, OCMW etc."@nl;
    rdfs:comment "Juridisch statuut van de geregistreerde organisatie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geregistreerdeorganisatie.Rechtsvorm>;
    shacl:class skos:Concept;
    shacl:description "Juridisch statuut van de geregistreerde organisatie."@nl;
    shacl:maxCount "1";
    shacl:name "rechtsvorm"@nl;
    shacl:path <https://data.vlaanderen.be/ns/organisatie#rechtsvorm>
  ], [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    <http://purl.org/vocab/vann/usageNote> "In de KBO is dit het ondernemingsnummer."@nl;
    rdfs:comment "Identificator dat de organisatie verkreeg bij registratie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geregistreerdeorganisatie.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator dat de organisatie verkreeg bij registratie."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "registratie"@nl;
    shacl:path <http://www.w3.org/ns/regorg#registration>
  ], [
    a shacl:PropertyShape;
    rdfs:label "activiteit"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van het attribuut classificatie (naast type & status)."@nl;
    rdfs:comment "Type activiteit die door de Organisatie wordt uitgeoefend."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geregistreerdeorganisatie.Activiteit>;
    shacl:class skos:Concept;
    shacl:description "Type activiteit die door de Organisatie wordt uitgeoefend."@nl;
    shacl:maxCount "1";
    shacl:name "activiteit"@nl;
    shacl:path <http://www.w3.org/ns/regorg#orgActivity>
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geregistreerdeorganisatie.Contactinfo>;
    shacl:class schemas:ContactPoint;
    shacl:description "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren."@nl;
    shacl:name "contactinfo"@nl;
    shacl:path schemas:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van classificatie (naast type & activiteit)."@nl;
    rdfs:comment "Toestand van de Organisatie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geregistreerdeorganisatie.Status>;
    shacl:class skos:Concept;
    shacl:description "Toestand van de Organisatie."@nl;
    shacl:name "status"@nl;
    shacl:path <http://www.w3.org/ns/regorg#orgStatus>
  ], [
    a shacl:PropertyShape;
    rdfs:label "doorhaling";
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geregistreerdeorganisatie.Doorhaling>;
    shacl:class <https://implementatie.data.vlaanderen.be/ns/organisatie#Doorhaling>;
    shacl:name "doorhaling";
    shacl:path prov:wasInvalidatedBy
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftGeregistreerdeVestiging"@nl;
    <http://purl.org/vocab/vann/usageNote> "In België verplicht voor een GeregistreerdeOrganisatie en geregistreerd in de KBO."@nl;
    rdfs:comment "Verwijst naar de wettelijk geregistreerde Vestiging van de Organisatie. Is voor een FormeleOrganisatie doorgaans verplicht."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geregistreerdeorganisatie.Heeftgeregistreerdevestiging>;
    shacl:class org:Site;
    shacl:description "Verwijst naar de wettelijk geregistreerde Vestiging van de Organisatie. Is voor een FormeleOrganisatie doorgaans verplicht."@nl;
    shacl:name "heeftGeregistreerdeVestiging"@nl;
    shacl:path org:hasRegisteredSite
  ], [
    a shacl:PropertyShape;
    rdfs:label "isVeranderdDoor"@nl;
    <http://purl.org/vocab/vann/usageNote> "Als het Veranderingsmoment bijvoorbeeld een Stopzetting is hield de Organisatie daarna op met bestaan. Merk op dat deze relatie zinloos is als het Veranderingsmoment een Oprichting is (de Organisatie bestond nog niet en kan dus niet veranderd zijn ten gevolge van de Oprichting)."@nl;
    rdfs:comment "Verwijst naar het Veranderingsmoment dat deze Organisatie heeft veranderd."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Geregistreerdeorganisatie.Isveranderddoor>;
    shacl:description "Verwijst naar het Veranderingsmoment dat deze Organisatie heeft veranderd."@nl;
    shacl:name "isVeranderdDoor"@nl;
    shacl:or ([shacl:class org:ChangeEvent] [shacl:class <https://data.vlaanderen.be/ns/organisatie#Stopzetting>] [shacl:class <http://data.europa.eu/m8g/FoundationEvent>]);
    shacl:path org:changedBy
  ];
  shacl:targetClass <http://www.w3.org/ns/regorg#RegisteredOrganization> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#IdentificatorShape> a shacl:NodeShape;
  rdfs:label "Identificator"@nl;
  <http://purl.org/vocab/vann/usageNote> "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."@nl;
  rdfs:comment "Informatie gebruikt om een object uniek te identificeren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Type vd string slaat op het identificatiesysteem (incl de versie ervan), de string zelf op de eigenlijke identificator."@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Identificator.Identificator>;
    shacl:description "String gebruikt om het object uniek te identificeren."@nl;
    shacl:maxCount "1";
    shacl:name "identificator"@nl;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekendOp"@nl;
    rdfs:comment "Tijdstip waarop de identificator werd uitgegeven."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Identificator.Toegekendop>;
    shacl:datatype xsd:date;
    shacl:description "Tijdstip waarop de identificator werd uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekendOp"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekendDoor"@nl;
    rdfs:comment "Link naar de agent die de identificator heeft uitgegeven."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Identificator.Toegekenddoor>;
    shacl:class dc:Agent;
    shacl:description "Link naar de agent die de identificator heeft uitgegeven."@nl;
    shacl:maxCount "1";
    shacl:name "toegekendDoor"@nl;
    shacl:path dc:creator
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#LangstringShape> a shacl:NodeShape;
  rdfs:label "LangString";
  shacl:closed false;
  shacl:targetClass rdf:langString .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#MomentShape> a shacl:NodeShape;
  rdfs:label "Moment"@nl;
  rdfs:comment "Moment met omvang en duur nul."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "inXSDdatum"@nl;
    rdfs:comment "Positie in de tijd uitgedrukt door middel van xsd:date."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vkbo/onderneming/v0.0.5#Moment.Inxsddatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Positie in de tijd uitgedrukt door middel van xsd:date."@nl;
    shacl:maxCount "1";
    shacl:name "inXSDdatum"@nl;
