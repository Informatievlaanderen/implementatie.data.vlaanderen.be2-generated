                "type": "string",
                "pattern": "^nl$"
              }
            },
            "required": [
              "@value",
              "@language"
            ]
          },
          "type": {
            "type": "object",
            "description": "Aard van de fout.",
            "properties": {
              "@id": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "@id"
            ]
          }
        },
        "required": [
          "@type",
          "titel",
          "type"
        ]
