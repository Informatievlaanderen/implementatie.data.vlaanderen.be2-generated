      "Probleemdetail": {
        "title": "Probleemdetail",
        "type": "object",
        "description": "Meer gedetailleerde beschrijving van de fout in een HTTP response.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Probleemdetail)",
            "pattern": "^Probleemdetail$"
          },
