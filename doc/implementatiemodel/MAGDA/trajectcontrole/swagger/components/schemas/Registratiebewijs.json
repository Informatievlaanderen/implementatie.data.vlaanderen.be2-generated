{
  "title": "Registratiebewijs",
  "type": "object",
  "description": "Document dat de registratie van een voertuig in het register aangeeft, sinds wanneer, en welk kenteken is toegewezen aan het voertuig.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Registratiebewijs)",
      "pattern": "^Registratiebewijs$"
    },
    "registratiedatum": {
      "type": "object",
      "description": "Datum waarop deze registratie werd uitgevoerd van het voertuig in het register.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "taal": {
      "type": "object",
      "description": "De taal waarin het registratiecertificaat is opgesteld.",
      "properties": {
        "@value": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?"
        },
        "@type": {
          "type": "string",
          "pattern": "^Language$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "modificatiedatum": {
      "type": "object",
      "description": "Datum waarop de gegevens werden bijgewerkt.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "kenteken": {
      "$ref": "#/components/schemas/Identificator"
    }
  },
  "required": [
    "@type",
    "kenteken"
  ]
}