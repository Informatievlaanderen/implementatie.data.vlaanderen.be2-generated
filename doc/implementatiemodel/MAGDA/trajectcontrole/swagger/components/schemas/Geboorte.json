{
  "title": "Geboorte",
  "type": "object",
  "description": "Het ter wereld komen van een Persoon.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Geboorte)",
      "pattern": "^Geboorte$"
    },
    "datum": {
      "type": "object",
      "description": "Datum waarop de gebeurtenis plaatsvond.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    }
  },
  "required": [
    "@type"
  ]
}