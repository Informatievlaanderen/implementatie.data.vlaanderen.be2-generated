<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#AnnotatieShape> a shacl:NodeShape;
  rdfs:label "Annotatie"@nl;
  rdfs:comment "Detailinformatie die meegegeven is bij een Uitzondering."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Annotatie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van het veld."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Annotatie.Naam>;
    shacl:datatype xsd:string;
    shacl:description "Naam van het veld."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "De waarde van het veld."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Annotatie.Waarde>;
    shacl:datatype xsd:string;
    shacl:description "De waarde van het veld."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "waarde"@nl;
    shacl:path rdf:value
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/generiek#Annotatie> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#DateTimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#DateTime>;
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#EnvelopShape> a shacl:NodeShape;
  rdfs:label "envelop"@nl;
  <http://purl.org/vocab/vann/usageNote> "Volg de REST richtlijnen van Digitaal Vlaanderen bij het gebruik van deze klasse binnen VDIP."@nl;
  rdfs:comment "Envelop is het hoofdobject om data uit te wisselen."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Envelop>;
  shacl:closed false;
  shacl:targetClass <http://todo.com/Envelope> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#ErrorShape> a shacl:NodeShape;
  rdfs:label "Error"@nl;
  rdfs:comment "Beschrijving van de fout die is opgetreden."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Error>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "detail"@nl;
    rdfs:comment "Mensleesbare beschrijving van de fout."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Error.Detail>;
    shacl:datatype xsd:string;
    shacl:description "Mensleesbare beschrijving van de fout."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "detail"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "title"@nl;
    rdfs:comment "Korte mensleesbare beschrijving van de fout."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Error.Title>;
    shacl:datatype xsd:string;
    shacl:description "Korte mensleesbare beschrijving van de fout."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "title"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de fout."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Error.Type>;
    shacl:datatype xsd:anyURI;
    shacl:description "Aard van de fout."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass <http://todo.com/Error> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#IntegerShape> a shacl:NodeShape;
  rdfs:label "Integer";
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Integer>;
  shacl:closed false;
  shacl:targetClass xsd:integer .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#ProblemdetailShape> a shacl:NodeShape;
  rdfs:label "Problemdetail"@nl;
  <http://purl.org/vocab/vann/usageNote> "Dit ter aanvulling van een HTTP statuscode, bijvoorbeeld bij een 400 (Bad request) statuscode om aan te geven waarom de request slecht was. Gebaseerd op <a href=\"https://www.rfc-editor.org/rfc/rfc9457\">RFC9457</a>."@nl;
  rdfs:comment "Meer gedetailleerde beschrijving van de fout in een HTTP response."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Problemdetail>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de fout."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Problemdetail.Type>;
    shacl:datatype xsd:anyURI;
    shacl:description "Aard van de fout."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "title"@nl;
    rdfs:comment "Korte mensleesbare beschrijving van de fout."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Problemdetail.Title>;
    shacl:datatype xsd:string;
    shacl:description "Korte mensleesbare beschrijving van de fout."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "title"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    <http://purl.org/vocab/vann/usageNote> "Zoals beschreven in <a href=\"https://www.rfc-editor.org/rfc/rfc7231\">RFC7231</a>. Bijvoorbeeld: 404 voor \"Not Found\"."@nl;
    rdfs:comment "HTTP foutcode."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Problemdetail.Status>;
    shacl:datatype xsd:integer;
    shacl:description "HTTP foutcode."@nl;
    shacl:maxCount 1;
    shacl:name "status"@nl;
    shacl:path <http://www.w3.org/ns/adms#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "detail"@nl;
    rdfs:comment "Mensleesbare beschrijving van de fout."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Problemdetail.Detail>;
    shacl:datatype xsd:string;
    shacl:description "Mensleesbare beschrijving van de fout."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "detail"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "instance"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: de verwijzing naar de request."@nl;
    rdfs:comment "Verwijzing naar de instantie van het object waarop de fout betrekking heeft."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Problemdetail.Instance>;
    shacl:datatype xsd:anyURI;
    shacl:description "Verwijzing naar de instantie van het object waarop de fout betrekking heeft."@nl;
    shacl:maxCount 1;
    shacl:name "instance"@nl;
    shacl:path dc:references
  ], [
    a shacl:PropertyShape;
    rdfs:label "errors"@nl;
    rdfs:comment "Mogelijke validatie-fouten die de aanleiding geven voor het probleem."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Problemdetail.Errors>;
    shacl:class <http://todo.com/Error>;
    shacl:description "Mogelijke validatie-fouten die de aanleiding geven voor het probleem."@nl;
    shacl:name "errors"@nl;
    shacl:path <http://todo.com/errors>
  ];
  shacl:targetClass <http://todo.com/Problemdetail> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#String>;
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#UitzonderingShape> a shacl:NodeShape;
  rdfs:label "Uitzondering"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: nieuwe INSZ nummer bij het Rijksregister."@nl;
  rdfs:comment "Uitzondering geeft miet-kritieke problemen weer bij het uitwisselen."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Uitzondering>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum"@nl;
    rdfs:comment "De datum waarop de Uitzondering aangemaakt werd."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Uitzondering.Datum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum waarop de Uitzondering aangemaakt werd."@nl;
    shacl:maxCount 1;
    shacl:name "datum"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "diagnose"@nl;
    rdfs:comment "Een beschrijving waarom de Uitzondering aangemaakt werd."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Uitzondering.Diagnose>;
    shacl:datatype xsd:string;
    shacl:description "Een beschrijving waarom de Uitzondering aangemaakt werd."@nl;
    shacl:maxCount 1;
    shacl:name "diagnose"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "oorsprong"@nl;
    rdfs:comment "De entiteit die de Uitzondering aangemaakt heeft."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Uitzondering.Oorsprong>;
    shacl:description "De entiteit die de Uitzondering aangemaakt heeft."@nl;
    shacl:maxCount 1;
    shacl:name "oorsprong"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:source
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Het soort Uitzondering."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Uitzondering.Type>;
    shacl:description "Het soort Uitzondering."@nl;
    shacl:maxCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "omstandigheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "De foutcode van de bron die tot de Uitzondering heeft geleid."@nl;
    rdfs:comment "De omstandigheden waarin de Uitzondering werd aangemaakt."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Uitzondering.Omstandigheid>;
    shacl:description "De omstandigheden waarin de Uitzondering werd aangemaakt."@nl;
    shacl:maxCount 1;
    shacl:name "omstandigheid"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:references
  ], [
    a shacl:PropertyShape;
    rdfs:label "annotatie"@nl;
    rdfs:comment "Verwijzing naar annotaties die bij de Uitzondering horen."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Uitzondering.Annotatie>;
    shacl:class <https://implementatie.data.vlaanderen.be/ns/generiek#Annotatie>;
    shacl:description "Verwijzing naar annotaties die bij de Uitzondering horen."@nl;
    shacl:name "annotatie"@nl;
    shacl:path dc:hasPart
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/generiek#Uitzondering> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#UriShape> a shacl:NodeShape;
  rdfs:label "Uri";
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/generiek/v0.2.0#Uri>;
  shacl:closed false;
  shacl:targetClass xsd:anyURI .
