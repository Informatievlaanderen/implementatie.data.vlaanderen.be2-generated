  <http://purl.org/vocab/vann/usageNote> "Kunnen paden zijn, fietspaden, wegen met enkelvoudige of meerevoudige rijbanen en zelfs fictieve trajecten over bijvoorbeeld een verkeersplein."@nl;
  rdfs:comment "Lineair ruimtelijk object dat de geometrie en connectiviteit beschrijft tussen twee punten in een wegennetwerk."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Wegsegment>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "versiedatum"@nl;
    rdfs:comment "Moment waarop de versie van het object is ontstaan."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Wegsegment.Versiedatum>;
    shacl:datatype xsd:date;
    shacl:description "Moment waarop de versie van het object is ontstaan."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "versiedatum"@nl;
    shacl:path dc:created
  ], [
    a shacl:PropertyShape;
    rdfs:label "linkset"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bedoeld voor de nationale of andere Weg of EuropeseWeg waartoe het Wegsegment behoort."@nl;
    rdfs:comment "Linkset waarvan het Wegsegment deel uitmaakt."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Wegsegment.Linkset>;
    shacl:description "Linkset waarvan het Wegsegment deel uitmaakt."@nl;
    shacl:name "linkset"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/netwerk#Linkset>] [shacl:class <https://data.vlaanderen.be/ns/weg#Weg>] [shacl:class <https://data.vlaanderen.be/ns/weg#EuropeseWeg>]);
    shacl:path <https://data.vlaanderen.be/ns/netwerk#linkset>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geometriemiddenlijn"@nl;
