<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#LineaireReferentieShape> a shacl:NodeShape;
  rdfs:label "LineaireReferentie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Meer specifiek het deel twee opeenvolgende posities op de Lijn. Bijvoorbeeld op een Lijn van 500 meter het deel tussen de 100 en 400 meter."@nl;
  rdfs:comment "Linkreferentie die verwijst naar een deel van het lineair netwerkelement."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#LineaireReferentie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "vanPositie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Uitgedrukt in afstand tov het begin van het netwerkelement. Bijvoorbeeld 100meter gerekend vanaf het begin van het netwerkelement. Moet kleiner zijn dan de totPositie en kleiner dan de totale lengte van de Lijn."@nl;
    rdfs:comment "Start van het deel van de Lijn."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#LineaireReferentie.VanPositie>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Start van het deel van de Lijn."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "vanPositie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#vanPositie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "totPositie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Uitgedrukt in afstand tov het begin van het netwerkelement. Bijvoorbeeld 400 meter gerekend vanaf het begin van het netwerkelement. Moet groter zijn dan de vanPositie en kleiner dan de totale lengte van de Lijn."@nl;
    rdfs:comment "Einde van het deel van de Lijn."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#LineaireReferentie.TotPositie>;
    shacl:class schemas:QuantitativeValue;
    shacl:description "Einde van het deel van de Lijn."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "totPositie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#totPositie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#LineaireReferentie> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#LinkShape> a shacl:NodeShape;
  rdfs:label "Link"@nl;
  rdfs:comment "Curvilineair netwerkelement dat twee posities verbindt en een homogeen pad in het Netwerk vertegenwoordigt. De verbonden posities worden voorgesteld door Knopen."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Link>;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Link> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#LinkreferentieShape> a shacl:NodeShape;
  rdfs:label "Linkreferentie"@nl;
  rdfs:comment "Netwerkreferentie die verwijst naar een lineair netwerkelement."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Linkreferentie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "toepassingsrichting"@nl;
    <http://purl.org/vocab/vann/usageNote> "Onder richting wordt de digitalisatierichting van de Link verstaan ten opzichte van waarvan het fenomeen op of langs de weg wordt beschouwd. Loopt het fenomeen mee met de digitalisatierichting dan is de richting \"meelopend\", in tegenzin is het \"tegengesteld\". Dit kan zowel longitudonaal als transversaal bekeken worden: longitudonaal in de richting van de link (met waarden heen en terug) maar ook transversaal of dwars op de Link. In het tweede geval betekent meelopend de rechterkant van de Link en tegengesteld de linkerkant. In dit model beperken we de waarden per default tot links en rechts (bijvoorbeeld voor de linker- en rechterstraatnaam) en is heen en terug voorbehouden voor specifieke gevallen (bijvoorbeeld autoverkeer heen en terug)."@nl;
    rdfs:comment "Richting van de link waarop de referentie van toepassing is."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Linkreferentie.Toepassingsrichting>;
    shacl:description "Richting van de link waarop de referentie van toepassing is."@nl;
    shacl:maxCount 1;
    shacl:name "toepassingsrichting"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#toepassingsRichting>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Linkreferentie>,
    <https://data.vlaanderen.be/ns/netwerk#LineaireReferentie> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#LinksetShape> a shacl:NodeShape;
  rdfs:label "Linkset"@nl;
