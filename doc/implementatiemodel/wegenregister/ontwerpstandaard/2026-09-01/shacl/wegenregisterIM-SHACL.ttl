    shacl:description "De toegekende morfologische wegklasse."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "morfologie"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/weg#MorfologischeWegklasse> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#NetwerkShape> a shacl:NodeShape;
  rdfs:label "Netwerk"@nl;
  <http://purl.org/vocab/vann/usageNote> "De reden waarom de Netwerkelementen bij elkaar gebracht worden in een Netwerk kan verschillen, bijvoorbeeld omdat ze geschikt zijn voor een bepaald type vervoermiddel."@nl;
  rdfs:comment "Verzameling van Netwerkelementen."@nl;
