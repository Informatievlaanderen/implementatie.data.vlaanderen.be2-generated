    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "versiedatum"@nl;
    shacl:path dc:created
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Soort GelijkgrondseKruising."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#OngelijkgrondseKruising.Type>;
    shacl:description "Soort GelijkgrondseKruising."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc11:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Identificator van het Netwerkelement."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#OngelijkgrondseKruising.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het Netwerkelement."@nl;
    shacl:maxCount 1;
    shacl:name "identificator"@nl;
    shacl:path <ttp://www.w3.org/ns/adms#Identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "kruisingVan"@nl;
    <http://purl.org/vocab/vann/usageNote> "De set van kruisend Links is geordend met de laagst gelegen Link eerst."@nl;
    rdfs:comment "Links die ongelijkgronds kruisen."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#OngelijkgrondseKruising.KruisingVan>;
    shacl:class <https://data.vlaanderen.be/ns/weg#Wegsegment>;
    shacl:description "Links die ongelijkgronds kruisen."@nl;
    shacl:minCount 2;
    shacl:name "kruisingVan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#kruisingVan>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#OngelijkgrondseKruising> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een organisatie heeft dikwijls een hiërarchische structuur."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Organisatie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    rdfs:comment "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Organisatie.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount 1;
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ];
  shacl:targetClass org:Organization .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, het is te zeggen met eigen rechtspersoonlijkheid) van de menselijke soort, dus een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bijvoorbeeld ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Persoon>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "achternaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."@nl;
    rdfs:comment "Gedeelte van de volledige naam van de persoon ontvangen van de vorige generatie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Persoon.Achternaam>;
    shacl:datatype xsd:string;
    shacl:description "Gedeelte van de volledige naam van de persoon ontvangen van de vorige generatie."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "achternaam"@nl;
    shacl:path foaf:familyName
  ], [
    a shacl:PropertyShape;
    rdfs:label "voornaam"@nl;
