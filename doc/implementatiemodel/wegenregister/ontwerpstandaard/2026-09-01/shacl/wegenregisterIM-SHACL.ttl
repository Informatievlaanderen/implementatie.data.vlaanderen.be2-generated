<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#NetwerkeigenschapShape> a shacl:NodeShape;
  rdfs:label "Netwerkeigenschap"@nl;
  <http://purl.org/vocab/vann/usageNote> "Laat toe om een netwerkeigenschap aan een netwerkelement te koppelen, bijvoorbeeld om aan te geven op welk wegsegment een snelheidsbeperking van toepassing is of langs welke wegsegmenten een fietspad ligt."@nl;
  rdfs:comment "Verwijzing naar een netwerkelement."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Netwerkeigenschap>;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Netwerkeigenschap> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#NetwerkelementShape> a shacl:NodeShape;
  rdfs:label "Netwerkelement"@nl;
  rdfs:comment "Element in een Netwerk dat daarin een functie van belang vervult."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Netwerkelement>;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Netwerkelement> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#NetwerkreferentieShape> a shacl:NodeShape;
  rdfs:label "Netwerkreferentie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Laat toe om een Netwerkeigenschap aan een Netwerkelement te koppelen, bijvoorbeeld om aan te geven op welk wegsegment een snelheidsbeperking van toepassing is of langs welke wegsegmenten een fietspad ligt."@nl;
  rdfs:comment "Verwijzing naar een Netwerkelement."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Netwerkreferentie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "eigenschap"@nl;
    rdfs:comment "Verwijzing naar de Netwerkeigenschap die aan een Netwerkelement is gekoppeld."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Netwerkreferentie.Eigenschap>;
    shacl:description "Verwijzing naar de Netwerkeigenschap die aan een Netwerkelement is gekoppeld."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "eigenschap"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/netwerk#Netwerkeigenschap>] [shacl:class <https://data.vlaanderen.be/ns/transportnetwerk#Transporteigenschap>] [shacl:class <https://data.vlaanderen.be/ns/adres#Straatnaam>] [shacl:class <https://data.vlaanderen.be/ns/transportnetwerk#Toegang>] [shacl:class <https://data.vlaanderen.be/ns/transportnetwerk#Beheerder>] [shacl:class <https://data.vlaanderen.be/ns/transportnetwerk#RichtingVerkeer>] [shacl:class <https://data.vlaanderen.be/ns/transportnetwerk#Toestand>] [shacl:class <https://data.vlaanderen.be/ns/weg#Wegcategorie>] [shacl:class <https://data.vlaanderen.be/ns/weg#MorfologischeWegklasse>] [shacl:class <https://data.vlaanderen.be/ns/weg#Wegverharding>]);
    shacl:path <https://data.vlaanderen.be/ns/netwerk#eigenschap>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Netwerkreferentie>,
    <https://data.vlaanderen.be/ns/netwerk#Linkreferentie>,
    <https://data.vlaanderen.be/ns/netwerk#LineaireReferentie> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#OngelijkgrondseKruisingShape> a shacl:NodeShape;
  rdfs:label "OngelijkgrondseKruising"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te gebruiken wanneer de hoogtecoördinaten ontbreken of niet betrouwbaar zijn."@nl;
  rdfs:comment "Kruising van twee of meer Wegsegmenten waarbij het ene hoger of lager is gelegen dan het andere."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#OngelijkgrondseKruising>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "versiedatum"@nl;
    rdfs:comment "Moment waarop de versie van het object is ontstaan."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#OngelijkgrondseKruising.Versiedatum>;
    shacl:datatype xsd:date;
