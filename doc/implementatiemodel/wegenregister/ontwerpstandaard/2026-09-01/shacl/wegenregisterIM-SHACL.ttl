<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Agent>;
  shacl:closed false;
  shacl:targetClass dc:Agent,
    <http://www.w3.org/ns/person#Person>,
    org:Organization .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#BeheerderShape> a shacl:NodeShape;
  rdfs:label "Beheerder"@nl;
  rdfs:comment "Agent verantwoordelijk voor het beheer van het Transportobject."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Beheerder>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "autoriteit"@nl;
    rdfs:comment "Verwijzing naar de Agent."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Beheerder.Autoriteit>;
    shacl:description "Verwijzing naar de Agent."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "autoriteit"@nl;
    shacl:or ([shacl:class dc:Agent] [shacl:class <http://www.w3.org/ns/person#Person>] [shacl:class org:Organization]);
    shacl:path <https://data.vlaanderen.be/ns/transportnetwerk#Beheerder.autoriteit>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/transportnetwerk#Beheerder> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#ConnectieShape> a shacl:NodeShape;
  rdfs:label "Connectie"@nl;
  rdfs:comment "Logische verbinding tussen twee of meer Netwerkelementen in verschillende Netwerken."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Connectie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de Connectie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Connectie.Type>;
    shacl:description "Aard van de Connectie."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/netwerk#Connectie> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#CurveShape> a shacl:NodeShape;
  rdfs:label "Curve"@nl;
  <http://purl.org/vocab/vann/usageNote> "Dimensie is te verstaan in wiskundige zin: het minimum aantal coördinaten nodig om een willekeurig punt voor te stellen dat deel uitmaakt van de primitieve. In het coördinaatsysteem dat door een Curve zelf gevormd wordt volstaat 1 coördinaat om een punt op de Curve te lokaliseren, bijvoorbeeld de afstand langs de Curve vanaf het vertrekpunt. Een Curve heeft een lengte maar geen breedte of hoogte, wat niet wegneemt dat ze door de 3D ruimte kan kronkelen. Curves worden doorgaans voorgesteld door polylijnen, dit zijn sets van opeenvolgende punten waarbij de tussenliggende punten van de Curve bekomen worden door middel van interpolatie. Als de interpolatiemethode lineair is krijg je een Lijnstring (een hoekige lijn die de opeenvolgende punten verbindt middels een rechte lijn), andere manieren om te interpoleren resulteren in circulaire bogen, cubic splines, Bézier curves etc (waarbij de controlepunten niet noodzakelijk op de Curve liggen). Een Curve wordt begrensd door zijn begin- en eindpunt."@nl;
  rdfs:comment "Een 1-dimensionele geometrische primitieve."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Curve>;
  shacl:closed false;
  shacl:targetClass <http://www.opengis.net/ont/sf#Curve> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#DateShape> a shacl:NodeShape;
  rdfs:label "Date";
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Date>;
  shacl:closed false;
  shacl:targetClass xsd:date .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#EenheidShape> a shacl:NodeShape;
  rdfs:label "Eenheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te gebruiken in plaats van Concept als een voorgedefinieerde eenheid van QUDT beschikbaar is, bijvoorbeeld <a href=\"http://qudt.org/vocab/unit/M\">meter</a>. Zie <a href=\"https://www.qudt.org/doc/DOC_VOCAB-UNITS.html\">QUDT-units</a> voor meer info."@nl;
  rdfs:comment "Maat waarin een hoeveelheid van een bepaalde grootheid wordt uitgedrukt."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#Eenheid>;
  shacl:closed false;
  shacl:targetClass <http://qudt.org/schema/qudt/Unit> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#EuropeseWegShape> a shacl:NodeShape;
  rdfs:label "EuropeseWeg"@nl;
  rdfs:comment "Een verzameling Wegsegmenten of  Weglinksequenties die een route vertegenwoordigt die deel uitmaakt van het internationale E-wegennetwerk, gekenmerkt door het Europese wegummer."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#EuropeseWeg>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "versiedatum"@nl;
    rdfs:comment "Moment waarop de versie van het object is ontstaan."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#EuropeseWeg.Versiedatum>;
    shacl:datatype xsd:date;
    shacl:description "Moment waarop de versie van het object is ontstaan."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "versiedatum"@nl;
    shacl:path dc:created
  ], [
    a shacl:PropertyShape;
    rdfs:label "europeesWegnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> """De code begint altijd met een
letter 'E', gevolgd door een één-, twee- of driecijferig
nummer."""@nl;
    rdfs:comment "Code die de route in het internationale E-wegennetwerk identificeert."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#EuropeseWeg.EuropeesWegnummer>;
    shacl:datatype xsd:string;
    shacl:description "Code die de route in het internationale E-wegennetwerk identificeert."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "europeesWegnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/weg#europeesWegnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Identificator van het Netwerkelement."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#EuropeseWeg.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het Netwerkelement."@nl;
    shacl:maxCount 1;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#Identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "link"@nl;
    rdfs:comment "Link die deel uitmaakt van de Linkset."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#EuropeseWeg.Link>;
    shacl:description "Link die deel uitmaakt van de Linkset."@nl;
    shacl:minCount 1;
    shacl:name "link"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/netwerk#GeneriekeLink>] [shacl:class <https://data.vlaanderen.be/ns/weg#Wegsegment>]);
    shacl:path <https://data.vlaanderen.be/ns/netwerk#link>
  ], [
    a shacl:PropertyShape;
    rdfs:label "referentie"@nl;
    rdfs:comment "Netwerkreferentie waarnaar het Netwerkelement verwijst."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#EuropeseWeg.Referentie>;
    shacl:description "Netwerkreferentie waarnaar het Netwerkelement verwijst."@nl;
    shacl:name "referentie"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/netwerk#Netwerkreferentie>] [shacl:class <https://data.vlaanderen.be/ns/netwerk#Linkreferentie>] [shacl:class <https://data.vlaanderen.be/ns/netwerk#LineaireReferentie>]);
    shacl:path <https://data.vlaanderen.be/ns/netwerk#referentie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/weg#EuropeseWeg> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/wegenregister/ontwerpstandaard/2026-09-01#GelijkgrondseKruisingShape> a shacl:NodeShape;
  rdfs:label "GelijkgrondseKruising"@nl;
