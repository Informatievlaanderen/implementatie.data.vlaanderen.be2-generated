      "CloudEvent.id": {
        "title": "CloudEvent.id",
        "description": "Identificator van het event om deze uniek te onderscheiden van andere events samen met de source. Herpublicatie van een duplicaat mag dezelfde source en id gebruiken, de waarde zelf is niet een globale unieke event IRI.",
        "type": "string"
      },
      "CloudEvent.source": {
        "title": "CloudEvent.source",
        "description": "Identificieert de context waarin het event gebeurd. Een absolute IRI is aangeraden maar niet verplicht.",
        "type": "string",
        "format": "uri"
      },
      "CloudEvent.specversion": {
        "title": "CloudEvent.specversion",
        "description": "De versie van de CloudEvents specificatie dat het event volgt. Voor CloudEvents core 1.0.2 is de waarde '1.0' en niet '1.0.2'.",
        "type": "string"
      },
      "CloudEvent.type": {
        "title": "CloudEvent.type",
        "description": "Soort event benaming gekozen door de dataproducent. Reverse-DNS prefixes zijn aangeraden. Dit is geen rdf:type omdat een CloudEvents type string niet automatisch een RDF klasse aangeeft.",
        "type": "string"
      },
      "CloudEvent.datacontenttype": {
        "title": "CloudEvent.datacontenttype",
        "description": "Mediatype van de inhoud van het event in het attribuut 'data' volgens RFC 2046. Bijvoorbeeld: application/json.",
        "type": "string"
      },
      "CloudEvent.dataschema": {
        "title": "CloudEvent.dataschema",
        "description": "Het schema dat de inhoud van het event volgt. Voorgesteld als een IRI zodat het schema steeds opgehaald kan worden. Het schema is geen equivalent van een RDF klasse of SHACL shape.",
        "type": "string",
        "format": "uri"
      },
      "CloudEvent.subject": {
        "title": "CloudEvent.subject",
        "description": "Identificatie van het onderwerp van het event binnen de context van de source. Dit is niet altijd een URI en mag dus niet zomaar gebruikt worden als dcterms:subject of een RDF resource zonder mapping.",
        "type": "string"
      },
      "CloudEvent.time": {
        "title": "CloudEvent.time",
        "description": "Tijdstip waarop het event gebeurde. Tijdstip van het event op het terrein, niet het tijdstip waarop het event was aangemaakt of afgeleverd in de data.",
        "type": "string",
        "format": "date-time"
      },
      "CloudEvent.data": {
        "title": "CloudEvent.data",
        "description": "Inhoud van het event. Beschouwd als een abstracte klasse omdat de inhoud alles kan zijn, beschreven door datacontenttype.",
