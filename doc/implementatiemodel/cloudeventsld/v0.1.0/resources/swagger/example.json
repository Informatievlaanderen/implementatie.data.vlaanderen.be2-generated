  "components": {
    "schemas": {
      "Problemdetail": {
        "title": "Problemdetail",
        "type": "object",
        "description": "Meer gedetailleerde beschrijving van de fout in een HTTP response.",
        "properties": {
          "type": {
            "type": "string",
