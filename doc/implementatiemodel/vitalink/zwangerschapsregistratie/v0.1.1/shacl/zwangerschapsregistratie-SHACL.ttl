  shacl:targetClass rdf:langString .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#MedischeObservatieShape> a shacl:NodeShape;
  rdfs:label "Medische Observatie"@nl;
  rdfs:comment "Metingen en eenvoudige beweringen over een patiënt, apparaat of ander onderwerp."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#MedischeObservatie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "effectief tijdstip"@nl;
    rdfs:comment "De tijd of tijdsperiode waarin de waargenomen waarde als waar wordt beschouwd."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#MedischeObservatie.EffectiefTijdstip>;
    shacl:datatype xsd:dateTime;
    shacl:description "De tijd of tijdsperiode waarin de waargenomen waarde als waar wordt beschouwd."@nl;
    shacl:maxCount 1;
    shacl:name "effectief tijdstip"@nl;
    shacl:path <https://hl7.org/fhir/observation-definitions.html#Observation.effective>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bij implementatie in RDF is de uri vh object de identificator."@nl;
    rdfs:comment "Identificator van het object."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#MedischeObservatie.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het object."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitvoerder"@nl;
    rdfs:comment "Wie was verantwoordelijk voor het vaststellen van de waargenomen waarde als \"waar\"?"@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#MedischeObservatie.Uitvoerder>;
    shacl:description "Wie was verantwoordelijk voor het vaststellen van de waargenomen waarde als \"waar\"?"@nl;
    shacl:maxCount 1;
    shacl:name "uitvoerder"@nl;
    shacl:or ([shacl:class dc:Agent] [shacl:class <http://www.w3.org/ns/person#Person>] [shacl:class org:Organization] [shacl:class <https://hl7.org/fhir/practitioner-definitions.html#Practitioner>]);
    shacl:path <https://hl7.org/fhir/observation-definitions.html#Observation.performer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vastgesteld"@nl;
    rdfs:comment "De Gezondheidstoestand wordt vastgesteld aan de hand van een Medische Observatie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#MedischeObservatie.Vastgesteld>;
    shacl:class <https://data.vlaanderen.be/ns/gezondheidstoestand#Zwangerschapstoestand>;
    shacl:description "De Gezondheidstoestand wordt vastgesteld aan de hand van een Medische Observatie."@nl;
    shacl:name "vastgesteld"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand#vastgesteld>
  ];
  shacl:targetClass <https://build.fhir.org/observation-definitions.html#Observation> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een Organisatie heeft dikwijls een hiërarchische structuur."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Organisatie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    rdfs:comment "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Organisatie.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ];
  shacl:targetClass org:Organization .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#PeriodeShape> a shacl:NodeShape;
  rdfs:label "Periode"@nl;
  <http://purl.org/vocab/vann/usageNote> "Typisch volgt de duur uit het opgeven ve begin- en eindtijdstip."@nl;
  rdfs:comment "Min of meer afgebakende tijdsduur."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Periode>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "begin"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Aanvang van de tijdsduur."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Periode.Begin>;
    shacl:description "Aanvang van de tijdsduur."@nl;
    shacl:maxCount 1;
    shacl:name "begin"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://data.europa.eu/m8g/startTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "einde"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Einde vd tijdsduur."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Periode.Einde>;
    shacl:description "Einde vd tijdsduur."@nl;
    shacl:maxCount 1;
    shacl:name "einde"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://data.europa.eu/m8g/endTime>
  ];
  shacl:targetClass <http://data.europa.eu/m8g/PeriodOfTime> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Persoon>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "familienaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."@nl;
    rdfs:comment "Gedeelte van de volledige naam vd persoon ontvangen van de vorige generatie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Persoon.Familienaam>;
    shacl:datatype xsd:string;
    shacl:description "Gedeelte van de volledige naam vd persoon ontvangen van de vorige generatie."@nl;
    shacl:maxCount 1;
    shacl:name "familienaam"@nl;
    shacl:path foaf:familyName
  ], [
    a shacl:PropertyShape;
    rdfs:label "gegeven naam"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam die een kind bij geboorte wordt gegeven. Onderscheidt het kind van de andere kinderen in de familie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Persoon.GegevenNaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam die een kind bij geboorte wordt gegeven. Onderscheidt het kind van de andere kinderen in de familie."@nl;
    shacl:minCount 1;
    shacl:name "gegeven naam"@nl;
    shacl:path foaf:givenName
  ], [
    a shacl:PropertyShape;
    rdfs:label "isLidVan"@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Persoon.IsLidVan>;
    shacl:class org:Organization;
    shacl:name "isLidVan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#isLidVan>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft zwangerschap"@nl;
    rdfs:comment "Een Persoon heeft een Zwangerschap"@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Persoon.HeeftZwangerschap>;
    shacl:class <https://data.vlaanderen.be/ns/gezondheidstoestand#Zwangerschap>;
    shacl:description "Een Persoon heeft een Zwangerschap"@nl;
    shacl:name "heeft zwangerschap"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand#Persoon.heeftZwangerschap>
  ];
  shacl:targetClass <http://www.w3.org/ns/person#Person> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#String>;
