<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#ZorgverlenerShape> a shacl:NodeShape;
  rdfs:label "Zorgverlener"@nl;
  rdfs:comment "Een persoon met een formele verantwoordelijkheid bij het verlenen van gezondheidszorg of aanverwante diensten."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Zorgverlener>;
  shacl:closed false;
  shacl:targetClass <https://hl7.org/fhir/practitioner-definitions.html#Practitioner> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#ZwangerschapShape> a shacl:NodeShape;
  rdfs:label "Zwangerschap"@nl;
  rdfs:comment "De staat waarin een Persoon een of meerdere embryo’s of foetussen draagt in de baarmoeder, wat leidt tot de ontwikkeling van een nieuw natuurlijk Persoon."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Zwangerschap>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bij implementatie in RDF is de uri vh object de identificator."@nl;
    rdfs:comment "Identificator van het object."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Zwangerschap.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het object."@nl;
    shacl:minCount 1;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toestand";
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Zwangerschap.Toestand>;
    shacl:class <https://data.vlaanderen.be/ns/gezondheidstoestand#Zwangerschapstoestand>;
    shacl:maxCount 1;
    shacl:name "toestand";
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand#Zwangerschap.toestand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft foetus"@nl;
    rdfs:comment "Een Zwangerschap heeft een of meerdere Foetussen."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Zwangerschap.HeeftFoetus>;
    shacl:class <https://data.vlaanderen.be/ns/gezondheidstoestand#Foetus>;
    shacl:description "Een Zwangerschap heeft een of meerdere Foetussen."@nl;
    shacl:name "heeft foetus"@nl;
