<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Agent>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bij implementatie in RDF is de uri vh object de identificator."@nl;
    rdfs:comment "Identificator van het object."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Agent.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het object."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ];
  shacl:targetClass <http://www.w3.org/ns/person#Person>,
    dc:Agent,
    org:Organization,
    <https://hl7.org/fhir/practitioner-definitions.html#Practitioner> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#DateTimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#DateTime>;
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#FoetusShape> a shacl:NodeShape;
  rdfs:label "Foetus"@nl;
  rdfs:comment "De ongeboren Persoon vanaf de achtste week van de Zwangerschap tot aan de Geboorte."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Foetus>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "deel van"@nl;
    rdfs:comment "Een Foetus is deel van de Zwangerschap."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Foetus.DeelVan>;
    shacl:class <https://data.vlaanderen.be/ns/gezondheidstoestand#Zwangerschap>;
    shacl:description "Een Foetus is deel van de Zwangerschap."@nl;
    shacl:maxCount 1;
    shacl:name "deel van"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand#deelVan>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/gezondheidstoestand#Foetus> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#IdentificatorShape> a shacl:NodeShape;
  rdfs:label "Identificator"@nl;
  <http://purl.org/vocab/vann/usageNote> "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."@nl;
  rdfs:comment "Informatie gebruikt om een object uniek te identificeren."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Identificator>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Type vd string slaat op het identificatiesysteem (incl de versie ervan), de string zelf op de eigenlijke identificator."@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Identificator.Identificator>;
    shacl:description "String gebruikt om het object uniek te identificeren."@nl;
    shacl:maxCount 1;
    shacl:name "identificator"@nl;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekendDoor";
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Identificator.ToegekendDoor>;
    shacl:maxCount 1;
    shacl:name "toegekendDoor";
    shacl:or ([shacl:class dc:Agent] [shacl:class <http://www.w3.org/ns/person#Person>] [shacl:class org:Organization] [shacl:class <https://hl7.org/fhir/practitioner-definitions.html#Practitioner>]);
    shacl:path <https://data.vlaanderen.be/ns/generiek#toegekendDoor>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door (String)"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "Naam vd agent die de identificator heeft toegekend."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#Identificator.ToegekendDoor(String)>;
    shacl:description "Naam vd agent die de identificator heeft toegekend."@nl;
    shacl:maxCount 1;
    shacl:name "toegekend door (String)"@nl;
    shacl:or ([shacl:class dc:Agent] [shacl:class <http://www.w3.org/ns/person#Person>] [shacl:class org:Organization] [shacl:class <https://hl7.org/fhir/practitioner-definitions.html#Practitioner>]);
    shacl:path <http://www.w3.org/ns/adms#schemaAgency>
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#LangStringShape> a shacl:NodeShape;
  rdfs:label "LangString";
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.1#LangString>;
