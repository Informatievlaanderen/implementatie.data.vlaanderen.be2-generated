<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  rdfs:comment "Iemand die of iets dat kan handelen of een effect kan teweeg brengen."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Agent>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bij implementatie in RDF is de uri van het object de identificator."@nl;
    rdfs:comment "Identificator van het object."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Agent.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het object."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ];
  shacl:targetClass <http://www.w3.org/ns/person#Person>,
    dc:Agent,
    org:Organization,
    <https://hl7.org/fhir/practitioner-definitions.html#Practitioner> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#DateTimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#DateTime>;
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#FoetusShape> a shacl:NodeShape;
  rdfs:label "Foetus"@nl;
  rdfs:comment "De ongeboren Persoon vanaf de achtste week van de Zwangerschap tot aan de Geboorte."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Foetus>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "deel van"@nl;
    rdfs:comment "Een Foetus is deel van de Zwangerschap."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Foetus.DeelVan>;
    shacl:class <https://data.vlaanderen.be/ns/gezondheidstoestand#Zwangerschap>;
    shacl:description "Een Foetus is deel van de Zwangerschap."@nl;
    shacl:maxCount 1;
    shacl:name "deel van"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand#deelVan>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/gezondheidstoestand#Foetus> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#IdentificatorShape> a shacl:NodeShape;
  rdfs:label "Identificator"@nl;
  <http://purl.org/vocab/vann/usageNote> "Uitgangspunt hier is dat deze string door een organisatie wordt toegekend en dat dit gebeurt volgens een welbepaald systeem."@nl;
  rdfs:comment "Informatie gebruikt om een object uniek te identificeren."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Identificator>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Type van de string slaat op het identificatiesysteem (inclusief de versie ervan), de string zelf op de eigenlijke identificator."@nl;
    rdfs:comment "String gebruikt om het object uniek te identificeren."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Identificator.Identificator>;
    shacl:description "String gebruikt om het object uniek te identificeren."@nl;
    shacl:maxCount 1;
    shacl:name "identificator"@nl;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door"@nl;
    rdfs:comment "Link naar de agent die de identificator heeft uitgegeven."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Identificator.ToegekendDoor>;
    shacl:description "Link naar de agent die de identificator heeft uitgegeven."@nl;
    shacl:maxCount 1;
    shacl:name "toegekend door"@nl;
    shacl:or ([shacl:class dc:Agent] [shacl:class <http://www.w3.org/ns/person#Person>] [shacl:class org:Organization] [shacl:class <https://hl7.org/fhir/practitioner-definitions.html#Practitioner>]);
    shacl:path dc:creator
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekend door string"@nl;
    rdfs:comment "Naam van de agent die de identificator heeft toegekend."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Identificator.ToegekendDoorString>;
    shacl:description "Naam van de agent die de identificator heeft toegekend."@nl;
    shacl:maxCount 1;
    shacl:name "toegekend door string"@nl;
    shacl:or ([shacl:class dc:Agent] [shacl:class <http://www.w3.org/ns/person#Person>] [shacl:class org:Organization] [shacl:class <https://hl7.org/fhir/practitioner-definitions.html#Practitioner>]);
    shacl:path <http://www.w3.org/ns/adms#schemaAgency>
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#LangStringShape> a shacl:NodeShape;
  rdfs:label "LangString";
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#LangString>;
  shacl:closed false;
  shacl:targetClass rdf:langString .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#MedischeObservatieShape> a shacl:NodeShape;
  rdfs:label "Medische Observatie"@nl;
  rdfs:comment "Metingen en eenvoudige beweringen over een patiënt, apparaat of ander onderwerp."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#MedischeObservatie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "effectief tijdstip"@nl;
    rdfs:comment "De tijd of tijdsperiode waarin de waargenomen waarde als waar wordt beschouwd."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#MedischeObservatie.EffectiefTijdstip>;
    shacl:datatype xsd:dateTime;
    shacl:description "De tijd of tijdsperiode waarin de waargenomen waarde als waar wordt beschouwd."@nl;
    shacl:maxCount 1;
    shacl:name "effectief tijdstip"@nl;
    shacl:path <https://hl7.org/fhir/observation-definitions.html#Observation.effective>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bij implementatie in RDF is de uri van het object de identificator."@nl;
    rdfs:comment "Identificator van het object."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#MedischeObservatie.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het object."@nl;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitvoerder"@nl;
    rdfs:comment "De Agent die verantwoordelijk was voor het vaststellen van de waargenomen waarde als \"waar\"."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#MedischeObservatie.Uitvoerder>;
    shacl:description "De Agent die verantwoordelijk was voor het vaststellen van de waargenomen waarde als \"waar\"."@nl;
    shacl:maxCount 1;
    shacl:name "uitvoerder"@nl;
    shacl:or ([shacl:class dc:Agent] [shacl:class <http://www.w3.org/ns/person#Person>] [shacl:class org:Organization] [shacl:class <https://hl7.org/fhir/practitioner-definitions.html#Practitioner>]);
    shacl:path <https://hl7.org/fhir/observation-definitions.html#Observation.performer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vastgesteld"@nl;
    rdfs:comment "De Gezondheidstoestand wordt vastgesteld aan de hand van een Medische Observatie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#MedischeObservatie.Vastgesteld>;
    shacl:class <https://data.vlaanderen.be/ns/gezondheidstoestand#Zwangerschapstoestand>;
    shacl:description "De Gezondheidstoestand wordt vastgesteld aan de hand van een Medische Observatie."@nl;
    shacl:name "vastgesteld"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand#vastgesteld>
  ];
  shacl:targetClass <https://build.fhir.org/observation-definitions.html#Observation> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#OrganisatieShape> a shacl:NodeShape;
  rdfs:label "Organisatie"@nl;
  rdfs:comment "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een Organisatie heeft dikwijls een hiërarchische structuur."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Organisatie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    rdfs:comment "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Organisatie.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ];
  shacl:targetClass org:Organization .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#PeriodeShape> a shacl:NodeShape;
  rdfs:label "Periode"@nl;
  <http://purl.org/vocab/vann/usageNote> "Typisch volgt de duur uit het opgeven van een begin- en eindtijdstip."@nl;
  rdfs:comment "Min of meer afgebakende tijdsduur."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Periode>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "begin"@nl;
    rdfs:comment "Aanvang van de tijdsduur."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Periode.Begin>;
    shacl:description "Aanvang van de tijdsduur."@nl;
    shacl:maxCount 1;
    shacl:name "begin"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://data.europa.eu/m8g/startTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "einde"@nl;
    rdfs:comment "Einde van de tijdsduur."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Periode.Einde>;
    shacl:description "Einde van de tijdsduur."@nl;
    shacl:maxCount 1;
    shacl:name "einde"@nl;
    shacl:nodeKind shacl:Literal;
    shacl:path <http://data.europa.eu/m8g/endTime>
  ];
  shacl:targetClass <http://data.europa.eu/m8g/PeriodOfTime> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, het is te zeggen met eigen rechtspersoonlijkheid) van de menselijke soort, het is te zeggen een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bijvoorbeeld ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Persoon>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "familienaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."@nl;
    rdfs:comment "Gedeelte van de volledige naam van de persoon ontvangen van de vorige generatie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Persoon.Familienaam>;
    shacl:datatype xsd:string;
    shacl:description "Gedeelte van de volledige naam van de persoon ontvangen van de vorige generatie."@nl;
    shacl:maxCount 1;
    shacl:name "familienaam"@nl;
    shacl:path foaf:familyName
  ], [
    a shacl:PropertyShape;
    rdfs:label "gegeven naam"@nl;
    rdfs:comment "Naam die een kind bij geboorte wordt gegeven. Onderscheidt het kind van de andere kinderen in de familie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Persoon.GegevenNaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam die een kind bij geboorte wordt gegeven. Onderscheidt het kind van de andere kinderen in de familie."@nl;
    shacl:minCount 1;
    shacl:name "gegeven naam"@nl;
    shacl:path foaf:givenName
  ], [
    a shacl:PropertyShape;
    rdfs:label "is lid van"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dekt elk type aansluiting of betrokkenheid van een agent bij een organisatie, niet enkel formeel lidmaatschap. Kan eventueel verder gespecialiseerd worden."@nl;
    rdfs:comment "Niet nader bepaald lidmaatschap van een agent van een organisatie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Persoon.IsLidVan>;
    shacl:class org:Organization;
    shacl:description "Niet nader bepaald lidmaatschap van een agent van een organisatie."@nl;
    shacl:name "is lid van"@nl;
    shacl:path org:memberOf
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft zwangerschap"@nl;
    rdfs:comment "Een Persoon heeft een Zwangerschap."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Persoon.HeeftZwangerschap>;
    shacl:class <https://data.vlaanderen.be/ns/gezondheidstoestand#Zwangerschap>;
    shacl:description "Een Persoon heeft een Zwangerschap."@nl;
    shacl:name "heeft zwangerschap"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand#Persoon.heeftZwangerschap>
  ];
  shacl:targetClass <http://www.w3.org/ns/person#Person> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#String>;
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#ZorgverlenerShape> a shacl:NodeShape;
  rdfs:label "Zorgverlener"@nl;
  rdfs:comment "Een persoon met een formele verantwoordelijkheid bij het verlenen van gezondheidszorg of aanverwante diensten."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Zorgverlener>;
  shacl:closed false;
  shacl:targetClass <https://hl7.org/fhir/practitioner-definitions.html#Practitioner> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#ZwangerschapShape> a shacl:NodeShape;
  rdfs:label "Zwangerschap"@nl;
  rdfs:comment "De staat waarin een Persoon een of meerdere embryo’s of foetussen draagt in de baarmoeder, wat leidt tot de ontwikkeling van een nieuw natuurlijk Persoon."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Zwangerschap>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bij implementatie in RDF is de uri van het object de identificator."@nl;
    rdfs:comment "Identificator van het object."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Zwangerschap.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van het object."@nl;
    shacl:minCount 1;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toestand"@nl;
    rdfs:comment "De toestand die bij de Zwangerschap hoort."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/vitalink/zwangerschapsregistratie/v0.1.4#Zwangerschap.Toestand>;
    shacl:class <https://data.vlaanderen.be/ns/gezondheidstoestand#Zwangerschapstoestand>;
    shacl:description "De toestand die bij de Zwangerschap hoort."@nl;
    shacl:maxCount 1;
    shacl:name "toestand"@nl;
    shacl:path <https://data.vlaanderen.be/ns/gezondheidstoestand#Zwangerschap.toestand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft foetus"@nl;
