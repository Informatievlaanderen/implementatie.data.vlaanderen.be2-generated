{
  "title": "Persoon",
  "type": "object",
  "description": "Natuurlijk persoon.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Persoon)",
      "pattern": "^Persoon$"
    },
    "isOverleden": {
      "$ref": "#/components/schemas/Persoon.isOverleden"
    },
    "voornaam": {
      "type": "array",
      "description": "Naam die een Persoon bij geboorte wordt gegeven. Onderscheidt de Persoon van de andere personen in de familie. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Persoon.voornaam"
      },
      "minItems": 1
    },
    "alternatieveNaam": {
      "type": "array",
      "description": "Alternatief voor de volledige naam van de Persoon. Bijvoorbeeld pseudoniem. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Persoon.alternatieveNaam"
      },
      "minItems": 1
    },
    "achternaam": {
      "$ref": "#/components/schemas/Persoon.achternaam"
    },
    "contactinfo": {
      "$ref": "#/components/schemas/Contactpunt"
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    }
  },
  "required": [
    "@type",
    "identificator"
  ]
}