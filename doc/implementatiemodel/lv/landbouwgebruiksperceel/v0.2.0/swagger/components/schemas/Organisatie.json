{
  "title": "Organisatie",
  "type": "object",
  "description": "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een Organisatie heeft dikwijls een hiërarchische structuur.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Organisatie)",
      "pattern": "^Organisatie$"
    },
    "voorkeursnaam": {
      "$ref": "#/components/schemas/Organisatie.voorkeursnaam"
    },
    "type": {
      "type": "array",
      "description": "Soort organisatie. Specialisatie van classificatie (naast activiteit & status). Lijst van OrganisatieType items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/OrganisatieType"
          },
          {
            "$ref": "#/components/schemas/Rechtspersoonlijkheidtype"
          },
          {
            "$ref": "#/components/schemas/Rechtsvormtype"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "OrganisatieType": "#/components/schemas/OrganisatieType",
            "Rechtspersoonlijkheidtype": "#/components/schemas/Rechtspersoonlijkheidtype",
            "Rechtsvormtype": "#/components/schemas/Rechtsvormtype"
          }
        }
      },
      "minItems": 1
    },
    "contactinfo": {
      "type": "array",
      "description": "Informatie zoals email, telefoon... die toelaat de Organisatie te contacteren. Lijst van Contactpunt items.",
      "items": {
        "$ref": "#/components/schemas/Contactpunt"
      },
      "minItems": 1
    },
    "activiteit": {
      "type": "array",
      "description": "Type activiteit die door de Organisatie wordt uitgeoefend. Lijst van Activiteittype items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Activiteittype"
          },
          {
            "$ref": "#/components/schemas/LandbouwActiviteit"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Activiteittype": "#/components/schemas/Activiteittype",
            "LandbouwActiviteit": "#/components/schemas/LandbouwActiviteit"
          }
        }
      },
      "minItems": 1
    },
    "lid": {
      "type": "array",
      "description": "Agent die lid is van een Organisatie. Lijst van Persoon items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Persoon"
          },
          {
            "$ref": "#/components/schemas/GeregistreerdPersoon"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Persoon": "#/components/schemas/Persoon",
            "GeregistreerdPersoon": "#/components/schemas/GeregistreerdPersoon"
          }
        }
      },
      "minItems": 1
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    }
  },
  "required": [
    "@type",
    "identificator"
  ]
}