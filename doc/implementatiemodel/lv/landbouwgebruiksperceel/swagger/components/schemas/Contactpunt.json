{
  "title": "Contactpunt",
  "type": "object",
  "description": "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Contactpunt)",
      "pattern": "^Contactpunt$"
    },
    "email": {
      "type": "object",
      "description": "Email-adres waarnaar men kan mailen.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "telefoon": {
      "type": "array",
      "description": "Lijst van Literal items.",
      "items": {
        "type": "object",
        "description": "Telefoonnummer waarop men kan bellen.",
        "properties": {
          "@value": {
            "type": "string"
          },
          "@type": {
            "type": "string"
          }
        },
        "required": [
          "@value",
          "@type"
        ]
      },
      "minItems": 1
    },
    "adres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    }
  },
  "required": [
    "@type"
  ]
}