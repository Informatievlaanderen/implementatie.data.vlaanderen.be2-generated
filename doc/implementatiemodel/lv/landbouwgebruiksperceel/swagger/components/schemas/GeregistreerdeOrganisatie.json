{
  "title": "GeregistreerdeOrganisatie",
  "type": "object",
  "description": "Organisatie met een juridisch statuut vastgelegd door registratie. Vergelijk met een FormeleOrganisatie waarbij dit statuut ook op een andere manier verkregen kan zijn.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse GeregistreerdeOrganisatie)",
      "pattern": "^GeregistreerdeOrganisatie$"
    },
    "rechtstoestand": {
      "$ref": "#/components/schemas/OrganisatieStatus"
    },
    "rechtspersoonlijkheid": {
      "$ref": "#/components/schemas/Rechtspersoonlijkheidtype"
    },
    "registratie": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "rechtsvorm": {
      "$ref": "#/components/schemas/Rechtsvormtype"
    },
    "voorkeursnaam": {
      "type": "object",
      "description": "Naam waarmee de Organisatie bij voorkeur wordt aangeduid.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "type": {
      "type": "array",
      "description": "Lijst van OrganisatieType items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/OrganisatieType"
          },
          {
            "$ref": "#/components/schemas/Rechtspersoonlijkheidtype"
          },
          {
            "$ref": "#/components/schemas/Rechtsvormtype"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "OrganisatieType": "#/components/schemas/OrganisatieType",
            "Rechtspersoonlijkheidtype": "#/components/schemas/Rechtspersoonlijkheidtype",
            "Rechtsvormtype": "#/components/schemas/Rechtsvormtype"
          }
        }
      },
      "minItems": 1
    },
    "contactinfo": {
      "type": "array",
      "description": "Lijst van Contactpunt items.",
      "items": {
        "$ref": "#/components/schemas/Contactpunt"
      },
      "minItems": 1
    },
    "status": {
      "type": "array",
      "description": "Lijst van OrganisatieStatus items.",
      "items": {
        "$ref": "#/components/schemas/OrganisatieStatus"
      },
      "minItems": 1
    },
    "activiteit": {
      "type": "array",
      "description": "Lijst van Activiteittype items.",
      "items": {
        "$ref": "#/components/schemas/Activiteittype"
      },
      "minItems": 1
    },
    "isGeassocieerdMet": {
      "type": "array",
      "description": "Lijst van Organisatie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Organisatie"
          },
          {
            "$ref": "#/components/schemas/GeregistreerdeOrganisatie"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Organisatie": "#/components/schemas/Organisatie",
            "GeregistreerdeOrganisatie": "#/components/schemas/GeregistreerdeOrganisatie"
          }
        }
      },
      "minItems": 1
    },
    "lid": {
      "type": "array",
      "description": "Lijst van Persoon items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Persoon"
          },
          {
            "$ref": "#/components/schemas/GeregistreerdPersoon"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Persoon": "#/components/schemas/Persoon",
            "GeregistreerdPersoon": "#/components/schemas/GeregistreerdPersoon"
          }
        }
      },
      "minItems": 1
    },
    "identificator": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "registratie",
    "voorkeursnaam"
  ]
}