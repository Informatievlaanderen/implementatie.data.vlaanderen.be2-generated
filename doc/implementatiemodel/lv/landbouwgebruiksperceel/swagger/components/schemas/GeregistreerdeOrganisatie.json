{
  "title": "GeregistreerdeOrganisatie",
  "type": "object",
  "description": "Organisatie met een juridisch statuut vastgelegd door registratie. Vergelijk met een FormeleOrganisatie waarbij dit statuut ook op een andere manier verkregen kan zijn.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse GeregistreerdeOrganisatie)",
      "pattern": "^GeregistreerdeOrganisatie$"
    },
    "status": {
      "type": "array",
      "description": "Toestand van de Organisatie. Specialisatie van classificatie (naast type & activiteit). Lijst van OrganisatieStatus items.",
      "items": {
        "$ref": "#/components/schemas/OrganisatieStatus"
      },
      "minItems": 1
    },
    "rechtspersoonlijkheid": {
      "$ref": "#/components/schemas/Rechtspersoonlijkheidtype"
    },
    "registratie": {
      "$ref": "#/components/schemas/Identificator"
    },
    "rechtsvorm": {
      "$ref": "#/components/schemas/Rechtsvormtype"
    },
    "voorkeursnaam": {
      "$ref": "#/components/schemas/GeregistreerdeOrganisatie.voorkeursnaam"
    },
    "type": {
      "type": "array",
      "description": "Soort organisatie. Specialisatie van classificatie (naast activiteit & status). Lijst van OrganisatieType items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/OrganisatieType"
          },
          {
            "$ref": "#/components/schemas/Rechtspersoonlijkheidtype"
          },
          {
            "$ref": "#/components/schemas/Rechtsvormtype"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "OrganisatieType": "#/components/schemas/OrganisatieType",
            "Rechtspersoonlijkheidtype": "#/components/schemas/Rechtspersoonlijkheidtype",
            "Rechtsvormtype": "#/components/schemas/Rechtsvormtype"
          }
        }
      },
      "minItems": 1
    },
    "contactinfo": {
      "$ref": "#/components/schemas/Contactinfo"
    },
    "activiteit": {
      "type": "array",
      "description": "Type activiteit die door de Organisatie wordt uitgeoefend. Lijst van LandbouwActiviteit items.",
      "items": {
        "$ref": "#/components/schemas/LandbouwActiviteit"
      },
      "minItems": 1
    },
    "lid": {
      "type": "array",
      "description": "Agent die lid is van een Organisatie. Lijst van Persoon items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Persoon"
          },
          {
            "$ref": "#/components/schemas/GeregistreerdPersoon"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Persoon": "#/components/schemas/Persoon",
            "GeregistreerdPersoon": "#/components/schemas/GeregistreerdPersoon"
          }
        }
      },
      "minItems": 1
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    }
  },
  "required": [
    "@type",
    "registratie"
  ]
}