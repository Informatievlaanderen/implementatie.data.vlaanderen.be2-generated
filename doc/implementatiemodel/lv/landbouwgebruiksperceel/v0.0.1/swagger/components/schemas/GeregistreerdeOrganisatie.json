{
  "title": "GeregistreerdeOrganisatie",
  "type": "object",
  "description": "Organisatie met een juridisch statuut vastgelegd door registratie. Vergelijk met een FormeleOrganisatie waarbij dit statuut ook op een andere manier verkregen kan zijn.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse GeregistreerdeOrganisatie)",
      "pattern": "^GeregistreerdeOrganisatie$"
    },
    "rechtspersoonlijkheid": {
      "$ref": "#/components/schemas/Rechtspersoonlijkheidtype-V1"
    },
    "registratie": {
      "type": "array",
      "description": "Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "rechtsvorm": {
      "$ref": "#/components/schemas/Rechtsvormtype-V1"
    },
    "voorkeursnaam": {
      "type": "object",
      "description": "Naam waarmee de Organisatie bij voorkeur wordt aangeduid.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "contactinfo": {
      "type": "array",
      "description": "Lijst van Contactpunt items.",
      "items": {
        "$ref": "#/components/schemas/Contactpunt"
      },
      "minItems": 1
    },
    "status": {
      "$ref": "#/components/schemas/OrganisatieStatus"
    },
    "activiteit": {
      "type": "array",
      "description": "Lijst van Activiteittype items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Activiteittype"
          },
          {
            "$ref": "#/components/schemas/LandbouwActiviteit-V1"
          },
          {
            "$ref": "#/components/schemas/Activiteittype"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Activiteittype": "#/components/schemas/Activiteittype",
            "LandbouwActiviteit-V1": "#/components/schemas/LandbouwActiviteit-V1"
          }
        }
      },
      "minItems": 1
    },
    "identificator": {
      "$ref": "#/components/schemas/Identificator"
    },
    "exploitatie": {
      "type": "array",
      "description": "Lijst van Exploitatie items.",
      "items": {
        "$ref": "#/components/schemas/Exploitatie"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "registratie",
    "voorkeursnaam",
    "status",
    "identificator"
  ]
}