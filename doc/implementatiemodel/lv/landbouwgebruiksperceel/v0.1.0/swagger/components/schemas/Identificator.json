{
  "title": "Identificator",
  "type": "object",
  "description": "Informatie gebruikt om een object uniek te identificeren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Identificator)",
      "pattern": "^Identificator$"
    },
    "identificator": {
      "type": "object",
      "description": "String gebruikt om het object uniek te identificeren. Type van de string slaat op het identificatiesysteem (inclusief de versie ervan), de string zelf op de eigenlijke identificator.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@type": {
          "type": "string"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "toegekendDoor": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Organisatie"
        },
        {
          "$ref": "#/components/schemas/Persoon"
        },
        {
          "$ref": "#/components/schemas/GeregistreerdPersoon"
        },
        {
          "$ref": "#/components/schemas/GeregistreerdeOrganisatie"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Organisatie": "#/components/schemas/Organisatie",
          "Persoon": "#/components/schemas/Persoon",
          "GeregistreerdPersoon": "#/components/schemas/GeregistreerdPersoon",
          "GeregistreerdeOrganisatie": "#/components/schemas/GeregistreerdeOrganisatie"
        }
      }
    }
  },
  "required": [
    "@type"
  ]
}