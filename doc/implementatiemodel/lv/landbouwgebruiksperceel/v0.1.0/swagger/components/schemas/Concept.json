{
  "title": "Concept",
  "type": "object",
  "description": "Concept is een idee of code.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Concept)",
      "pattern": "^Concept$"
    },
    "code": {
      "type": "object",
      "description": "De waarde van de code van het Concept.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "voorkeursnaam": {
      "type": "object",
      "description": "De naam van het Concept.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    }
  },
  "required": [
    "@type",
    "code"
  ]
}