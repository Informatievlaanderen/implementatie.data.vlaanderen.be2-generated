  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Overlijden> .

<https://implementatie.data.vlaanderen.be/doc/implementatiemodel/lv/landbouwgebruiksperceel/v0.1.0#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, het is te zeggen met eigen rechtspersoonlijkheid) van de menselijke soort, het is te zeggen een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bijvoorbeeld ook schulden hebben, contracten afsluiten, aangeklaagd worden, etc.)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voornaam"@nl;
    rdfs:comment "Naam die een Persoon bij geboorte wordt gegeven. Onderscheidt de Persoon van de andere personen in de familie."@nl;
    rdfs:seeAlso <https://implementatie.data.vlaanderen.be/doc/implementatiemodel/lv/landbouwgebruiksperceel/v0.1.0#Persoon.Voornaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam die een Persoon bij geboorte wordt gegeven. Onderscheidt de Persoon van de andere personen in de familie."@nl;
    shacl:name "voornaam"@nl;
    shacl:path foaf:givenName
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieveNaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld pseudoniem."@nl;
    rdfs:comment "Alternatief voor de volledige naam van de Persoon."@nl;
    rdfs:seeAlso <https://implementatie.data.vlaanderen.be/doc/implementatiemodel/lv/landbouwgebruiksperceel/v0.1.0#Persoon.AlternatieveNaam>;
    shacl:datatype xsd:string;
    shacl:description "Alternatief voor de volledige naam van de Persoon."@nl;
    shacl:name "alternatieveNaam"@nl;
    shacl:path dc:alternative
  ], [
    a shacl:PropertyShape;
    rdfs:label "achternaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."@nl;
    rdfs:comment "Gedeelte van de volledige naam van de Persoon ontvangen van de vorige generatie."@nl;
    rdfs:seeAlso <https://implementatie.data.vlaanderen.be/doc/implementatiemodel/lv/landbouwgebruiksperceel/v0.1.0#Persoon.Achternaam>;
    shacl:datatype xsd:string;
    shacl:description "Gedeelte van de volledige naam van de Persoon ontvangen van de vorige generatie."@nl;
    shacl:maxCount 1;
    shacl:name "achternaam"@nl;
    shacl:path foaf:familyName
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon, ... die toelaat de Persoon te contacteren."@nl;
    rdfs:seeAlso <https://implementatie.data.vlaanderen.be/doc/implementatiemodel/lv/landbouwgebruiksperceel/v0.1.0#Persoon.Contactinfo>;
    shacl:class schemas:ContactPoint;
    shacl:description "Informatie zoals email, telefoon, ... die toelaat de Persoon te contacteren."@nl;
    shacl:maxCount 1;
    shacl:name "contactinfo"@nl;
    shacl:path schemas:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftOverlijden"@nl;
    rdfs:comment "Verwijst naar de overlijdensgebeurtenis van de Persoon."@nl;
    rdfs:seeAlso <https://implementatie.data.vlaanderen.be/doc/implementatiemodel/lv/landbouwgebruiksperceel/v0.1.0#Persoon.HeeftOverlijden>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Overlijden>;
    shacl:description "Verwijst naar de overlijdensgebeurtenis van de Persoon."@nl;
    shacl:maxCount 1;
    shacl:name "heeftOverlijden"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#heeftOverlijden>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isLidVan"@nl;
    rdfs:comment "Niet nader bepaald lidmaatschap van een Agent van een Organisatie."@nl;
    rdfs:seeAlso <https://implementatie.data.vlaanderen.be/doc/implementatiemodel/lv/landbouwgebruiksperceel/v0.1.0#Persoon.IsLidVan>;
    shacl:description "Niet nader bepaald lidmaatschap van een Agent van een Organisatie."@nl;
    shacl:name "isLidVan"@nl;
    shacl:or ([shacl:class org:Organization] [shacl:class <http://www.w3.org/ns/regorg#RegisteredOrganization>]);
    shacl:path org:memberOf
  ];
  shacl:targetClass <http://www.w3.org/ns/person#Person>,
    <https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon> .

<https://implementatie.data.vlaanderen.be/doc/implementatiemodel/lv/landbouwgebruiksperceel/v0.1.0#StringShape> a shacl:NodeShape;
