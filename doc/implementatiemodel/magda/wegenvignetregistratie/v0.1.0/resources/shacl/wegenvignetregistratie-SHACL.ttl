<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#WegenvignetregistratieShape> a shacl:NodeShape;
  rdfs:label "Wegenvignetregistratie"@nl;
  <http://purl.org/vocab/vann/usageNote> "Verwijst naar de Registratie van het Voertuig in het nationale register."@nl;
