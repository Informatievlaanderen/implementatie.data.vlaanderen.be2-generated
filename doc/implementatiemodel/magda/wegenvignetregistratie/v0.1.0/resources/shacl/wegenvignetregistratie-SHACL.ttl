<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#VoertuigShape> a shacl:NodeShape;
  rdfs:label "Voertuig"@nl;
  rdfs:comment "Een voertuig is een apparaat dat ontworpen of gebruikt is om mensen of vracht te vervoeren over land, water, lucht, of door de ruimte."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Voertuig>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "eersteRegistratieDatum"@nl;
    rdfs:comment "Eerste datum waarop het voertuig werd geregistreerd in een register."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Voertuig.EersteRegistratieDatum>;
    shacl:datatype xsd:date;
    shacl:description "Eerste datum waarop het voertuig werd geregistreerd in een register."@nl;
    shacl:maxCount 1;
    shacl:name "eersteRegistratieDatum"@nl;
    shacl:path schemas:dateVehicleFirstRegistered
  ], [
    a shacl:PropertyShape;
    rdfs:label "emissienorm"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: Euro 6d. De waarde komt uit een codelijst, zodat ook andere of toekomstige emissienormen dan de Euronorm uitgedrukt kunnen worden."@nl;
    rdfs:comment "De emissienorm waaraan het Voertuig voldoet."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Voertuig.Emissienorm>;
    shacl:description "De emissienorm waaraan het Voertuig voldoet."@nl;
    shacl:maxCount 1;
    shacl:name "emissienorm"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path schemas:meetsEmissionStandard
  ], [
    a shacl:PropertyShape;
    rdfs:label "vin"@nl;
    rdfs:comment "Het Vehicle Identification Number (VIN) is een unieke serienummer die toegepast is in de autoindustrie om individuele voertuigen van elkaar te onderscheiden."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Voertuig.Vin>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Het Vehicle Identification Number (VIN) is een unieke serienummer die toegepast is in de autoindustrie om individuele voertuigen van elkaar te onderscheiden."@nl;
    shacl:maxCount 1;
    shacl:name "vin"@nl;
    shacl:path schemas:vehicleIdentificationNumber
  ], [
    a shacl:PropertyShape;
    rdfs:label "voertuigMotor"@nl;
    rdfs:comment "De motor of motoren van het Voertuig."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Voertuig.VoertuigMotor>;
    shacl:class schemas:EngineSpecification;
    shacl:description "De motor of motoren van het Voertuig."@nl;
    shacl:name "voertuigMotor"@nl;
    shacl:path schemas:vehicleEngine
  ];
  shacl:targetClass schemas:Vehicle .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#WegenvignetRegistratieEnvelopShape> a shacl:NodeShape;
