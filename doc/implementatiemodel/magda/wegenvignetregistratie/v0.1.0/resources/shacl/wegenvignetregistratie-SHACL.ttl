<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#UitzonderingShape> a shacl:NodeShape;
  rdfs:label "Uitzondering"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: nieuwe INSZ nummer bij het Rijksregister."@nl;
  rdfs:comment "Uitzondering geeft niet-kritieke problemen weer bij het uitwisselen."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Uitzondering>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum"@nl;
    rdfs:comment "De datum waarop de Uitzondering aangemaakt werd."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Uitzondering.Datum>;
    shacl:datatype xsd:dateTime;
    shacl:description "De datum waarop de Uitzondering aangemaakt werd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "datum"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "diagnose"@nl;
    rdfs:comment "Een beschrijving waarom de Uitzondering aangemaakt werd."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Uitzondering.Diagnose>;
    shacl:datatype xsd:string;
    shacl:description "Een beschrijving waarom de Uitzondering aangemaakt werd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "diagnose"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "oorsprong"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bedoeld om kennis te organiseren, Bijvoorbeeld: in een codelijst of taxonomie (een zgn ConceptScheme). Zie <a href=\"https://www.w3.org/TR/skos-reference/\">SKOS</a> voor meer informatie."@nl;
    rdfs:comment "De entiteit die de Uitzondering aangemaakt heeft."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Uitzondering.Oorsprong>;
    shacl:description "De entiteit die de Uitzondering aangemaakt heeft."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "oorsprong"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:source
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Het soort Uitzondering."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Uitzondering.Type>;
    shacl:description "Het soort Uitzondering."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "omstandigheid"@nl;
    <http://purl.org/vocab/vann/usageNote> "De foutcode van de bron die tot de Uitzondering heeft geleid."@nl;
    rdfs:comment "De omstandigheden waarin de Uitzondering werd aangemaakt."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Uitzondering.Omstandigheid>;
    shacl:description "De omstandigheden waarin de Uitzondering werd aangemaakt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "omstandigheid"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:references
  ], [
    a shacl:PropertyShape;
    rdfs:label "annotatie"@nl;
    rdfs:comment "Verwijzing naar annotaties die bij de Uitzondering horen."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Uitzondering.Annotatie>;
    shacl:class <https://implementatie.data.vlaanderen.be/ns/generiek#Annotatie>;
    shacl:description "Verwijzing naar annotaties die bij de Uitzondering horen."@nl;
    shacl:name "annotatie"@nl;
    shacl:path dc:hasPart
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/generiek#Uitzondering> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#UriShape> a shacl:NodeShape;
