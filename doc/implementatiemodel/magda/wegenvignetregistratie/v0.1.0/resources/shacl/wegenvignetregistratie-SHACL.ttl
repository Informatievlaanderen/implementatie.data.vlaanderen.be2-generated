    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#Annotatie.Waarde>;
    shacl:datatype xsd:string;
    shacl:description "De waarde van het veld."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
