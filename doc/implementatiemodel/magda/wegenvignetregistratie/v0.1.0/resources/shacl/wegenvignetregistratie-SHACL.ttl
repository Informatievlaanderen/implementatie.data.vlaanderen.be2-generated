    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/wegenvignetregistratie/v0.1.0#WegenvignetRegistratieEnvelop.Warning>;
    shacl:class <https://implementatie.data.vlaanderen.be/ns/generiek#Uitzondering>;
    shacl:description "Foutmeldingen die opgetreden zijn bij het afleveren van de data."@nl;
    shacl:name "warning"@nl;
    shacl:path schemas:error
  ];
