@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.

<https://data.vlaanderen.be/id/conceptscheme/Brandstoftype> a skos:ConceptScheme;
    skos:prefLabel "Codelijst Brandstoftypes"@nl;
    skos:definition "Codelijst van mogelijke types brandstof voor een voertuig, zonder elektriciteit en zonder combinaties van brandstoffen."@nl;
    skos:notation "Brandstoftype".
<https://data.vlaanderen.be/id/concept/Brandstoftype/10> a skos:Concept;
    skos:prefLabel "Benzine"@nl;
    skos:definition "Vloeibare brandstof op basis van aardolie voor motoren met vonkontsteking."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:notation "10".
<https://data.vlaanderen.be/id/concept/Brandstoftype/15> a skos:Concept;
    skos:prefLabel "Ethanol"@nl;
    skos:definition "Alcoholbrandstof, doorgaans van plantaardige oorsprong (bio-ethanol), voor motoren met vonkontsteking."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:notation "15".
<https://data.vlaanderen.be/id/concept/Brandstoftype/19> a skos:Concept;
    skos:prefLabel "Mengsmering"@nl;
    skos:definition "Mengsel van benzine en smeerolie voor tweetaktmotoren."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:notation "19".
<https://data.vlaanderen.be/id/concept/Brandstoftype/20> a skos:Concept;
    skos:prefLabel "Diesel"@nl;
    skos:definition "Vloeibare brandstof op basis van aardolie (gasolie) voor motoren met compressieontsteking."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:notation "20".
<https://data.vlaanderen.be/id/concept/Brandstoftype/21> a skos:Concept;
    skos:prefLabel "Biodiesel"@nl;
    skos:definition "Dieselbrandstof van plantaardige of dierlijke oorsprong voor motoren met compressieontsteking."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:notation "21".
<https://data.vlaanderen.be/id/concept/Brandstoftype/30> a skos:Concept;
    skos:prefLabel "LPG"@nl;
    skos:definition "Vloeibaar gemaakt petroleumgas (liquefied petroleum gas), een mengsel van hoofdzakelijk propaan en butaan."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:notation "30".
<https://data.vlaanderen.be/id/concept/Brandstoftype/40> a skos:Concept;
    skos:prefLabel "CNG"@nl;
    skos:definition "Samengeperst aardgas (compressed natural gas)."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:notation "40".
<https://data.vlaanderen.be/id/concept/Brandstoftype/50> a skos:Concept;
    skos:prefLabel "Waterstof"@nl;
    skos:definition "Waterstofgas, gebruikt in een brandstofcel of in een verbrandingsmotor."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:notation "50".
<https://data.vlaanderen.be/id/concept/Brandstoftype/60> a skos:Concept;
    skos:prefLabel "LNG"@nl;
    skos:definition "Vloeibaar gemaakt aardgas (liquefied natural gas)."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:notation "60".
<https://data.vlaanderen.be/id/concept/Brandstoftype/90> a skos:Concept;
    skos:prefLabel "Andere"@nl;
    skos:definition "Brandstof die niet onder een van de andere codes valt."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/Brandstoftype>;
    skos:notation "90".
