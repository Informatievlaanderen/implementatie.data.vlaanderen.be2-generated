<https://data.vlaanderen.be/id/conceptscheme/Euronorm> a skos:ConceptScheme;
    skos:prefLabel "Codelijst Euronormen"@nl;
    skos:definition "Codelijst van Europese emissienormen (euronormen) en verwante emissieklassen waaraan een voertuig kan voldoen."@nl;
    skos:notation "Euronorm".
