@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.

<https://data.vlaanderen.be/id/conceptscheme/Motortype> a skos:ConceptScheme;
    skos:prefLabel "Codelijst Motortypes"@nl;
    skos:definition "Codelijst van mogelijke types motor waarmee een voertuig wordt aangedreven."@nl;
    skos:notation "Motortype".
<https://data.vlaanderen.be/id/concept/Motortype/verbrandingsmotor> a skos:Concept;
    skos:prefLabel "Verbrandingsmotor"@nl;
    skos:definition "Motor die brandstof verbrandt om mechanische energie op te wekken."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/Motortype>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/Motortype>;
    skos:notation "verbrandingsmotor".
<https://data.vlaanderen.be/id/concept/Motortype/elektromotor> a skos:Concept;
    skos:prefLabel "Elektromotor"@nl;
    skos:definition "Motor die elektrische energie omzet in mechanische energie. De elektriciteit komt uit een batterij of uit een brandstofcel."@nl;
    skos:inScheme <https://data.vlaanderen.be/id/conceptscheme/Motortype>;
    skos:topConceptOf <https://data.vlaanderen.be/id/conceptscheme/Motortype>;
    skos:notation "elektromotor".
