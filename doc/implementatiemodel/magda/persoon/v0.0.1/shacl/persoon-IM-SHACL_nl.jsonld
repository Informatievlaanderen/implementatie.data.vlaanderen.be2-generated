  {
    "@id": "https://implementatie.data.vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.1#AfstammingShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "De afstamming kan ook niet-biologisch zijn, bijvoorbeeld adoptie. Afstamming kan ook in opgaande lijn worden bekeken. Het begrip is enger dan verwantschap dat onder andere ook Huwelijk inhoudt."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Afstamming is de dalende lijn van bloedverwantschap tussen verschillende generaties."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Afstamming"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
