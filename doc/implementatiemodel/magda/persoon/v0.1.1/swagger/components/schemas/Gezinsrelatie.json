{
  "title": "Gezinsrelatie",
  "type": "object",
  "description": "Relatie tussen leden van eenzelfde gezin.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Gezinsrelatie)",
      "pattern": "^Gezinsrelatie$"
    },
    "gezinsrelatietype": {
      "$ref": "#/components/schemas/Gezinsrelatietype"
    },
    "metPersoon": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Persoon"
        },
        {
          "$ref": "#/components/schemas/GeregistreerdPersoon"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Persoon": "#/components/schemas/Persoon",
          "GeregistreerdPersoon": "#/components/schemas/GeregistreerdPersoon"
        }
      }
    }
  },
  "required": [
    "@type",
    "metPersoon"
  ]
}