<https://w3id.org/dpv#FullAutomation> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#AutomationLevel> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Full Automation"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Level of automation corresponding to Level 5 in ISO/IEC 22989:2022 where the automation in system is capable of performing all its tasks regardless of the conditions without human involvement"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#AutomationLevel> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Though Fully Automated such operations can still be associated with dpv:HumanInvolved e.g. for inputs, oversight or verification"@en ;
  <http://purl.org/dc/terms/source> _:bae43fdb35e5b17467c6072924c18cebb ;
  <http://purl.org/dc/terms/created> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-04-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#RiskConcept> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Concept"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Parent concept for combining concepts associated with risk assessment such as actual and potential Risk, Risk Source, Consequences, and Impacts"@en ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "RiskConcept is a generic concept used for creation of specific taxonomies in the RISK extension to provide guidance on how a concept can potentially be a risk, risk source, consequence, and impact. It is not intended to be used directly and is only created for organisation of concepts in DPV vocabularies"@en ;
  <http://purl.org/dc/terms/created> "2024-08-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-delaram-golpayegani, _:person-rob-brennan, _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#risk-classes> .

<https://w3id.org/dpv#ConsentRefused> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ConsentStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Refused"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "The state where consent has been refused"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ConsentStatusInvalidForProcessing> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "An example of this state is when the individual clicks on a 'disagree' or 'reject' or 'refuse' button, or leaves a checkbox unticked"@en ;
  <http://purl.org/dc/terms/source> _:b81862437284348cec0143b34a90c27af ;
  <http://purl.org/dc/terms/created> "2022-06-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-paul-ryan, _:person-julian-flake ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#consent-status-classes> .

<https://w3id.org/dpv#PermissionNotUtilised> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#RuleFulfilmentStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Permission Not Utilised"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status indicating a permission has not been utilised i.e. the activity stated as being permitted has not been carried out"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#RuleFulfilled> ;
  <http://purl.org/dc/terms/created> "2024-09-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#rules-classes> .

<https://w3id.org/dpv#Guideline> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Guideline"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Practices that specify how activities must be conducted"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#GuidelinesPrinciple> ;
