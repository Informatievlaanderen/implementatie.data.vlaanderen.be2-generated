<https://w3id.org/dpv#IndeterminateDuration> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Duration> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Indeterminate Duration"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Duration that is indeterminate or cannot be determined"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Duration> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Indeterminate means (exact or otherwise) information about the duration cannot be determined, which is distinct from 'EndlessDuration' where it is known (or decided) that the duration is open-ended or without an end."@en ;
  <http://purl.org/dc/terms/created> "2022-11-30"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#context-classes> .

<https://w3id.org/dpv#ExpectationStatus> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Expectation Status"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status indicating whether the specified context was intended or unintended"@en ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Expectation is associated with the outcome of a goal or purpose for what is expected to happen i.e. an ex-post indication of what was expected to happen in the specified context. Intention and Expectation are closely related terms. We recommend using Intention when the entity has the ability to control the implementation and Expectation for when the entity does not have control or for what happens after or beyond the exercise of control."@en ;
  <http://purl.org/dc/terms/created> "2024-05-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani, _:person-georg-p-krog, _:person-paul-ryan ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#status-classes> .

<https://w3id.org/dpv#ImproveInternalCRMProcesses> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Improve Internal CRM Processes"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with improving customer-relationship management (CRM) processes"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#OptimisationForController>, <https://w3id.org/dpv#CustomerRelationshipManagement> ;
  <http://purl.org/dc/terms/created> "2019-04-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-javier-fernandez, _:person-axel-polleres, _:person-elmar-kiesling, _:person-fajar-ekaputra, _:person-simon-steyskal ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-classes> .

<https://w3id.org/dpv#LegalBasis> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Legal Basis"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Legal basis used to justify processing of data or use of technology in accordance with a law"@en ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Legal basis (plural: legal bases) are defined by legislations and regulations, whose applicability is usually restricted to specific jurisdictions which can be represented using dpv:hasJurisdiction or dpv:hasLaw. Legal basis can be used without such declarations, e.g. 'Consent', however their interpretation will require association with a law, e.g. 'EU GDPR'."@en ;
  <http://purl.org/dc/terms/created> "2019-04-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2020-11-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0014> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#legal-basis-classes> .

<https://w3id.org/dpv#ComplianceMonitoring> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Compliance Monitoring"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Monitoring of compliance (e.g. internal policy, regulations)"@en ;
