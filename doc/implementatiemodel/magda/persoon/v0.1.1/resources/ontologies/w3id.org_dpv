<https://w3id.org/dpv#RecordsOfActivities> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Records of Activities"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Records of activities within some context such as maintenance tasks or governance functions"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Records can be any information associated with the activity e.g. logs, summaries."@en ;
  <http://purl.org/dc/terms/created> "2021-09-08"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-05-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
