  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#rules-classes> .

<https://w3id.org/dpv#AmbulanceProvider> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Ambulance Provider"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An organisation that that offers transportation and medical care to patients requiring urgent medical attention"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#EmergencyServiceProvider> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#EmergencyServiceProvider> ;
  <http://purl.org/dc/terms/created> "2024-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-delaram-golpayegani ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-organisation-classes> .

<https://w3id.org/dpv#Pseudonymisation> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Pseudonymisation"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Pseudonymisation means the processing of personal data in such a manner that the personal data can no longer be attributed to a specific data subject without the use of additional information, provided that such additional information is kept separately and is subject to technical and organisational measures to ensure that the personal data are not attributed to an identified or identifiable natural person;"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Deidentification> ;
  <http://purl.org/dc/terms/source> _:b36821db088b0ced0a73e44125008a6cb ;
  <http://purl.org/dc/terms/created> "2019-04-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2022-11-24"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-axel-polleres, _:person-rob-brennan, _:person-harshvardhan-j-pandit, _:person-mark-lizar, _:person-maya-borges, _:person-damien-desfontaines ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#technical-measures-classes> .

<https://w3id.org/dpv#StaffTraining> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Staff Training"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Practices and policies regarding training of staff members"@en ;
