<https://w3id.org/dpv#InverseJurisdiction> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Jurisdiction> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Inverse Jurisdiction"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An inverse jurisdiction for a specific jurisdiction is the set of all other jurisdictions that are not part of the specific jurisdiction"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Jurisdiction> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse Jurisdictions are helpful when asserting and checking rules that involve a concept representing jurisdictions outside of a given jurisdiction. An inverse jurisdiction of an inverse jurisdiction should give back the same original jurisdiction but this is undefined and strongly dissuaded as it could lead to recursive definitions in some use-cases"@en ;
  <http://purl.org/dc/terms/created> "2025-05-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog, _:person-julian-flake, _:person-beatriz-esteves ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#jurisdiction-classes> .

<https://w3id.org/dpv#CannotChallengeProcessOutput> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#EntityNonPermissiveInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Cannot Challenge Process Output"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Involvement where entity cannot challenge the output of specified context"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#EntityNonPermissiveInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Challenge refers to raising questions about validity, necessity, correctness, or other similar 'trustworthiness' attributes regarding the output of the process or plan or implementation (where output is distinct from the process itself)"@en ;
  <http://purl.org/dc/terms/created> "2024-05-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani, _:person-steve-hickman ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#ConfidentialData> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Confidential Data"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Data deemed confidential"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Data> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Data> ;
