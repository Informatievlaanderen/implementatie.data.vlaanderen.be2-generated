  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#HumanResourceManagement> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Resource Management"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with managing humans and 'human resources' within the organisation for effective and efficient operations."@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "HR is a broad concept. Its management includes, amongst others - recruiting employees and intermediaries e.g. brokers, independent representatives; payroll administration, remunerations, commissions, and wages; and application of social legislation."@en ;
  <http://purl.org/dc/terms/source> _:b28272621f69490727aaf0017acf51cf7 ;
  <http://purl.org/dc/terms/created> "2021-09-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-paul-ryan, _:person-david-hickey, _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-beatriz-esteves ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-classes> .

<https://w3id.org/dpv#PartialAutomation> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#AutomationLevel> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Partial Automation"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Level of automation corresponding to Level 2 in ISO/IEC 22989:2022 where the automation is present in multiple parts of the system or in a manner that does not require the human to control/use these parts while still retaining control over the system"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#AutomationLevel> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Human Involvement is implied here, specifically the ability to Control operations, but also possibly for intervention, oversight, and verification"@en ;
  <http://purl.org/dc/terms/source> _:bae43fdb35e5b17467c6072924c18cebb ;
  <http://purl.org/dc/terms/created> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-04-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#ConsentWithdrawn> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ConsentStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Withdrawn"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "The state where the consent is withdrawn or revoked specifically by the data subject and which prevents it from being further used as a valid state"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ConsentStatusInvalidForProcessing> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "This state can be considered a form of 'revocation' of consent, where the revocation can only be performed by the data subject. Therefore we suggest using ConsentRevoked when it is a non-data-subject entity, and ConsentWithdrawn when it is the data subject"@en ;
  <http://purl.org/dc/terms/source> _:b81862437284348cec0143b34a90c27af ;
  <http://purl.org/dc/terms/created> "2022-06-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-paul-ryan, _:person-julian-flake ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#consent-status-classes> .

<https://w3id.org/dpv#PrivateInformationRetrieval> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Private Information Retrieval"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Use of cryptographic methods to retrieve a record from a system without revealing which record is retrieved"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#CryptographicMethods> ;
  <http://purl.org/dc/terms/source> _:b2d069fb44e1f5d4515fb9f346ec0eba3 ;
  <http://purl.org/dc/terms/created> "2022-08-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#technical-measures-classes> .

<https://w3id.org/dpv#SecureMultiPartyComputation> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Secure Multi-Party Computation"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Use of cryptographic methods for entities to jointly compute functions without revealing inputs"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#CryptographicMethods> ;
  <http://purl.org/dc/terms/source> _:b7191aa21b975cb14bbce32aa3ba9c7eb ;
  <http://purl.org/dc/terms/created> "2022-08-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#technical-measures-classes> .

<https://w3id.org/dpv#Applicability> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Applicability"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Concept provided to represent indication of cases where the information or context is not applicable (N/A) or not available or this is not known or determined yet. If the information is applicable and available, this concept should not be used."@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Context> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Context> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "These concepts are useful in closed-world interpretations, for example in forms where a field must have a value to explicitly denote it is not applicable or the information is not available yet."@en ;
  <http://purl.org/dc/terms/created> "2023-08-24"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0053> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#context-classes> .

<https://w3id.org/dpv#LegitimateInterestAssessment> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Legitimate Interest Assessment"@en ;
