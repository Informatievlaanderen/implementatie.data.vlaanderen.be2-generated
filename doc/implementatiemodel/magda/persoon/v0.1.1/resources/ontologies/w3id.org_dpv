<https://w3id.org/dpv#InferredPersonalData> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Inferred Personal Data"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Personal Data that is obtained through inference from other data"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#DerivedPersonalData>, <https://w3id.org/dpv#InferredData> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#DerivedPersonalData>, <https://w3id.org/dpv#InferredData> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Inferred Data is derived data generated from existing data, but which did not originally exist within it, e.g. inferring demographics from browsing history."@en ;
  <http://purl.org/dc/terms/created> "2022-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0009> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
