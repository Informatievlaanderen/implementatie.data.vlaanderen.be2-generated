<https://w3id.org/dpv#DataProtectionOfficer> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Protection Officer"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An entity within or authorised by an organisation to monitor internal compliance, inform and advise on data protection obligations and act as a contact point for data subjects and the supervisory authority."@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Representative> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Representative> ;
  <http://purl.org/dc/terms/source> _:b0e8c87deb303e02ffd381f080cfb1f33 ;
  <http://purl.org/dc/terms/created> "2020-11-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2021-12-08"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-paul-ryan ;
