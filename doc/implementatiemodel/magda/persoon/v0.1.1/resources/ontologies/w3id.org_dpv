  <http://www.w3.org/2004/02/skos/core#prefLabel> "Fee Not Required"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Concept indicating a fee is not required. This is distinct from a Fee of zero as it indicates a fee is not applicable in the context"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#FeeRequirement> ;
  <http://purl.org/dc/terms/created> "2024-08-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#context-classes> .

<https://w3id.org/dpv#HighAutomation> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#AutomationLevel> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "High Automation"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Level of automation corresponding to Level 4 in ISO/IEC 22989:2022 where the automation in system is capable of performing all its tasks within specific controlled conditions without human involvement"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#AutomationLevel> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Human Involvement is implied here, e.g. for intervention, input, decisions"@en ;
  <http://purl.org/dc/terms/source> _:bae43fdb35e5b17467c6072924c18cebb ;
  <http://purl.org/dc/terms/created> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-04-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#hasExpectation> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>, <http://www.w3.org/2004/02/skos/core#Concept> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "has expectation"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Indicates whether the specified context was expected or unexpected"@en ;
  <http://purl.org/dc/dcam/rangeIncludes> <https://w3id.org/dpv#ExpectationStatus> ;
  <https://schema.org/rangeIncludes> <https://w3id.org/dpv#ExpectationStatus> ;
  <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://w3id.org/dpv#hasStatus> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#hasStatus> ;
  <http://purl.org/dc/terms/created> "2024-05-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-06-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#status-properties> .

<https://w3id.org/dpv#ExplicitlyExpressedConsent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#LegalBasis> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Explicitly Expressed Consent"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Consent that is expressed through an explicit action solely conveying a consenting decision"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ExpressedConsent> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Explicitly expressed consent is a more specific form of Expressed consent where the action taken must 'explicitly' relate to only the consent decision. Expressed consent where the consenting is part of other matters therefore cannot satisfy the requirements of explicitly expressed consent. An example of explicit action expressing the consenting decision is a button on a web form where the form only relates to consent, or it is accompanied with suitable text that reiterates what the consenting decision is about"@en ;
  <http://purl.org/dc/terms/created> "2022-06-21"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-paul-ryan, _:person-julian-flake ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0018> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#consent-types-classes> .

