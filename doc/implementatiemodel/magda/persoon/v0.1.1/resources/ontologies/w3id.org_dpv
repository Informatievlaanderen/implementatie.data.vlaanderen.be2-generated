<https://w3id.org/dpv#SellProductsToDataSubject> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Sell Products to Data Subject"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with selling products or services to the user, consumer, or data subjects"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#SellProducts> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Sell Products here refers to processing necessary to provide and complete a sale to customers. It should not be confused with providing services with a cost based on an established agreement."@en ;
  <http://purl.org/dc/terms/created> "2019-04-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-javier-fernandez, _:person-axel-polleres, _:person-elmar-kiesling, _:person-fajar-ekaputra, _:person-simon-steyskal ;
