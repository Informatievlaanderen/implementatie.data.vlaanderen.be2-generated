<https://w3id.org/dpv#UnstructuredData> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Unstructured Data"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Data that is without a predefined data model or is not organised in a pre-defined manner"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Data> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Data> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept is relevant to application of privacy/data protection regulations like GDPR as unstructured data may contain PII/personal data and it is useful to flag such data with unknown or incomplete modelling information for audits. It is also useful to flag data for potential quality issues"@en ;
  <http://purl.org/dc/terms/created> "2025-03-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-rob-brennan, _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#personal-data-classes> .

<https://w3id.org/dpv#FailSafeProtocols> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Fail-Safe Protocols"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Use of fail-safe measures and protocols"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://purl.org/dc/terms/source> "AI Act Article 15(4)"@en ;
