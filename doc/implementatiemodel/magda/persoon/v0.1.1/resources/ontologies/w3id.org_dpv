  <http://www.w3.org/2004/02/skos/core#definition> "Access control applied for physical access e.g. premises or equipment"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#AccessControlMethod> ;
  <http://purl.org/dc/terms/source> "NIST SP 800-12"@en ;
  <http://purl.org/dc/terms/created> "2022-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#physical-measures-classes> .

<https://w3id.org/dpv#ApprovalProcedure> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Approval Procedure"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A procedure or process for determining and managing approvals for activities as part of governance"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#GovernanceProcedures> ;
  <http://purl.org/dc/terms/created> "2024-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-delaram-golpayegani ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes> .

<https://w3id.org/dpv#CommercialResearch> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Commercial Research"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with conducting research in a commercial setting or with intention to commercialise e.g. in a company or sponsored by a company"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ResearchAndDevelopment>, <https://w3id.org/dpv#CommercialPurpose> ;
  <http://www.w3.org/2004/02/skos/core#related> <https://specialprivacy.ercim.eu/vocabs/purposes#Develop> ;
  <http://purl.org/dc/terms/created> "2019-04-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-04-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-javier-fernandez, _:person-axel-polleres, _:person-elmar-kiesling, _:person-fajar-ekaputra, _:person-simon-steyskal ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-classes> .

<https://w3id.org/dpv#ConsentStatusValidForProcessing> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ConsentStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Status Valid for Processing"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "States of consent that can be used as valid justifications for processing data"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ConsentStatus> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Practically, given consent is the only valid state for processing"@en ;
  <http://purl.org/dc/terms/source> _:b81862437284348cec0143b34a90c27af ;
  <http://purl.org/dc/terms/created> "2022-06-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-paul-ryan, _:person-julian-flake ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#consent-status-classes> .

<https://w3id.org/dpv#Store> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Processing> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Store"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "to keep data for future use"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Processing> ;
  <http://purl.org/dc/terms/source> _:bf719375d65f8ad0941dea397e25de4c6 ;
  <http://purl.org/dc/terms/created> "2019-05-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-classes> .

<https://w3id.org/dpv#DataHandlingClause> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#LegalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Handling Clause"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Contractual clauses governing handling of data within or by an entity"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ContractualTerms> ;
  <http://purl.org/dc/terms/created> "2024-08-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#legal-measures-classes> .

<https://w3id.org/dpv#Scale> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Scale"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A measurement along some dimension"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#ProcessingContext> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ProcessingContext> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Scales are subjective concepts that need to be defined and interpreted within the context of their application. For example, what would be small within one context could be large within another."@en ;
  <http://purl.org/dc/terms/created> "2022-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog, _:person-rana-saniei ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-scale-classes> .

<https://w3id.org/dpv#Notice> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Notice"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A notice is an artefact for providing information, choices, or controls"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Notice refers to the information whereas Notification refers to the provision of that notice. In several cases, they are used interchangeably - for example Privacy Notice as a measure or control refers to both the information as well as the act of making it available. For 'active' contexts where this distinction is important, e.g. data breach notifications, see Notification concept."@en ;
  <http://purl.org/dc/terms/created> "2021-09-08"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-paul-ryan, _:person-david-hickey, _:person-georg-p-krog, _:person-harshvardhan-j-pandit ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0017> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes>, <https://w3id.org/dpv#notice-classes> .

<https://w3id.org/dpv#NonProfitOrganisation> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Non-Profit Organisation"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An organisation that does not aim to achieve profit as its primary goal"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Organisation> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Organisation> ;
  <http://purl.org/dc/terms/source> _:b0f97484e2a3b06fd9a79bb7fe79ec7aa ;
  <http://purl.org/dc/terms/created> "2022-02-02"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2020-10-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-organisation-classes> .

<https://w3id.org/dpv#ContractSignedByParty> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ContractExecutionStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Contract Signed By Party"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status representing contract has been signed by the indicated signing party"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ContractExecutionStatus> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "The signing party can be expressed using dpv:hasParty with the status along with metadata such as a timestamp, or the status can be used to list whether each party in the contract has signed or not e.g. it is reviewing the contract"@en ;
  <http://purl.org/dc/terms/created> "2025-01-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog, _:person-julian-flake ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#contract-status-classes> .

<https://w3id.org/dpv#PrivacyPreservingProtocol> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Privacy Preserving Protocol"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Use of protocols designed with the intention of provided additional guarantees regarding privacy"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#CryptographicMethods> ;
  <http://purl.org/dc/terms/source> _:b7191aa21b975cb14bbce32aa3ba9c7eb ;
  <http://purl.org/dc/terms/created> "2022-08-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#technical-measures-classes> .

<https://w3id.org/dpv/guides> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/dx/prof/ResourceDescriptor> ;
  <http://www.w3.org/ns/dx/prof/hasRole> <http://www.w3.org/ns/dx/prof/role/guidance> ;
  <http://www.w3.org/ns/dx/prof/hasArtifact> <https://w3id.org/dpv/guides> ;
  <http://purl.org/dc/terms/title> "Guides for Data Privacy Vocabulary" ;
