  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#FederatedLocations> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#LocationFixture> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Federated Locations"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Location that is federated across multiple separate areas with designation of a primary or central location"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#LocationFixture> ;
  <http://purl.org/dc/terms/created> "2022-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2020-10-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#jurisdiction-classes> .

<https://w3id.org/dpv#CorrectingProcessOutput> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#EntityPermissiveInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Correcting Process Output"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Involvement where entity can correct the output of specified context"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#EntityPermissiveInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Correction of outputs allows modification of the output - implying continuation of the process. This is distinct from reversing of outputs which revert the output back to its previous value and possibly imply not continuing with the process"@en ;
  <http://purl.org/dc/terms/created> "2024-05-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani, _:person-steve-hickman ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#RightNotice> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Right Notice"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Information associated with rights, such as which rights exist, when and where they are applicable, and other relevant information"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Notice> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept also covers information about rights exercise, with dpv:RightExerciseNotice specifically representing information provided in connection with exercising of rights. Both notices may be needed, e.g. RightNotice for providing information about existence and exercise of rights, and RightExerciseNotice for providing additional information specifically about exercise of rights - such as to request more information or provide updates on an exercised rights request"@en ;
  <http://purl.org/dc/terms/created> "2024-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#rights-classes> .

<https://w3id.org/dpv#Notification> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Notification"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Notification represents the provision of a notice i.e. notifying"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Notice refers to the information whereas Notification refers to the provision of that notice. The distinction is important as there are specific obligations associated with notice and notifications. For example, a data breach notice refers to the information about the breach intended to be provided to another entity, whereas notification refers to the act of providing the entity with the notice"@en ;
  <http://purl.org/dc/terms/created> "2024-04-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes> .

<https://w3id.org/dpv#RecruitmentApplicationAnalysis> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Recruitment Application Analysis"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purposes assocaited with analysis of job applications or job candidates for recruitment"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#RecruitmentApplicationManagement> ;
  <http://purl.org/dc/terms/created> "2024-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-classes> .

<https://w3id.org/dpv#HumanInvolvementForVerification> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#HumanInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Involvement for Verification"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Human involvement for the purposes of verification of specified context to ensure its operations, inputs, or outputs are correct or are acceptable."@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#HumanInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Verification by itself does not imply ability to Control, Intervene, or having Oversight."@en ;
  <http://purl.org/dc/terms/created> "2022-09-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#NonCompliant> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ComplianceStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Non Compliant"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "State of non-compliance where objectives have not been met, but have not been violated"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ComplianceStatus> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Changed from not compliant for consistency in commonly used terms"@en ;
  <http://purl.org/dc/terms/created> "2022-05-18"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2022-09-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#status-classes> .

