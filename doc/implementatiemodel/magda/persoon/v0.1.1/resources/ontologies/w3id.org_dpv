<https://w3id.org/dpv#Autonomous> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#AutomationLevel> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Autonomous"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Level of automation corresponding to Level 6 in ISO/IEC 22989:2022 where the automation in system is capable of modifying its operation domain or its goals without external intervention, control or oversight"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#AutomationLevel> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Though Autonomous, such operations can still be associated with dpv:HumanInvolved e.g. for inputs, oversight or verification"@en ;
  <http://purl.org/dc/terms/source> _:bae43fdb35e5b17467c6072924c18cebb ;
  <http://purl.org/dc/terms/created> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-04-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#FixedLocation> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#LocationFixture> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Fixed Location"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Location that is fixed i.e. known to occur at a specific place"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#LocationFixture> ;
  <http://purl.org/dc/terms/created> "2022-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2020-10-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#jurisdiction-classes> .

<https://w3id.org/dpv#Purpose> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Purpose"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purpose or (broader) Goal associated with data or technology"@en ;
  <http://www.w3.org/2004/02/skos/core#related> <https://specialprivacy.ercim.eu/langs/usage-policy#AnyPurpose> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "The purpose or goal here is intended to sufficiently describe the intention or objective of why the data or technology is being used, and should be broader than mere technical descriptions of achieving a capability. For example, \"Analyse Data\" is an abstract purpose with no indication of what the analyses is for as compared to a purpose such as \"Marketing\" or \"Service Provision\" which provide clarity and comprehension of the 'purpose' and can be enhanced with additional descriptions. Such modelling is in line with regulatory requirements regarding the specificity of purposes, for example in GDPR"@en ;
  <http://purl.org/dc/terms/source> _:bea6378d3ef9baf4a77841c3d4bb31623 ;
  <http://purl.org/dc/terms/created> "2019-04-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-04-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-axel-polleres, _:person-javier-fernandez, _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0003>, <https://w3id.org/dpv/examples#E0004>, <https://w3id.org/dpv/examples#E0007>, <https://w3id.org/dpv/examples#E0008>, <https://w3id.org/dpv/examples#E0040>, <https://w3id.org/dpv/examples#E0041>, <https://w3id.org/dpv/examples#E0042>, <https://w3id.org/dpv/examples#E0043> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-classes> .

<https://w3id.org/dpv#DigitalRightsManagement> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Digital Rights Management"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Management of access, use, and other operations associated with digital content"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://purl.org/dc/terms/source> _:b7191aa21b975cb14bbce32aa3ba9c7eb ;
  <http://purl.org/dc/terms/created> "2022-08-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#technical-measures-classes> .

<https://w3id.org/dpv#RiskMitigationMeasure> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Mitigation Measure"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Measures intended to mitigate, minimise, or prevent risk."@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#TechnicalOrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#TechnicalOrganisationalMeasure> ;
  <http://purl.org/dc/terms/created> "2020-11-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-paul-ryan ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0068> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#risk-classes> .

<https://w3id.org/dpv#Obligation> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Rule> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Obligation"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A rule describing an obligation for performing an activity"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#AcceptableRule> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Obligations are aligned with the term MUST in RFC2119 where specified activities are mandatory to be carried out"@en ;
  <http://purl.org/dc/terms/created> "2022-10-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2025-06-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "modified"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog, _:person-julian-flake, _:person-delaram-golpayegani, _:person-beatriz-esteves, _:person-arthit-suriyawongkul, _:person-paul-ryan ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#rules-classes> .

<https://w3id.org/dpv#LegalAgent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Legal Agent"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A Legal Agent is a Legal Entity that is authorised to act on behalf of another entity"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Agent>, <https://w3id.org/dpv#LegalEntity> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Agent>, <https://w3id.org/dpv#LegalEntity> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Legal agents may be human or non-human (e.g. an organisation), but they must be 'legal persons' i.e. recognised by law as such. The agency and the mechanisms through which it is given, acquired, or expressed is governed by relevant jurisdictional frameworks e.g. power of attorney"@en ;
  <http://purl.org/dc/terms/created> "2025-10-28"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-classes> .

<https://w3id.org/dpv#EconomicUnion> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Economic Union"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A political union of two or more countries based on economic or trade agreements"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Jurisdiction> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Jurisdiction> ;
  <http://purl.org/dc/terms/created> "2022-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2025-05-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "modified"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#jurisdiction-classes> .

<https://w3id.org/dpv#Scope> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Scope"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Indication of the extent or range or boundaries associated with(in) a context"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Context> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Context> ;
  <http://purl.org/dc/terms/created> "2022-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#context-classes> .

<https://w3id.org/dpv#SecurityAudit> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Security Audit"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An audit that systematically examines the existence and use of security risks and measures within information systems, networks, and security policies to identify vulnerabilities, risks, and gaps"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Audit> ;
  <http://purl.org/dc/terms/created> "2024-12-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes> .

<https://w3id.org/dpv#DataSubject> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Subject"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "The individual (or category of individuals) whose personal data is being processed"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#HumanSubject> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#HumanSubject> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "The term 'data subject' is specific to the GDPR, but is functionally equivalent to the term 'individual associated with data' and the ISO/IEC term 'PII Principle'"@en ;
  <http://purl.org/dc/terms/source> _:bb7b567cf983b60ca4198a8448a5145a1 ;
  <http://purl.org/dc/terms/created> "2019-04-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-12-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "modified"@en ;
  <http://purl.org/dc/terms/contributor> _:person-axel-polleres, _:person-javier-fernandez ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0039>, <https://w3id.org/dpv/examples#E0074> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-datasubject-classes> .

<https://w3id.org/dpv#WebSecurityProtocols> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Web Security Protocols"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Security implemented at or over web-based protocols"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#SecurityMethod> ;
  <http://purl.org/dc/terms/source> _:b7191aa21b975cb14bbce32aa3ba9c7eb ;
  <http://purl.org/dc/terms/created> "2022-08-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#technical-measures-classes> .

<https://w3id.org/dpv#ActivityOngoing> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ActivityStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Activity Ongoing"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "State of an activity occurring in continuation i.e. currently ongoing"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ActivityStatus> ;
