  <http://purl.org/dc/terms/contributor> _:person-delaram-golpayegani, _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#technical-measures-classes> .

<https://w3id.org/dpv#NoticeStale> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#NoticeStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Notice Stale"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status indicating the notice is stale or not up to date or not the latest version"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#NoticeStatus> ;
  <http://purl.org/dc/terms/created> "2024-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog ;
