<https://w3id.org/dpv#GuidelinesPrinciple> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Guidelines Principle"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Guidelines or Principles regarding processing and operational measures"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://purl.org/dc/terms/created> "2019-04-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-axel-polleres, _:person-rob-brennan, _:person-harshvardhan-j-pandit, _:person-mark-lizar ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes> .

<https://w3id.org/dpv#hasEntity> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>, <http://www.w3.org/2004/02/skos/core#Concept> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "has entity"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Indicates inclusion or applicability of an entity to some concept"@en ;
  <http://purl.org/dc/dcam/rangeIncludes> <https://w3id.org/dpv#Entity> ;
  <https://schema.org/rangeIncludes> <https://w3id.org/dpv#Entity> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "parent property for controller, processor, data subject, authority, etc.?"@en ;
  <http://purl.org/dc/terms/created> "2022-02-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-properties> .

<https://w3id.org/dpv#Hospital> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Hospital"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An organisation that provides comprehensive medical treatment, including emergency care, surgeries, and inpatient services"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Organisation> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Organisation> ;
  <http://purl.org/dc/terms/created> "2024-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-delaram-golpayegani ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-organisation-classes> .

<https://w3id.org/dpv#Pseudonymise> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Processing> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Pseudonymise"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "to replace personal identifiable information by artificial identifiers"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Transform> ;
  <http://purl.org/dc/terms/source> _:bf719375d65f8ad0941dea397e25de4c6 ;
  <http://purl.org/dc/terms/created> "2019-05-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2022-10-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-classes> .

<https://w3id.org/dpv#ContractAmended> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ContractPerformanceStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Contract Amended"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status representing contract that has been fully executed and whose terms have been amended through mutual agreement or other means such that the contract is still required to be performed"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ContractPerformanceStatus> ;
  <http://purl.org/dc/terms/created> "2025-01-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog, _:person-julian-flake ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#contract-status-classes> .

<https://w3id.org/dpv#DataSubjectRightsManagement> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Subject Rights Management"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Methods to provide, implement, and exercise data subjects' rights"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#RightsManagement> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept only concerns the organisational management of rights, and does not represent the rights themselves - especially where such 'rights' are legally recognised or defined for the data subject or individual. The concept dpv:DataSubjectRight is provided to represent such legal rights."@en ;
  <http://purl.org/dc/terms/source> "DGA 12.m"@en ;
  <http://purl.org/dc/terms/created> "2024-04-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-beatriz-esteves, _:person-harshvardhan-j-pandit, _:person-georg-p-krog ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes> .

<https://w3id.org/dpv#Filter> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Processing> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Filter"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "to filter or keep data for some criteria"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Transform> ;
  <http://purl.org/dc/terms/created> "2022-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-classes> .

<https://w3id.org/dpv#EntityNonPermissiveInvolvement> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Entity Non-Permissive Involvement"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Involvement of an entity in specific context where it is not permitted or able to do something"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#EntityInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#EntityInvolvement> ;
  <http://purl.org/dc/terms/created> "2024-05-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#ProcessingCondition> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Processing Condition"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Conditions required or followed regarding processing of data or use of technologies"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#ProcessingContext> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ProcessingContext> ;
  <http://purl.org/dc/terms/created> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0047> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#UncategorisedData> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Uncategorised Data"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Data whose categorisation is not known e.g. whether it is personal or non-personal data"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Data> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Data> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept is intended for indicating that a legally relevant categorisation of data has not been made - specifically regarding whether it is personal data or not, but it can also be extended for other categorisations such as sensitive data or domain-specific confidential data"@en ;
  <http://purl.org/dc/terms/created> "2025-03-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-rob-brennan, _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#personal-data-classes> .

<https://w3id.org/dpv#hasPurpose> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>, <http://www.w3.org/2004/02/skos/core#Concept> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "has purpose"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Indicates association with Purpose"@en ;
  <http://purl.org/dc/dcam/rangeIncludes> <https://w3id.org/dpv#Purpose> ;
  <https://schema.org/rangeIncludes> <https://w3id.org/dpv#Purpose> ;
  <http://purl.org/dc/terms/source> _:bea6378d3ef9baf4a77841c3d4bb31623 ;
  <http://purl.org/dc/terms/created> "2019-04-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2020-11-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-axel-polleres, _:person-javier-fernandez, _:person-harshvardhan-j-pandit, _:person-mark-lizar, _:person-bud-bruegger ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-properties> .

<https://w3id.org/dpv#ThirdPartyAgreement> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#LegalBasis>, <https://w3id.org/dpv#LegalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Third-Party Agreement"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An agreement outlining conditions, criteria, obligations, responsibilities, and specifics for carrying out processing of data between a Data Controller or Processor and a Third Party"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ThirdPartyContract> ;
  <http://purl.org/dc/terms/created> "2022-02-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-08-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "modified"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#contract-types-classes> .

<https://w3id.org/dpv#ContractFullyExecuted> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ContractExecutionStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Contract Fully Executed"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status representing contract has been fully executed i.e. it has been signed by all parties and all other procedural aspects such as exchange of signed contract copies have been completed"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ContractExecutionStatus> ;
  <http://purl.org/dc/terms/created> "2025-01-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog, _:person-julian-flake ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#contract-status-classes> .

<https://w3id.org/dpv#DataSubProcessor> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Sub-Processor"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A 'sub-processor' is a processor engaged by another processor"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#DataProcessor> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#DataProcessor> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "A 'Sub-Processor' is always a 'Processor' with the distinction of not directly being appointed by the 'Controller'"@en ;
  <http://purl.org/dc/terms/created> "2020-11-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-legalrole-classes> .

<https://w3id.org/dpv#SemiPrivateSpace> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Location> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Semi Private Space"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A private space that acts as a shared space with other entities but which is still essentially private for the individuals e.g. a semi-private hospital room shared with another patient"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#PrivateSpace> ;
  <http://purl.org/dc/terms/created> "2025-04-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog, _:person-julian-flake ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#jurisdiction-classes> .

<https://w3id.org/dpv#EvaluationScoring> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Evaluation and Scoring"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Processing that involves evaluation and scoring of individuals"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#ProcessingContext> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ProcessingContext> ;
  <http://purl.org/dc/terms/source> _:bf719375d65f8ad0941dea397e25de4c6 ;
  <http://purl.org/dc/terms/created> "2020-11-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-piero-bonatti ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#Screen> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Processing> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Screen"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "to remove data for some criteria"@en ;
