<https://w3id.org/dpv#HumanInvolvementForDecision> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#HumanInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Involvement for decision"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Human involvement for the purposes of exercising decisions over the specified operations in context"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#HumanInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Decisions are about exercising control over the operation, and are distinct from input (data or parameters)."@en ;
  <http://purl.org/dc/terms/created> "2022-09-06"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
