<https://w3id.org/dpv#PermissionManagement> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Permission Management"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Methods to obtain, provide, modify, and withdraw permissions along with maintaining a record of permissions, retrieving records, and processing changes in permission states"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#RightsManagement> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Permission is a broader concept than '(Informed) Consent' as consent when used as a legal basis has specific requirements to be valid. For management of consent, see the concept dpv:ConsentManagement"@en ;
  <http://purl.org/dc/terms/source> "DGA 12.n"@en ;
  <http://purl.org/dc/terms/created> "2024-04-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-beatriz-esteves, _:person-harshvardhan-j-pandit, _:person-georg-p-krog ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes> .

<https://w3id.org/dpv#DataTransferNotice> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Transfer Notice"@en ;
