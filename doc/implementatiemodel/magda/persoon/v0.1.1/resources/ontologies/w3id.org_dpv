  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#context-classes> .

<https://w3id.org/dpv#DataInteroperabilityManagement> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Interoperability Management"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Measures associated with management of data interoperability"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#DataGovernance> ;
  <http://purl.org/dc/terms/created> "2024-04-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes> .

<https://w3id.org/dpv#NoticeUnused> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#NoticeStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Notice Unused"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status indicating the notice has been communicated but has not yet been used e.g. the recipient has not acknowledged it or has not taken the intended action"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#NoticeStatus> ;
  <http://purl.org/dc/terms/created> "2024-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#notice-classes> .

<https://w3id.org/dpv#CannotReverseProcessInput> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#EntityNonPermissiveInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Cannot Reverse Process Input"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Involvement where entity cannot reverse input of specified context"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#EntityNonPermissiveInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Reversion can be considered a form of correction in some instances. We welcome inputs to further explore and define this relation between correction and reversion concepts."@en ;
  <http://purl.org/dc/terms/created> "2024-05-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani, _:person-steve-hickman ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#PersonnelMonitoring> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Personnel Monitoring"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with monitoring of personnel"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#PersonnelManagement> ;
  <http://purl.org/dc/terms/created> "2024-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-classes> .

<https://w3id.org/dpv#DataSanitisationTechnique> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Sanitisation Technique"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Cleaning or any removal or re-organisation of elements in data based on selective criteria"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://purl.org/dc/terms/source> _:b7191aa21b975cb14bbce32aa3ba9c7eb ;
  <http://purl.org/dc/terms/created> "2022-08-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#technical-measures-classes> .

<https://w3id.org/dpv#RenewedConsentGiven> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ConsentStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Renewed Consent Given"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "The state where a previously given consent has been 'renewed' or 'refreshed' or 'reaffirmed' to form a new instance of given consent"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ConsentStatusValidForProcessing> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "An example of this state is when a previously given consent has expired, and the individual is presented a notice regarding continuing associated processing operations - to which they agree. This state can be useful to keep track of 'reconfirmed' or 'refreshed' consent within consent records, assist notices and contextual agents to create better consenting dialogues, and assist with specific legal obligations related to subsequent consenting"@en ;
  <http://purl.org/dc/terms/source> _:b81862437284348cec0143b34a90c27af ;
  <http://purl.org/dc/terms/created> "2022-06-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-paul-ryan, _:person-julian-flake ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#consent-status-classes> .

<https://w3id.org/dpv#hasCountry> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>, <http://www.w3.org/2004/02/skos/core#Concept> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "has country"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Indicates applicability of specified country"@en ;
  <http://purl.org/dc/dcam/rangeIncludes> <https://w3id.org/dpv#Country> ;
  <https://schema.org/rangeIncludes> <https://w3id.org/dpv#Country> ;
  <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://w3id.org/dpv#hasLocation> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#hasLocation> ;
  <http://purl.org/dc/terms/created> "2022-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#jurisdiction-properties> .

<https://w3id.org/dpv#SubProcessorAgreement> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#LegalBasis>, <https://w3id.org/dpv#LegalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Sub-Processor Agreement"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An agreement outlining conditions, criteria, obligations, responsibilities, and specifics for carrying out processing of data between a Data Processor and a Data (Sub-)Processor"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#DataProcessingAgreement> ;
  <http://purl.org/dc/terms/created> "2022-01-26"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-08-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "modified"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-beatriz-esteves, _:person-paul-ryan, _:person-julian-flake ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#contract-types-classes> .

<https://w3id.org/dpv#DataAltruism> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Altruism"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with the voluntary sharing of data for the general interest of the public, such as healthcare or combating climate change"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#PublicBenefit> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Data Altruism as a purpose should be combined with other purposes to indicate their altruistic interpretation or application. E.g. improving healthcare and data altruism in combination."@en ;
  <http://purl.org/dc/terms/source> "DGA 2.16"@en ;
  <http://purl.org/dc/terms/created> "2024-02-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-beatriz-esteves, _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-classes> .

<https://w3id.org/dpv#LegalObligationCompleted> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#LegalObligationStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Legal ObligationCompleted"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status where the legal obligation has been completed"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#LegalObligationStatus> ;
  <http://purl.org/dc/terms/created> "2024-08-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#legal-basis-status-classes> .

<https://w3id.org/dpv#hasParty> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>, <http://www.w3.org/2004/02/skos/core#Concept> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "has party"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Indicates a legal entity involved as a party in a contract"@en ;
  <http://purl.org/dc/dcam/domainIncludes> <https://w3id.org/dpv#Contract> ;
  <https://schema.org/domainIncludes> <https://w3id.org/dpv#Contract> ;
  <http://purl.org/dc/dcam/rangeIncludes> <https://w3id.org/dpv#LegalEntity> ;
  <https://schema.org/rangeIncludes> <https://w3id.org/dpv#LegalEntity> ;
  <http://purl.org/dc/terms/created> "2025-01-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-julian-flake, _:person-georg-p-krog, _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#contract-properties> .

<https://w3id.org/dpv#EstablishContractualAgreement> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Establish Contractual Agreement"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with carrying out data processing to establish an agreement, such as for entering into a contract"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Purpose> ;
  <http://purl.org/dc/terms/created> "2022-11-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-classes> .

<https://w3id.org/dpv#DerivedPersonalData> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Derived Personal Data"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Personal Data that is obtained or derived from other data"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#PersonalData>, <https://w3id.org/dpv#DerivedData> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#PersonalData>, <https://w3id.org/dpv#DerivedData> ;
  <http://www.w3.org/2004/02/skos/core#related> <https://specialprivacy.ercim.eu/vocabs/data#Derived> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Derived Data is data that is obtained through processing of existing data, e.g. deriving first name from full name. To indicate data that is derived but which was not present or evident within the source data, InferredPersonalData should be used."@en ;
  <http://purl.org/dc/terms/source> _:b7e7d51fbeba97b0dd11b8c1d4bdd2b0a ;
  <http://purl.org/dc/terms/created> "2019-05-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-elmar-kiesling, _:person-harshvardhan-j-pandit, _:person-fajar-ekaputra ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0009>, <https://w3id.org/dpv/examples#E0046> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#personal-data-classes> .

<https://w3id.org/dpv#DataQualityManagement> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Quality Management"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Measures associated with management of data quality"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#DataGovernance> ;
  <http://purl.org/dc/terms/created> "2024-04-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes> .

<https://w3id.org/dpv#PersonalDataAudit> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Personal Data Audit"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An audit that systematically examines the existence and use of personal data along with its associated resources (e.g. where it is stored) and flows (e.g. where it originates and with whom it is being shared)"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#InformationAudit> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept is the same as \"Data Mapping\" and \"Data Flow Mapping Exercise\" used by the Information Commissioner's Office as \"to document the data that flows in, around, and out of information processing systems or services\""@en ;
  <http://purl.org/dc/terms/created> "2024-12-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-paul-ryan, _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes> .

<https://w3id.org/dpv#DataSubjectRight> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Right> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Subject Right"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "The rights applicable or provided to a Data Subject"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Right> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Based on use of definitions, the notion of 'Data Subject Right' can be equivalent to 'Individual Right' or 'Right of a Person'"@en ;
  <http://purl.org/dc/terms/created> "2020-11-18"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-beatriz-esteves, _:person-georg-p-krog, _:person-harshvardhan-j-pandit ;
