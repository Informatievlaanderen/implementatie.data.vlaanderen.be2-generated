  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-legalrole-classes> .

<https://w3id.org/dpv#ObligationViolated> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#RuleFulfilmentStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Obligation Violated"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status indicating an obligation has been violated i.e. the activity stated as being required to be carried out has not been carried out and this is considered as a violation i.e. the activity can no longer be carried out to fulfil the obligation"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#RuleViolated> ;
  <http://purl.org/dc/terms/created> "2024-09-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
