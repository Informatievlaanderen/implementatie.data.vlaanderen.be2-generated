<https://w3id.org/dpv#AutomationLevel> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Automation Level"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Indication of degree or level of automation associated with specified context"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#ProcessingContext> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ProcessingContext> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept was called 'Automation' in previous versions"@en ;
  <http://purl.org/dc/terms/source> _:bae43fdb35e5b17467c6072924c18cebb ;
  <http://purl.org/dc/terms/created> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
