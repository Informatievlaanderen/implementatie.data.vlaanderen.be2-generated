<https://w3id.org/dpv#LocalLocation> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Location> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Local Location"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Location is local"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#LocationLocality> ;
  <http://purl.org/dc/terms/created> "2022-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2020-10-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#jurisdiction-classes> .

<https://w3id.org/dpv#Download> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Processing> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Download"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "to provide a copy or to receive a copy of data over a network or internet"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Disclose> ;
  <http://purl.org/dc/terms/source> "DGA 2.13"@en, " 2.20"@en ;
  <http://purl.org/dc/terms/created> "2024-04-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-beatriz-esteves ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-classes> .

<https://w3id.org/dpv#SystematicMonitoring> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ProcessingContext> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Systematic Monitoring"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Processing that involves systematic monitoring of individuals"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ProcessingContext> ;
  <http://purl.org/dc/terms/source> _:bf719375d65f8ad0941dea397e25de4c6 ;
  <http://purl.org/dc/terms/created> "2020-11-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-piero-bonatti ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#SensitivePersonalData> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Sensitive Personal Data"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Personal data that is considered 'sensitive' in terms of privacy and/or impact, and therefore requires additional considerations and/or protection"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#PersonalData>, <https://w3id.org/dpv#SensitiveData> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#PersonalData>, <https://w3id.org/dpv#SensitiveData> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Sensitivity' is a matter of context, and may be defined within legal frameworks. For GDPR, Special categories of personal data are considered a subset of sensitive data. To illustrate the difference between the two, consider the situation where Location data is collected, and which is considered 'sensitive' but not 'special'. As a probable rule, sensitive data require additional considerations whereas special category data requires additional legal basis / justifications."@en ;
  <http://purl.org/dc/terms/created> "2022-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0010>, <https://w3id.org/dpv/examples#E0045> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#personal-data-classes> .

<https://w3id.org/dpv#Jurisdiction> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Jurisdiction"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A jurisdiction represents the locations that define the extent of authority (or control) claimed, granted, or asserted by a legal entity (in particular a legal authority) to govern or enforce rules"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Location> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Location> ;
  <http://purl.org/dc/terms/created> "2025-05-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#jurisdiction-classes> .

<https://w3id.org/dpv#PrivateSectorBody> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Private Sector Body"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An organisation owned and operated by private individuals or companies"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#LegalEntity> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#LegalEntity> ;
  <http://purl.org/dc/terms/created> "2024-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
