  <http://purl.org/dc/terms/conformsTo> <https://www.w3.org/TR/html/> .

<https://w3id.org/dpv#SingularFrequency> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Frequency> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Singular Frequency"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Frequency where occurrences are singular i.e. they take place only once"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Frequency> ;
  <http://purl.org/dc/terms/created> "2022-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2020-10-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#context-classes> .

<https://w3id.org/dpv#ServiceRegistration> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Service Registration"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with registering users and collecting information required for providing a service"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ServiceManagement> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "An example of service registration is to provide a form that collects information such as preferred language or media format for downloading a movie"@en ;
  <http://purl.org/dc/terms/created> "2020-11-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2026-02-08"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "modified"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-beatriz-esteves ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-classes> .

<https://w3id.org/dpv#CustomerManagement> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Customer Management"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Customer Management refers to purposes associated with managing activities related with past, current, and future customers"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Purpose> ;
  <http://purl.org/dc/terms/created> "2021-09-08"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-beatriz-esteves ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-classes> .

<https://w3id.org/dpv#DataSuitabilityAssessment> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Suitability Assessment"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Measures associated with assessment of suitability of data for specific task(s)"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#DataQualityAssessment> ;
  <http://purl.org/dc/terms/created> "2026-02-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-delaram-golpayegani ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes> .

<https://w3id.org/dpv#PartiallyCompliant> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ComplianceStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Partially Compliant"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "State of partially being compliant i.e. only some objectives have been met, and others have not been in violation"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ComplianceStatus> ;
  <http://purl.org/dc/terms/created> "2022-05-18"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#status-classes> .

<https://w3id.org/dpv#ContractBeingPerformed> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ContractPerformanceStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Contract Being Performed"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status representing contract that has been fully executed and whose terms are being carried out i.e. the contract is being performed"@en ;
