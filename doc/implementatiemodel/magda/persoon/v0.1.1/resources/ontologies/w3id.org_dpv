  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#GeneratedData> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Generated Data"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Data that is generated or brought into existence without relation to existing data i.e. it is not derived or inferred from other data"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Data> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Data> ;
  <http://purl.org/dc/terms/created> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#personal-data-classes> .

<https://w3id.org/dpv#NationalAuthority> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "National Authority"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An authority tasked with overseeing legal compliance for a nation"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Authority> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Authority> ;
  <http://purl.org/dc/terms/source> _:b0f97484e2a3b06fd9a79bb7fe79ec7aa ;
  <http://purl.org/dc/terms/created> "2022-02-02"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-authority-classes> .

<https://w3id.org/dpv#AuthorityUninformed> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#EntityInformedStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Authority Uninformed"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status indicating Authority is uninformed i.e. has not been informed about the specified context"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#EntityUninformed> ;
  <http://purl.org/dc/terms/created> "2024-05-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani, _:person-georg-p-krog, _:person-paul-ryan ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#status-classes> .

<https://w3id.org/dpv#DataImporter> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Importer"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An entity that 'imports' data where importing is considered a form of data transfer"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Recipient> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Recipient> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "The term 'Data Importer' is used by the EU-EDPB as the entity that receives transferred data across borders. While the EDPB refers to the jurisdictional border of EU, the term within DPV can be used to denote any 'import' or reception of transfer or transmission of data and is thus a broader concept than the EDPB's definition."@en ;
  <http://purl.org/dc/terms/source> _:b509c5b4d2c0fb8b5bc96fa8a45111e5c ;
  <http://purl.org/dc/terms/created> "2021-09-08"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-david-hickey, _:person-georg-p-krog, _:person-paul-ryan, _:person-harshvardhan-j-pandit ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0035> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-legalrole-classes> .

<https://w3id.org/dpv#VitalInterestObjected> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#VitalInterestStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Vital Interest Objected"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status where the vital interest activity was objected to by the Data Subject or another relevant entity"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#VitalInterestStatus> ;
  <http://purl.org/dc/terms/created> "2024-08-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#legal-basis-status-classes> .

<https://w3id.org/dpv#Unintended> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#IntentionStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Unintended"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status indicating the specified context was unintended i.e. not intended"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#IntentionStatus> ;
  <http://purl.org/dc/terms/created> "2024-05-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani, _:person-georg-p-krog, _:person-paul-ryan ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#status-classes> .

<https://w3id.org/dpv#ReviewImpactAssessment> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Review Impact Assessment"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Procedures to review impact assessments in terms of continued validity, adequacy for intended purposes, and conformance of processes with findings"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ReviewProcedure>, <https://w3id.org/dpv#ImpactAssessment> ;
  <http://purl.org/dc/terms/created> "2022-10-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
