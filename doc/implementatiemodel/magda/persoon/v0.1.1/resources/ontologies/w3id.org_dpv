<https://w3id.org/dpv#VulnerableDataSubject> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#HumanSubject> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Vulnerable Data Subject"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Humans which should be considered 'vulnerable' and therefore would require additional measures and safeguards"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#VulnerableHuman> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept denotes a Data Subject or a group are vulnerable, but not what vulnerability they possess or its context. This information can be provided additionally as comments, or as separate concepts and relations. Proposals for this are welcome."@en ;
  <http://purl.org/dc/terms/created> "2020-11-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-12-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "modified"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-paul-ryan, _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-datasubject-classes> .

<https://w3id.org/dpv#TechnicalMeasure> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Technical Measure"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Technical measures used to safeguard and ensure good practices in connection with data and technologies"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#TechnicalOrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#TechnicalOrganisationalMeasure> ;
  <http://purl.org/dc/terms/created> "2019-04-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
