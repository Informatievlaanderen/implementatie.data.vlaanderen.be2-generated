<https://w3id.org/dpv#NonPersonalData> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Non-Personal Data"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Data that is not Personal Data"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Data> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Data> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "The term NonPersonalData is provided to distinguish between PersonalData and other data, e.g. for indicating which data is regulated by privacy laws. To specify personal data that has been anonymised, the concept AnonymisedData should be used as the anonymisation process has a risk of not being fully effective and such anonymous data may be found to be personal data depending on circumstances."@en ;
  <http://purl.org/dc/terms/created> "2022-01-19"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#personal-data-classes> .

<https://w3id.org/dpv#DifferentialPrivacy> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Differential Privacy"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Utilisation of differential privacy where information is shared as patterns or groups to withhold individual elements"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#CryptographicMethods> ;
  <http://purl.org/dc/terms/source> _:b2d069fb44e1f5d4515fb9f346ec0eba3 ;
  <http://purl.org/dc/terms/created> "2022-08-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#technical-measures-classes> .

<https://w3id.org/dpv#SingleSignOn> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Single Sign On"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Use of credentials or processes that enable using one set of credentials to authenticate multiple contexts."@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#AuthenticationProtocols> ;
  <http://purl.org/dc/terms/created> "2020-11-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-paul-ryan ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#technical-measures-classes> .

<https://w3id.org/dpv#RecruitmentManagement> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Recruitment Management"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purposes assocaited with recruitment of personnel, which includes identifying, sourcing, screening, filtering, shortlisting, and interviewing candidates"@en ;
