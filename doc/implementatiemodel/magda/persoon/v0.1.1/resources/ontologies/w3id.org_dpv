<https://w3id.org/dpv#DataExporter> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Exporter"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An entity that 'exports' data where exporting is considered a form of data transfer"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#LegalEntity> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#LegalEntity> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "The term 'Data Exporter' is used by the EU-EDPB as the entity that transfer data across borders. While the EDPB refers to the jurisdictional border of EU, the term within DPV can be used to denote any 'export' or transfer or transmission of data and is thus a broader concept than the EDPB's definition."@en ;
  <http://purl.org/dc/terms/source> _:b509c5b4d2c0fb8b5bc96fa8a45111e5c ;
  <http://purl.org/dc/terms/created> "2021-09-08"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-david-hickey, _:person-georg-p-krog, _:person-paul-ryan, _:person-harshvardhan-j-pandit ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0035> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-legalrole-classes> .

<https://w3id.org/dpv#DPIA> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Protection Impact Assessment (DPIA)"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Impact assessment determining the potential and actual impact of processing activities on individuals or groups of individuals and taking into account the impacts of activities on their rights and freedoms"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#RightsImpactAssessment> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Specific requirements and procedures for DPIA are defined in GDPR Art.35"@en ;
  <http://purl.org/dc/terms/source> "GDPR Art. 35"@en ;
  <http://purl.org/dc/terms/created> "2020-11-04"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-04-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-paul-ryan ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0056> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#risk-classes> .

<https://w3id.org/dpv#ConsentRequestDeferred> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ConsentStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Request Deferred"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "State where a request for consent has been deferred without a decision"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ConsentStatusInvalidForProcessing> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "An example of this state is when the individual closes or dismisses a notice without making a decision. This state is intended for making the distinction between a notice being provided (as a consent request) and the individual interacting with the notice without making a decision - where the 'ignoring of a notice' is taken as consent being neither given nor refused"@en ;
  <http://purl.org/dc/terms/source> _:b81862437284348cec0143b34a90c27af ;
  <http://purl.org/dc/terms/created> "2022-06-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-paul-ryan, _:person-julian-flake ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#consent-status-classes> .

<https://w3id.org/dpv#ContractualClauseNotFulfilled> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ContractualClauseFulfilmentStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Contractual Clause Unfulfilled"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status indicating the terms of the contractual clause have not yet been fulfilled in a manner that does not constitute a violation i.e. there is still an opportunity to complete them"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ContractualClauseFulfilmentStatus> ;
  <http://purl.org/dc/terms/created> "2024-08-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2025-08-06"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "modified"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog, _:person-arthit-suriyawongkul ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#contract-clause-classes> .

<https://w3id.org/dpv#CannotWithdrawFromProcess> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#EntityNonPermissiveInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Cannot Withdraw from Process"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Involvement where entity cannot withdraw a previously given assent from specified context"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#EntityNonPermissiveInvolvement> ;
  <http://purl.org/dc/terms/created> "2024-05-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani, _:person-steve-hickman ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#LocalEnvironmentScale> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#GeographicCoverage> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Local Environment Scale"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Geographic coverage spanning a specific environment within the locality"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#GeographicCoverage> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "For example, geographic scale of an event take place in a specific building or room"@en ;
  <http://purl.org/dc/terms/created> "2022-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-scale-classes> .

<https://w3id.org/dpv#DecisionMaking> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Decision Making"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Processing that involves decision making"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#ProcessingContext> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ProcessingContext> ;
