<https://w3id.org/dpv#OrganisationGovernance> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Organisation Governance"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with conducting activities and functions for governance of an organisation"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Purpose> ;
  <http://purl.org/dc/terms/source> _:b28272621f69490727aaf0017acf51cf7 ;
  <http://purl.org/dc/terms/created> "2021-09-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-paul-ryan, _:person-georg-p-krog, _:person-david-hickey, _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-classes> .

<https://w3id.org/dpv#CollectedData> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Collected Data"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Data that has been obtained by collecting it from a source"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Data> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Data> ;
  <http://purl.org/dc/terms/created> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#personal-data-classes> .

<https://w3id.org/dpv#ContractDisputeResolutionClause> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ContractualClause> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Contract DisputeResolution Clause"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A provision detailing the methods and procedures for resolving disagreements or conflicts arising from the contract"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ContractualClause> ;
  <http://purl.org/dc/terms/created> "2024-08-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#contract-clause-classes> .

<https://w3id.org/dpv#ProvidedPersonalData> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Provided Personal Data"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Personal Data that has been provided by an entity such as the Data Subject"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#CollectedPersonalData>, <https://w3id.org/dpv#ProvidedData> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#CollectedPersonalData>, <https://w3id.org/dpv#ProvidedData> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Provided personal data involves one entity (e.g. data subject) explicitly providing the data, which the other entity (e.g. data controller) then collects"@en ;
  <http://purl.org/dc/terms/created> "2024-04-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-paul-ryan ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0046> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#personal-data-classes> .

<https://w3id.org/dpv#EULA> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#LegalBasis> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "End User License Agreement (EULA)"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "End User License Agreement is a contract entered into between a software (or service) developer or provider with the (end-)user"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#LicenseAgreement> ;
  <http://purl.org/dc/terms/created> "2024-08-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#contract-types-classes> .

<https://w3id.org/dpv#HashMessageAuthenticationCode> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Hash-based Message Authentication Code (HMAC)"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Use of HMAC where message authentication code (MAC) utilise a cryptographic hash function and a secret cryptographic key"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#CryptographicAuthentication> ;
  <http://purl.org/dc/terms/source> _:b300dfe3a50c9ba2c545e7e4b2a2a3933 ;
  <http://purl.org/dc/terms/created> "2022-08-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#technical-measures-classes> .

<https://w3id.org/dpv#GuardianOfHuman> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#HumanSubject> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Guardian(s) of Human"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Guardian(s) of humans"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#HumanSubject> ;
  <http://purl.org/dc/terms/created> "2024-12-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-datasubject-classes> .

<https://w3id.org/dpv#hasActiveEntity> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>, <http://www.w3.org/2004/02/skos/core#Concept> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "has active entity"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "indicates the entity is actively involved in specified context"@en ;
  <http://purl.org/dc/dcam/rangeIncludes> <https://w3id.org/dpv#Entity> ;
  <https://schema.org/rangeIncludes> <https://w3id.org/dpv#Entity> ;
  <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> <https://w3id.org/dpv#hasEntity> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#hasEntity> ;
  <http://purl.org/dc/terms/created> "2024-05-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-properties> .

<https://w3id.org/dpv#Intended> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#IntentionStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Intended"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status indicating the specified context was intended"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#IntentionStatus> ;
  <http://purl.org/dc/terms/created> "2024-05-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani, _:person-georg-p-krog, _:person-paul-ryan ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#status-classes> .

<https://w3id.org/dpv#HumanOversight> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Oversight"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Procedures related to implementing and ensuring human oversight, which includes ability for humans to oversee, understand, control, and reverse processes, and to have sufficient monitoring capability to detect and address anomalies, dysfunctions, or unexpected performance"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#GovernanceProcedures> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "DPV also provides a taxonomy for 'Entity Involvement' including specific forms of 'Human Involvement' which allow expressing the roles of humans in specific capacities such as oversight, controls, and whether they have the ability to do something or don't. The Human Oversight as an organisational measure represents the overall plans and procedures for implementation of such human involvement"@en ;
  <http://purl.org/dc/terms/created> "2026-02-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes> .

<https://w3id.org/dpv#Recipient> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Recipient"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Entities that receive data or technologies"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#LegalEntity> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#LegalEntity> ;
  <http://www.w3.org/2004/02/skos/core#related> <https://specialprivacy.ercim.eu/langs/usage-policy#AnyRecipient> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Recipients that receive personal data can be a Third Party, Data Controller, or Data Processor."@en ;
  <http://purl.org/dc/terms/source> _:b198e922470d4a2dbcdc01f56fddccd68 ;
  <http://purl.org/dc/terms/created> "2019-04-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-05-21"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-axel-polleres, _:person-javier-fernandez ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-legalrole-classes> .

<https://w3id.org/dpv#CommercialPurpose> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Commercial Purpose"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with processing activities performed in a commercial setting or with intention to commercialise"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Purpose> ;
  <http://purl.org/dc/terms/source> "DGA 4.4"@en ;
  <http://purl.org/dc/terms/created> "2024-02-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-beatriz-esteves, _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-classes> .

<https://w3id.org/dpv#HumanInvolvementForIntervention> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#HumanInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Involvement for intervention"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Human involvement for the purposes of exercising interventions over the specified operations in context"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#HumanInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Intervention indicates the ability to intervene in operations, which can be at various stages. It maps to Conditional and High automation models."@en ;
  <http://purl.org/dc/terms/created> "2022-09-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#ConditionalAutomation> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#AutomationLevel> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Conditional Automation"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Level of automation corresponding to Level 3 in ISO/IEC 22989:2022 where the automation is sufficient to perform most tasks of the system with the human present to take over where necessary"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#AutomationLevel> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Human Involvement is implied here, e.g. for intervention, input, decisions"@en ;
  <http://purl.org/dc/terms/source> _:bae43fdb35e5b17467c6072924c18cebb ;
  <http://purl.org/dc/terms/created> "2023-12-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-04-20"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-delaram-golpayegani ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#processing-context-classes> .

<https://w3id.org/dpv#RegulatorySandbox> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Regulatory Sandbox"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Mechanism used by regulators and businesses for gauging the compatibility of regulations and innovative products, particularly in the context of digitalisation, in a controlled real-world environment with appropriate safeguards in place"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Safeguard> ;
  <http://purl.org/dc/terms/source> _:b72abfb6c243f60971756ac31d082f7cf ;
  <http://purl.org/dc/terms/created> "2024-05-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes> .

<https://w3id.org/dpv#Student> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#HumanSubject> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Student"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Humans that are students"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#HumanSubject> ;
  <http://purl.org/dc/terms/created> "2022-04-06"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2024-12-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "modified"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog, _:person-julian-flake, _:person-paul-ryan, _:person-beatriz-esteves ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-datasubject-classes> .

<https://w3id.org/dpv#FireDepartment> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Fire Department"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "An organisation that is an emergency service provider for fire prevention, firefighting, and rescue services"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#EmergencyServiceProvider> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#EmergencyServiceProvider> ;
  <http://purl.org/dc/terms/created> "2024-12-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-delaram-golpayegani ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#entities-organisation-classes> .

<https://w3id.org/dpv#SecureProcessingEnvironment> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Secure Processing Environment"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A physical or virtual environment supported by organisational means that integrates security and compliance requirements and allows supervising data processing actions"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#SecurityProcedure> ;
  <http://purl.org/dc/terms/source> "DGA 2.20"@en ;
