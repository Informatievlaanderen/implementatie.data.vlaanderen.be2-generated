<https://w3id.org/dpv#EndToEndEncryption> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#TechnicalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "End-to-End Encryption (E2EE)"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Encrypted communications where data is encrypted by the sender and decrypted by the intended receiver to prevent access to any third party"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Encryption> ;
  <http://purl.org/dc/terms/source> _:b2d069fb44e1f5d4515fb9f346ec0eba3 ;
  <http://purl.org/dc/terms/created> "2022-08-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#technical-measures-classes> .

<https://w3id.org/dpv#ReversingProcessEffects> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#EntityPermissiveInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Reversing Process Effects"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Involvement where entity can reverse effects of specified context"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#EntityPermissiveInvolvement> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Effects refer to consequences and impacts arising from the process or from the outputs of a process"@en ;
  <http://purl.org/dc/terms/created> "2024-05-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
