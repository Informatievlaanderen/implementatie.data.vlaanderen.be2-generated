<https://w3id.org/dpv#JITNotice> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Just-in-time Notice"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A notice that is provided \"just in time\" when collecting information or performing an activity"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Notice> ;
  <http://purl.org/dc/terms/source> _:b011982720c175b1fc7595c1a04561c46 ;
  <http://purl.org/dc/terms/created> "2024-08-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#notice-classes> .

<https://w3id.org/dpv#FRIA> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Fundamental Rights Impact Assessment (FRIA)"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Impact assessment which assesses the potential and actual impact on fundamental rights occurring due to processing activities"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#RightsImpactAssessment> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "The fundamental rights and freedoms may be those defined in law or other norms, and may be bound to a jurisdiction - for example see EU Charter of Fundamental Rights"@en ;
  <http://purl.org/dc/terms/source> "AI Act Art.27"@en ;
  <http://purl.org/dc/terms/created> "2024-04-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#risk-classes> .

<https://w3id.org/dpv#NoticeLayer> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Notice Layer"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A layer within a layered notice where the layer can be used for providing specific information or controls"@en ;
  <http://purl.org/dc/terms/source> _:b011982720c175b1fc7595c1a04561c46 ;
  <http://purl.org/dc/terms/created> "2024-08-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0072> ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#notice-classes> .

<https://w3id.org/dpv#context-properties> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#ConceptScheme> .

<https://w3id.org/dpv#ReaffirmConsent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Reaffirm Consent"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Control for affirming consent"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#ConsentControl> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ConsentControl> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Indicates how the controller (with dpv:ObtainConsent) or data subject (with dpv:ProvideConsent) can reaffirm consent e.g. used with dpv:isExercisedAt"@en ;
  <http://purl.org/dc/terms/created> "2024-05-11"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#consent-controls-classes> .

<https://w3id.org/dpv#NonCommercialPurpose> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#Purpose> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Non-commercial Purpose"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with processing activities performed in a non-commercial setting or without intention to commercialise"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Purpose> ;
  <http://purl.org/dc/terms/source> "DGA 4.4"@en ;
  <http://purl.org/dc/terms/created> "2024-02-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-beatriz-esteves, _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#purposes-classes> .

<https://w3id.org/dpv#ImpliedConsent> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#LegalBasis> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Implied Consent"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Consent that is implied indirectly through an action not associated solely with conveying a consenting decision"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#InformedConsent> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Implied consent is expected to also be Informed Consent. An example is a CCTV notice outside a monitored area that informs the individuals that by walking in they would be consenting to the use of camera for surveillance."@en ;
  <http://purl.org/dc/terms/created> "2022-06-21"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-georg-p-krog, _:person-harshvardhan-j-pandit, _:person-paul-ryan, _:person-julian-flake ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#consent-types-classes> .

