<https://w3id.org/dpv#DataBreachNotification> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#OrganisationalMeasure> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Breach Notification"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Notification of information about data breach(es) i.e. unauthorised transfer, access, use, or modification of data"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#SecurityIncidentNotification> ;
  <http://purl.org/dc/terms/source> "DGA 12.k"@en, " DGA 21.5 GDPR 33"@en, " GDPR 34"@en ;
  <http://purl.org/dc/terms/created> "2024-04-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#organisational-measures-classes> .

<https://w3id.org/dpv#NegotiatedContract> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#LegalBasis> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Negotiated Contract"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "A contract where the terms and conditions are determined with all parties having the ability to negotiate the terms and conditions"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ContractByNegotiationType> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "Negotiation here refers to the opportunity for a party on their own initiative to modify or dictate terms and conditions within a contract. If the party is provided a set of options to choose from or in other ways is dictated which terms and conditions can be present in the contract, neither of these should be considered a negotiation"@en ;
  <http://purl.org/dc/terms/created> "2024-08-27"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#contract-types-classes> .

<https://w3id.org/dpv#ProhibitionUnviolated> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#RuleFulfilmentStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Prohibition Unviolated"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status indicating a prohibition has not been violated i.e. the activity stated as being prohibited has not been carried out"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#RuleFulfilled> ;
  <http://purl.org/dc/terms/created> "2024-09-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://purl.org/dc/terms/modified> "2025-08-06"^^<http://www.w3.org/2001/XMLSchema#date> ;
