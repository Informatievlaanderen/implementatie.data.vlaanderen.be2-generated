<https://w3id.org/dpv#ContractInactive> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#ContractActivationStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Contract Inactive"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status representing contract that has been fully executed and whose terms are not yet active i.e. they need to be performed at a later time"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#ContractActivationStatus> ;
  <http://www.w3.org/2004/02/skos/core#scopeNote> "An example of an inactive contract is where its terms need to be fulfilled at a later date, at which point the contract will become active"@en ;
  <http://purl.org/dc/terms/created> "2025-01-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit, _:person-georg-p-krog, _:person-julian-flake ;
  <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> <https://w3id.org/dpv#> ;
  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#contract-status-classes> .

<https://w3id.org/dpv#VerifiedData> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Verified Data"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Data that has been verified in terms of accuracy, consistency, or quality"@en ;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://w3id.org/dpv#Data> ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#Data> ;
  <http://purl.org/dc/terms/created> "2022-11-02"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
  <http://purl.org/dc/terms/contributor> _:person-harshvardhan-j-pandit ;
