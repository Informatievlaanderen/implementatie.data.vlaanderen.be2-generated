  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/dpv#rules-classes> .

<https://w3id.org/dpv#ObligationUnfulfilled> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept>, <http://www.w3.org/2000/01/rdf-schema#Class>, <https://w3id.org/dpv#RuleFulfilmentStatus> ;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Obligation Unfulfilled"@en ;
  <http://www.w3.org/2004/02/skos/core#definition> "Status indicating an obligation has not been fulfilled i.e. the activity stated as being required to be carried out has not been carried out but this is not considered as a violation e.g. there is still time to conduct the activity"@en ;
  <http://www.w3.org/2004/02/skos/core#broader> <https://w3id.org/dpv#RuleUnfulfilled> ;
  <http://purl.org/dc/terms/created> "2024-09-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en ;
