{
  "title": "GeregistreerdPersoon",
  "type": "object",
  "description": "Persoon waarvan de gegevens zijn ingeschreven in een register.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse GeregistreerdPersoon)",
      "pattern": "^GeregistreerdPersoon$"
    },
    "registratie": {
      "$ref": "#/components/schemas/Identificator"
    },
    "dossierstatus": {
      "$ref": "#/components/schemas/Dossierstatus"
    },
    "volgendeRegistratie": {
      "$ref": "#/components/schemas/Identificator"
    },
    "redenAfwezigheid": {
      "$ref": "#/components/schemas/RedenAfwezigheid"
    },
    "beheerder": {
      "type": "array",
      "description": "Lijst van AdministratiefBeheerder items.",
      "items": {
        "$ref": "#/components/schemas/AdministratiefBeheerder"
      },
      "minItems": 1
    },
    "voornaam": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Naam die een Persoon bij geboorte wordt gegeven. Onderscheidt de Persoon van de andere personen in de familie.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "achternaam": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Gedeelte van de volledige naam van de Persoon ontvangen van de vorige generatie. Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "contactinfo": {
      "$ref": "#/components/schemas/Contactinfo"
    },
    "geslacht": {
      "$ref": "#/components/schemas/Geslacht"
    },
    "isHoofdVan": {
      "$ref": "#/components/schemas/Gezin"
    },
    "heeftBurgerlijkeStaat": {
      "$ref": "#/components/schemas/BurgerlijkeStaat"
    },
    "heeftGeboorte": {
      "$ref": "#/components/schemas/Geboorte"
    },
    "heeftOverlijden": {
      "$ref": "#/components/schemas/Overlijden"
    },
    "heeftInwonerschap": {
      "type": "array",
      "description": "Lijst van Inwonerschap items.",
      "items": {
        "$ref": "#/components/schemas/Inwonerschap"
      },
      "minItems": 1
    },
    "heeftPersoonsrelatie": {
      "type": "array",
      "description": "Lijst van Persoonsrelatie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Gezinsrelatie"
          },
          {
            "$ref": "#/components/schemas/Huwelijk"
          },
          {
            "$ref": "#/components/schemas/Samenwonen"
          },
          {
            "$ref": "#/components/schemas/Afstamming"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Gezinsrelatie": "#/components/schemas/Gezinsrelatie",
            "Huwelijk": "#/components/schemas/Huwelijk",
            "Samenwonen": "#/components/schemas/Samenwonen",
            "Afstamming": "#/components/schemas/Afstamming"
          }
        }
      },
      "minItems": 1
    },
    "isLidVan": {
      "type": "array",
      "description": "Lijst van Gezin items.",
      "items": {
        "$ref": "#/components/schemas/Gezin"
      },
      "minItems": 1
    },
    "creatiedatum": {
      "type": "object",
      "description": "Datum waarop de gegevens zijn ingevoerd.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "modificatiedatum": {
      "type": "object",
      "description": "Datum waarop de gegevens werden bijgewerkt.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "bron": {
      "$ref": "#/components/schemas/Organisatie"
    }
  },
  "required": [
    "@type",
    "registratie"
  ]
}