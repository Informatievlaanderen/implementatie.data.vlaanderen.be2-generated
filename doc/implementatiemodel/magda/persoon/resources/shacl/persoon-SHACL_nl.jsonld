    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "In het Rijksregister doorgaans de gemeente maar kan ook een consulaat zijn voor een persoon in het buitenland of de Dienst Vreemdelingenzaken voor een asielzoeker."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Organisatie die het dossier van de persoon in het register beheert."
