      {
        "@language": "nl",
        "@value": "In het Rijksregister bedoeld voor personen in het Wachtregister, het is te zeggen voor voorlopig in plaats van defintief ingeschreven personen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Adres dat door een persoon wordt opgegeven als hoofdverblijfplaats."
