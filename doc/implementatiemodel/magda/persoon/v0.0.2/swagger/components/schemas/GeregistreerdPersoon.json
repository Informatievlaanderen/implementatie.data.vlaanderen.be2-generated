{
  "title": "GeregistreerdPersoon",
  "type": "object",
  "description": "Persoon waarvan de gegevens zijn ingeschreven in een register.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse GeregistreerdPersoon)",
      "pattern": "^GeregistreerdPersoon$"
    },
    "registratie": {
      "$ref": "#/components/schemas/Identificator"
    },
    "dossierstatus": {
      "$ref": "#/components/schemas/Dossierstatustype"
    },
    "vorigeRegistratie": {
      "$ref": "#/components/schemas/Identificator"
    },
    "redenAfwezigheid": {
      "$ref": "#/components/schemas/RedenAfwezigheid"
    },
    "beheerder": {
      "$ref": "#/components/schemas/AdministratiefBeheerder"
    },
    "voornaam": {
      "type": "array",
      "description": "Naam die een Persoon bij geboorte wordt gegeven. Onderscheidt de Persoon van de andere personen in de familie. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/GeregistreerdPersoon.voornaam"
      },
      "minItems": 1
    },
    "achternaam": {
      "type": "array",
      "description": "Gedeelte van de volledige naam van de Persoon ontvangen van de vorige generatie. Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/GeregistreerdPersoon.achternaam"
      },
      "minItems": 1
    },
    "contactinfo": {
      "$ref": "#/components/schemas/Contactinfo"
    },
    "geslacht": {
      "$ref": "#/components/schemas/Geslacht"
    },
    "isHoofdVan": {
      "$ref": "#/components/schemas/Gezin"
    },
    "heeftBurgerlijkeStaat": {
      "$ref": "#/components/schemas/BurgerlijkeStaat"
    },
    "heeftGeboorte": {
      "$ref": "#/components/schemas/Geboorte"
    },
    "heeftOverlijden": {
      "$ref": "#/components/schemas/Overlijden"
    },
    "heeftInwonerschap": {
      "type": "array",
      "description": "Inwonerschap van de persoon. Lijst van Inwonerschap items.",
      "items": {
        "$ref": "#/components/schemas/Inwonerschap"
      },
      "minItems": 1
    },
    "heeftPersoonsrelatie": {
      "type": "array",
      "description": "Persoonsrelatie van de persoon. Lijst van Persoonsrelatie items.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Gezinsrelatie"
          },
          {
            "$ref": "#/components/schemas/Huwelijk"
          },
          {
            "$ref": "#/components/schemas/Samenwonen"
          },
          {
            "$ref": "#/components/schemas/Afstamming"
          }
        ],
        "discriminator": {
          "propertyName": "@type",
          "mapping": {
            "Gezinsrelatie": "#/components/schemas/Gezinsrelatie",
            "Huwelijk": "#/components/schemas/Huwelijk",
            "Samenwonen": "#/components/schemas/Samenwonen",
            "Afstamming": "#/components/schemas/Afstamming"
          }
        }
      },
      "minItems": 1
    },
    "isLidVan": {
      "type": "array",
      "description": "Persoon die tot een Gezin behoort. Lijst van Gezin items.",
      "items": {
        "$ref": "#/components/schemas/Gezin"
      },
      "minItems": 1
    },
    "creatiedatum": {
      "$ref": "#/components/schemas/GeregistreerdPersoon.creatiedatum"
    },
    "modificatiedatum": {
      "$ref": "#/components/schemas/GeregistreerdPersoon.modificatiedatum"
    },
    "bron": {
      "$ref": "#/components/schemas/Organisatie"
    }
  },
  "required": [
    "@type",
    "creatiedatum",
    "bron"
  ]
}