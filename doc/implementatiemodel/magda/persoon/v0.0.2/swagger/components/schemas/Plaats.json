{
  "title": "Plaats",
  "type": "object",
  "description": "Een ruimtelijk gebied of benoemde plaats.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Plaats)",
      "pattern": "^Plaats$"
    },
    "plaatsnaam": {
      "type": "object",
      "description": "Naam van de plaats of van het gebied.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "plaats": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/Plaats"
        },
        {
          "$ref": "#/components/schemas/AdministratieveEenheid"
        }
      ],
      "discriminator": {
        "propertyName": "@type",
        "mapping": {
          "Plaats": "#/components/schemas/Plaats",
          "AdministratieveEenheid": "#/components/schemas/AdministratieveEenheid"
        }
      }
    }
  },
  "required": [
    "@type"
  ]
}