<https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#InwonerschapShape> a shacl:NodeShape;
  rdfs:label "Inwonerschap"@nl;
  rdfs:comment "Het feit dat een Persoon verblijf houdt in een plaats of land."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "persoon"@nl;
    rdfs:comment "De persoon waarvan het inwonerschap binnen de opgegeven Jurisdictie valt."@nl;
