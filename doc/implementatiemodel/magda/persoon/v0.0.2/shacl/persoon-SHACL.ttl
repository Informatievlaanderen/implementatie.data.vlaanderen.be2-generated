<https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#LocatiePeriodeOfJurisdictieShape> a shacl:NodeShape;
  rdfs:label "LocatiePeriodeOfJurisdictie"@nl;
