    shacl:description "De persoon waarvan het inwonerschap binnen de opgegeven Jurisdictie valt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "persoon"@nl;
    shacl:or ([shacl:class <http://www.w3.org/ns/person#Person>] [shacl:class <https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon>]);
    shacl:path <https://data.vlaanderen.be/ns/persoon#Inwonerschap.persoon>
  ], [
    a shacl:PropertyShape;
    rdfs:label "jurisdictie"@nl;
