    shacl:path <https://data.vlaanderen.be/ns/persoon#heeftVerblijfplaats>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Inwonerschap> .

<https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#JurisdictieShape> a shacl:NodeShape;
  rdfs:label "Jurisdictie"@nl;
