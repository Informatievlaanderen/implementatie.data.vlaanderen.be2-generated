<https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#PersoonShape> a shacl:NodeShape;
  rdfs:label "Persoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "In de rechtspraak betreft het een persoon (in de wettelijke betekenis, ttz met eigen rechtspersoonlijkheid) van de menselijke soort, ttz een fysiek persoon. Tegenhanger is de rechtspersoon, een juridische constructie die een private of publieke organisatie dezelfde rechtspersoonlijkheid geeft als een natuurlijk persoon (kan bv ook schulden hebben, contracten afsluiten, aangeklaagd worden etc)."@nl;
  rdfs:comment "Natuurlijk persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voornaam"@nl;
    rdfs:comment "Naam die een Persoon bij geboorte wordt gegeven. Onderscheidt de Persoon van de andere personen in de familie."@nl;
    rdfs:seeAlso <https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#Persoon.Voornaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam die een Persoon bij geboorte wordt gegeven. Onderscheidt de Persoon van de andere personen in de familie."@nl;
    shacl:name "voornaam"@nl;
    shacl:path foaf:givenName
  ], [
    a shacl:PropertyShape;
    rdfs:label "achternaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."@nl;
    rdfs:comment "Gedeelte van de volledige naam van de Persoon ontvangen van de vorige generatie."@nl;
    rdfs:seeAlso <https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#Persoon.Achternaam>;
    shacl:datatype xsd:string;
    shacl:description "Gedeelte van de volledige naam van de Persoon ontvangen van de vorige generatie."@nl;
    shacl:name "achternaam"@nl;
    shacl:path foaf:familyName
  ], [
    a shacl:PropertyShape;
    rdfs:label "contactinfo"@nl;
    rdfs:comment "Informatie zoals email, telefoon, ... die toelaat de Persoon te contacteren."@nl;
    rdfs:seeAlso <https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#Persoon.Contactinfo>;
    shacl:class schemas:ContactPoint;
    shacl:description "Informatie zoals email, telefoon, ... die toelaat de Persoon te contacteren."@nl;
    shacl:maxCount 1;
    shacl:name "contactinfo"@nl;
    shacl:path schemas:contactPoint
  ], [
    a shacl:PropertyShape;
    rdfs:label "geslacht"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het geslacht van een Persoon is sterk afhankelijk van de manier waarop dit gedefinieerd is, dit kan op basis van de biologische kenmerken maar ook op basis van gender, genderindentiteit, genderexpressie, etc. Voor meer informatie zie <a href=\"https://www.vlaanderen.be/dienst-diversiteitsbeleid/begrippen-rond-gender-en-seksuele-diversiteit\">Begrippen rond gender- en seksuele diversiteit</a>."@nl;
    rdfs:comment "De uiting van een Persoon's indentiteit, expressie en sociale rol."@nl;
    rdfs:seeAlso <https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#Persoon.Geslacht>;
    shacl:class skos:Concept;
    shacl:description "De uiting van een Persoon's indentiteit, expressie en sociale rol."@nl;
    shacl:maxCount 1;
    shacl:name "geslacht"@nl;
    shacl:path <http://data.europa.eu/m8g/gender>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isHoofdVan"@nl;
    rdfs:comment "Persoon die standaard het Gezin vertegenwoordigt."@nl;
    rdfs:seeAlso <https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#Persoon.IsHoofdVan>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Gezin>;
    shacl:description "Persoon die standaard het Gezin vertegenwoordigt."@nl;
    shacl:maxCount 1;
    shacl:name "isHoofdVan"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#isHoofdVan>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftBurgerlijkeStaat"@nl;
    rdfs:comment "Burgerlijke Staat van de Persoon."@nl;
    rdfs:seeAlso <https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#Persoon.HeeftBurgerlijkeStaat>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#BurgerlijkeStaat>;
    shacl:description "Burgerlijke Staat van de Persoon."@nl;
    shacl:maxCount 1;
    shacl:name "heeftBurgerlijkeStaat"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#heeftBurgerlijkeStaat>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftGeboorte"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bevat vaak de geboortegevens van de Persoon."@nl;
    rdfs:comment "Verwijst naar de geboortegebeurtenis van de Persoon."@nl;
    rdfs:seeAlso <https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#Persoon.HeeftGeboorte>;
    shacl:class <http://purl.org/vocab/bio/0.1/Birth>;
    shacl:description "Verwijst naar de geboortegebeurtenis van de Persoon."@nl;
    shacl:maxCount 1;
    shacl:name "heeftGeboorte"@nl;
    shacl:path <http://purl.org/vocab/bio/0.1/birth>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftOverlijden"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bevat vaak de overlijdensgegevens van de Persoon."@nl;
    rdfs:comment "Verwijst naar de overlijdensgebeurtenis van de Persoon."@nl;
    rdfs:seeAlso <https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#Persoon.HeeftOverlijden>;
    shacl:class <http://purl.org/vocab/bio/0.1/Death>;
    shacl:description "Verwijst naar de overlijdensgebeurtenis van de Persoon."@nl;
    shacl:maxCount 1;
    shacl:name "heeftOverlijden"@nl;
    shacl:path <http://purl.org/vocab/bio/0.1/death>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftInwonerschap"@nl;
    rdfs:comment "Inwonerschap van de persoon."@nl;
    rdfs:seeAlso <https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#Persoon.HeeftInwonerschap>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Inwonerschap>;
    shacl:description "Inwonerschap van de persoon."@nl;
    shacl:name "heeftInwonerschap"@nl;
    shacl:path <https://test.data.vlaanderen.be/ns/magda/persoon#heeftInwonerschap>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeftPersoonsrelatie"@nl;
    rdfs:comment "Persoonsrelatie van de persoon."@nl;
    rdfs:seeAlso <https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#Persoon.HeeftPersoonsrelatie>;
    shacl:description "Persoonsrelatie van de persoon."@nl;
    shacl:name "heeftPersoonsrelatie"@nl;
    shacl:or ([shacl:class <https://data.vlaanderen.be/ns/persoon#Persoonsrelatie>] [shacl:class <https://data.vlaanderen.be/ns/persoon#Gezinsrelatie>] [shacl:class <https://data.vlaanderen.be/ns/persoon#Huwelijk>] [shacl:class <https://data.vlaanderen.be/ns/persoon#Samenwonen>] [shacl:class <https://data.vlaanderen.be/ns/persoon#Afstamming>]);
    shacl:path <https://test.data.vlaanderen.be/ns/magda/persoon#heeftPersoonsrelatie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isLidVan"@nl;
    rdfs:comment "Persoon die tot een Gezin behoort."@nl;
    rdfs:seeAlso <https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#Persoon.IsLidVan>;
    shacl:class <https://data.vlaanderen.be/ns/persoon#Gezin>;
    shacl:description "Persoon die tot een Gezin behoort."@nl;
    shacl:name "isLidVan"@nl;
    shacl:path org:memberOf
  ];
  shacl:targetClass <http://www.w3.org/ns/person#Person>,
    <https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon> .

<https://implementatie.data.dev-vlaanderen.be/doc/implementatiemodel/magda/persoon/v0.0.2#PersoonsgebeurtenisShape> a shacl:NodeShape;
