    shacl:path dc:type
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/magda/persoon#Naamsverandering> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#NationaliteitShape> a shacl:NodeShape;
  rdfs:label "Nationaliteit"@nl;
  <http://purl.org/vocab/vann/usageNote> "Ruimer begrip dan Staatsburgerschap dat zich beperkt tot de relatie met een staat en bijhorende rechten en plichten. Wie de Nationaliteit van een bepaald land heeft is er doorgaans ook automatisch staatsburger van. Het wordt doorgaans automatisch verkregen door geboorte: men krijgt hetzij de nationaliteit van zijn ouders of men krijgt deze van het land waar men Inwoner van is. Maar men kan een nationaliteit ook verkrijgen door naturalisatie. In principe verliest men dan zijn oorspronkelijke nationaliteit, maar dat is niet altijd zo (meervoudige nationaliteit)."@nl;
  rdfs:comment "De relatie tussen een Persoon en een staat, cultuur, of loyaliteit."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#Nationaliteit>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "begindatum"@nl;
    rdfs:comment "Moment vanaf wanneer de instantie van deze klasse op het terrein van toepassing was."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#Nationaliteit.Begindatum>;
    shacl:datatype xsd:date;
    shacl:description "Moment vanaf wanneer de instantie van deze klasse op het terrein van toepassing was."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "begindatum"@nl;
    shacl:path prov:generatedAtTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "einddatum"@nl;
    rdfs:comment "Moment tot wanneer de instantie van deze klasse op het terrein van toepassing was."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#Nationaliteit.Einddatum>;
    shacl:datatype xsd:date;
    shacl:description "Moment tot wanneer de instantie van deze klasse op het terrein van toepassing was."@nl;
    shacl:maxCount 1;
    shacl:name "einddatum"@nl;
    shacl:path prov:invalidatedAtTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "nationaliteit"@nl;
    rdfs:comment "De nationaliteit van de Persoon."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#Nationaliteit.Nationaliteit>;
    shacl:description "De nationaliteit van de Persoon."@nl;
