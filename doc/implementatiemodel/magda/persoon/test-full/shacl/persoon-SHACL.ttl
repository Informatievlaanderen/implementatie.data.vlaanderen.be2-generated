<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AangegevenAdresShape> a shacl:NodeShape;
  rdfs:label "AangegevenAdres"@nl;
  <http://purl.org/vocab/vann/usageNote> "In het Rijksregister bedoeld voor personen in het Wachtregister, het is te zeggen voor voorlopig in plaats van defintief ingeschreven personen."@nl;
  rdfs:comment "Adres dat door een persoon wordt opgegeven als hoofdverblijplaats."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AangegevenAdres>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "beheerdertype"@nl;
    rdfs:comment "Type Organisatie dat het AangegevenAdres ingeeft of bewerkt."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AangegevenAdres.Beheerdertype>;
    shacl:description "Type Organisatie dat het AangegevenAdres ingeeft of bewerkt."@nl;
    shacl:maxCount 1;
    shacl:name "beheerdertype"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://implementatie.data.vlaanderen.be/ns/magda/persoon#beheerdertype>
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/magda/persoon#AangegevenAdres> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AdministratiefBeheerderShape> a shacl:NodeShape;
  rdfs:label "AdministratiefBeheerder"@nl;
  <http://purl.org/vocab/vann/usageNote> "In het Rijksregister doorgaans de gemeente maar kan ook een consulaat zijn voor een persoon in het buitenland of de Dienst Vreemdelingenzaken voor een asielzoeker."@nl;
  rdfs:comment "Organisatie die het dossier van de persoon in het register beheert."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AdministratiefBeheerder>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: gemeentenaam, land, etc."@nl;
    rdfs:comment "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AdministratiefBeheerder.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee de Organisatie bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount 1;
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ], [
    a shacl:PropertyShape;
    rdfs:label "begindatum"@nl;
    rdfs:comment "Moment vanaf wanneer de instantie van deze klasse op het terrein van toepassing was."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AdministratiefBeheerder.Begindatum>;
    shacl:datatype xsd:date;
    shacl:description "Moment vanaf wanneer de instantie van deze klasse op het terrein van toepassing was."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "begindatum"@nl;
    shacl:path prov:generatedAtTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "einddatum"@nl;
    rdfs:comment "Moment tot wanneer de instantie van deze klasse op het terrein van toepassing was."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AdministratiefBeheerder.Einddatum>;
    shacl:datatype xsd:date;
    shacl:description "Moment tot wanneer de instantie van deze klasse op het terrein van toepassing was."@nl;
    shacl:maxCount 1;
    shacl:name "einddatum"@nl;
    shacl:path prov:invalidatedAtTime
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de AdministratiefBeheerder."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AdministratiefBeheerder.Type>;
    shacl:description "Aard van de AdministratiefBeheerder."@nl;
    shacl:maxCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "Identificator van de AdministratiefBeheerder."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AdministratiefBeheerder.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificator van de AdministratiefBeheerder."@nl;
    shacl:maxCount 1;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/magda/persoon#AdministratiefBeheerder> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AdministratieveBeslissingDocumentShape> a shacl:NodeShape;
  rdfs:label "AdministratieveBeslissingDocument"@nl;
  rdfs:comment "Document dat de beslissing van een overheid vastlegt."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AdministratieveBeslissingDocument>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum"@nl;
    rdfs:comment "Datum waarop de AdministratieveBeslissing is genomen."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AdministratieveBeslissingDocument.Datum>;
    shacl:datatype xsd:date;
    shacl:description "Datum waarop de AdministratieveBeslissing is genomen."@nl;
    shacl:maxCount 1;
    shacl:name "datum"@nl;
    shacl:path dc:date
  ], [
    a shacl:PropertyShape;
    rdfs:label "administratie"@nl;
    rdfs:comment "PubliekeOrganisatie die de Beslissing heeft genomen."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AdministratieveBeslissingDocument.Administratie>;
    shacl:description "PubliekeOrganisatie die de Beslissing heeft genomen."@nl;
    shacl:maxCount 1;
    shacl:name "administratie"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/generiek/administratie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "plaats"@nl;
    <http://purl.org/vocab/vann/usageNote> "In praktijk de (gemeente van) de rechtbank die de Uitspraak doet."@nl;
    rdfs:comment "Plaats waar de AdministratieveBeslissing heeft plaatsgevonden."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AdministratieveBeslissingDocument.Plaats>;
    shacl:class dc:Location;
    shacl:description "Plaats waar de AdministratieveBeslissing heeft plaatsgevonden."@nl;
    shacl:maxCount 1;
    shacl:name "plaats"@nl;
    shacl:path dc:spatial
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/generiek/AdministratieveBeslissingDocument> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld als attribuut van een persoon of gebouw, ... De Adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#Adresvoorstelling>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "administratieveEenheidNiveau1"@nl;
    rdfs:comment "Hoogste Administratieve eenheid van het adres, doorgaans een land."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#Adresvoorstelling.AdministratieveEenheidNiveau1>;
    shacl:datatype rdf:langString;
    shacl:description "Hoogste Administratieve eenheid van het adres, doorgaans een land."@nl;
    shacl:maxCount 1;
    shacl:name "administratieveEenheidNiveau1"@nl;
    shacl:path <http://www.w3.org/ns/locn#adminUnitL1>
  ], [
    a shacl:PropertyShape;
    rdfs:label "administratieveEenheidNiveau2"@nl;
    rdfs:comment "De regio van het adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#Adresvoorstelling.AdministratieveEenheidNiveau2>;
    shacl:datatype rdf:langString;
    shacl:description "De regio van het adres, doorgaans een provincie of deelstaat of gelijkaardig gebied dat typisch meerdere plaatsen omvat."@nl;
    shacl:maxCount 1;
    shacl:name "administratieveEenheidNiveau2"@nl;
    shacl:path <http://www.w3.org/ns/locn#adminUnitL2>
  ], [
    a shacl:PropertyShape;
    rdfs:label "adresgebied"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: de naam van het gehucht waarin het adres ligt."@nl;
    rdfs:comment "Naam van een geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#Adresvoorstelling.Adresgebied>;
    shacl:datatype rdf:langString;
    shacl:description "Naam van een geografisch gebied of plaats die een aantal adresseerbare objecten groepeert om deze te adresseren zonder dat het gebied of de plaats een administratieve eenheid is."@nl;
    shacl:maxCount 1;
    shacl:name "adresgebied"@nl;
    shacl:path <http://www.w3.org/ns/locn#addressArea>
  ], [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding ten behoeve van Belgische adressen."@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount 1;
    shacl:name "busnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    rdfs:comment "Gemeentenaam van het adres."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#Adresvoorstelling.Gemeentenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Gemeentenaam van het adres."@nl;
    shacl:maxCount 1;
