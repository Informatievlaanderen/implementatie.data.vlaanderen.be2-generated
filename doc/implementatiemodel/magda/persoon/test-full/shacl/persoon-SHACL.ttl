<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#NaamsveranderingShape> a shacl:NodeShape;
  rdfs:label "Naamsverandering"@nl;
  <http://purl.org/vocab/vann/usageNote> "In deze context de naam, voornamen of adellijke titel."@nl;
  rdfs:comment "Gebeurtenis waarbij de naam van een Persoon wordt veranderd."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#Naamsverandering>;
