<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#GeregistreerdPersoonShape> a shacl:NodeShape;
  rdfs:label "GeregistreerdPersoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "Doorgaans is dit register een bevolkingsregister maar het kan bijvoorbeeld ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (voorbeeld: naam en voornaam) en de Verblijfplaats van de persoon en op belangrijke levensgebeurtenissen zoals geboorte, huwelijk, overlijden etc. Deze gegevens worden typisch geregistreerd door de overheid, ze bieden de ingeschreven persoon wettelijke bescherming en laten de overheid toe om basisstatistieken op te stellen over zijn bevolking."@nl;
  rdfs:comment "Persoon waarvan de gegevens zijn ingeschreven in een register."@nl;
  rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#GeregistreerdPersoon>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    rdfs:comment "Identificatiecode van de persoon in het register."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#GeregistreerdPersoon.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificatiecode van de persoon in het register."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "registratie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#registratie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "beheerder"@nl;
    <http://purl.org/vocab/vann/usageNote> "Normaal is er maar 1 beheerder aanwezig bij een persoon, maar in uitzonderlijke gevallen kunnen er meerdere beheerders zijn. Bijvoorbeeld: de persoon heeft een adres in het buitenland, is aan het verhuizen tussen gemeenten, etc."@nl;
    rdfs:comment "Verwijzing naar de Adminstratiefbeheerder van het dossier van de persoon."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#GeregistreerdPersoon.Beheerder>;
    shacl:class <https://implementatie.data.vlaanderen.be/ns/magda/persoon#AdministratiefBeheerder>;
    shacl:description "Verwijzing naar de Adminstratiefbeheerder van het dossier van de persoon."@nl;
    shacl:name "beheerder"@nl;
    shacl:path <https://implementatie.data.vlaanderen.be/ns/magda/persoon#beheerder>
  ], [
    a shacl:PropertyShape;
    rdfs:label "registratiedetail"@nl;
    rdfs:comment "Verwijzing naar detail mbt de Registratie van de Persoon."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#GeregistreerdPersoon.Registratiedetail>;
    shacl:description "Verwijzing naar detail mbt de Registratie van de Persoon."@nl;
    shacl:name "registratiedetail"@nl;
    shacl:or ([shacl:class <https://implementatie.data.vlaanderen.be/ns/magda/persoon#Registratie>] [shacl:class <https://implementatie.data.vlaanderen.be/ns/magda/persoon#VoorlopigeRegistratie>]);
    shacl:path <https://implementatie.data.vlaanderen.be/ns/magda/persoon#registratiedetail>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#GeslachtShape> a shacl:NodeShape;
