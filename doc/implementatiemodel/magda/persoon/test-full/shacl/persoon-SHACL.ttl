    shacl:class <https://implementatie.data.vlaanderen.be/ns/magda/persoon#Nationaliteitsverwerving>;
    shacl:description "Hoe en waar de Nationaliteit werd verworven."@nl;
    shacl:maxCount 1;
    shacl:name "verwerving"@nl;
    shacl:path <https://implementatie.data.vlaanderen.be/ns/magda/persoon#verwerving>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Nationaliteit> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#NationaliteitsverwervingShape> a shacl:NodeShape;
