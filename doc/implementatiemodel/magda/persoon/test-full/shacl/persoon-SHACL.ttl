    rdfs:comment "Beschrijving van de Naamsverandering."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/persoon/test-full#Naamsverandering.Beschrijving>;
