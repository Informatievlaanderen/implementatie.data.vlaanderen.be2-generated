{
  "title": "Plaats",
  "type": "object",
  "description": "Een ruimtelijk gebied of benoemde plaats.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Plaats)",
      "pattern": "^Plaats$"
    },
    "plaatsnaam": {
      "$ref": "#/components/schemas/Plaats.plaatsnaam"
    },
    "landcode": {
      "$ref": "#/components/schemas/Plaats.landcode"
    },
    "identificator": {
      "type": "array",
      "description": "Identificator van de Plaats. Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}