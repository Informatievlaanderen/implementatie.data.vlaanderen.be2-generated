{
  "title": "Document",
  "type": "object",
  "description": "Informatie vastgelegd op een gegevensdrager.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Document)",
      "pattern": "^Document$"
    },
    "beschrijving": {
      "$ref": "#/components/schemas/Document.beschrijving"
    },
    "identificator": {
      "type": "array",
      "description": "Identificator van het Document. Lijst van Identificator items.",
      "items": {
        "$ref": "#/components/schemas/Identificator"
      },
      "minItems": 1
    },
    "onderwerp": {
      "type": "array",
      "description": "Datgene waarop het Document betrekking heeft. Lijst van Resource items.",
      "items": {
        "$ref": "#/components/schemas/Resource"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type"
  ]
}