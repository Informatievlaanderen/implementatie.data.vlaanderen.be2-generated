    },
    "naam": {
      "$ref": "#/components/schemas/AlternatieveNaam.naam"
    },
    "begindatum": {
      "$ref": "#/components/schemas/AlternatieveNaam.begindatum"
    },
    "einddatum": {
      "$ref": "#/components/schemas/AlternatieveNaam.einddatum"
    },
    "type": {
      "$ref": "#/components/schemas/AlternatieveNaamtype"
    },
    "geboorte": {
      "$ref": "#/components/schemas/Geboorte"
    },
    "nationaliteit": {
      "$ref": "#/components/schemas/Nationaliteit"
