        "$ref": "#/components/schemas/Probleemdetail"
      },
      "minItems": 1
    },
    "payload": {
      "$ref": "#/components/schemas/GeregistreerdPersoon"
    },
    "@context": {
      "type": "string",
      "description": "URI of the JSON-LD versioned context file for this response.",
      "pattern": "^https:\\/\\/implementatie.data.dev-vlaanderen.be\\/\\/doc\\/implementatiemodel\\/magda\\/persoon\\/v0.0.3\\/context\\/persoon.jsonld$"
    }
  },
  "required": [
    "@type",
    "payload"
  ]
}