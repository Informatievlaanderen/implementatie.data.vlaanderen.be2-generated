{
  "title": "Referentieadres",
  "type": "object",
  "description": "Adres van een andere persoon of rechtspersoon voor personen zonder vaste verblijfplaats.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Referentieadres)",
      "pattern": "^Referentieadres$"
    },
    "einddatum": {
      "type": "object",
      "description": "Datum waarop het Referentieadres eindigt. Enkel verplicht bij Situatie 'Beroepsredenen' (0022).",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "reden": {
      "type": "object",
      "description": "Geeft de reden weer waarom het referentieadres werd toegekend.",
      "properties": {
        "@value": {
          "type": "string"
        },
        "@language": {
          "type": "string",
          "pattern": "^nl$"
        }
      },
      "required": [
        "@value",
        "@language"
      ]
    },
    "status": {
      "$ref": "#/components/schemas/DomicilieStatus"
    },
    "verblijfsadres": {
      "$ref": "#/components/schemas/Adresvoorstelling"
    },
    "nietMededeelbaar": {
      "$ref": "#/components/schemas/NietMededeelbaar"
    }
  },
  "required": [
    "@type",
    "reden",
    "status"
  ]
}