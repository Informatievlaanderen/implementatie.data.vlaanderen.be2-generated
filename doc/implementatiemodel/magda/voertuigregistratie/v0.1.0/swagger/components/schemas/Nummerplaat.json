{
  "title": "Nummerplaat",
  "type": "object",
  "description": "De fysieke bekendmaking van het registratienummer van het Voertuig.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Nummerplaat)",
      "pattern": "^Nummerplaat$"
    },
    "referentiedatum": {
      "type": "object",
      "description": "Datum waarvoor de toestand van de entiteit opgevraagd is.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date-time"
        },
        "@type": {
          "type": "string",
          "pattern": "^DateTime$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "registratienummer": {
      "$ref": "#/components/schemas/Identificator"
    }
  },
  "required": [
    "@type",
    "referentiedatum",
    "registratienummer"
  ]
}