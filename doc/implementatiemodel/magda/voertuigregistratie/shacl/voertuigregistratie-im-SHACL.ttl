<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#AdresvoorstellingShape> a shacl:NodeShape;
  rdfs:label "Adresvoorstelling"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld als attribuut van een persoon of gebouw, ... De adresvoorstelling heeft niet enkel betrekking op Belgische adressen, ze kan gebruikt worden om buitenlandse adressen weer te geven (waar mogelijk andere adresaanduidingen dan huisnummer of busnummer worden gebruikt of waar adrescomponenten zoals adresgebieden voorkomen)."@nl;
  rdfs:comment "Meer leesbare voorstelling met enkel de basisgegevens van het adres, bedoeld voor het gebruik van een adres als attribuut van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "landcode"@nl;
    rdfs:comment "Code van het land waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Adresvoorstelling.Landcode>;
    shacl:datatype xsd:string;
    shacl:description "Code van het land waarin het adres gelegen is."@nl;
    shacl:maxCount 1;
    shacl:name "landcode"@nl;
    shacl:path schemas:addressCountry
  ], [
    a shacl:PropertyShape;
    rdfs:label "busnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding ten behoeve van Belgische adressen."@nl;
    rdfs:comment "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Adresvoorstelling.Busnummer>;
    shacl:datatype xsd:string;
    shacl:description "Officieel toegekende alfanumerieke code die wordt toegevoegd aan het huisnummer om meerdere gebouweenheden, standplaatsen, ligplaatsen of percelen te onderscheiden die eenzelfde huisnummer hebben."@nl;
    shacl:maxCount 1;
    shacl:name "busnummer"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#busnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeentenaam"@nl;
    rdfs:comment "Gemeentenaam van het adres."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Adresvoorstelling.Gemeentenaam>;
    shacl:datatype rdf:langString;
    shacl:description "Gemeentenaam van het adres."@nl;
    shacl:maxCount 1;
    shacl:name "gemeentenaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#Gemeentenaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Specialisatie van Adresvoorstelling:locatieaanduiding ten behoeve van Belgische adressen."@nl;
    rdfs:comment "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Adresvoorstelling.Huisnummer>;
    shacl:datatype xsd:string;
    shacl:description "Alfanumerieke code officieel toegekend aan gebouweenheden, ligplaatsen, standplaatsen of percelen."@nl;
    shacl:maxCount 1;
    shacl:name "huisnummer"@nl;
    shacl:path rdfs:label
  ], [
    a shacl:PropertyShape;
    rdfs:label "land"@nl;
    rdfs:comment "Land waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Adresvoorstelling.Land>;
    shacl:datatype rdf:langString;
    shacl:description "Land waarin het adres gelegen is."@nl;
    shacl:maxCount 1;
    shacl:name "land"@nl;
    shacl:path <https://data.vlaanderen.be/ns/adres#land>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    rdfs:comment "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Adresvoorstelling.Postcode>;
    shacl:datatype xsd:string;
    shacl:description "Code waarmee het geografisch gebied dat adressen voor postale doeleinden groepeert wordt aangeduid."@nl;
    shacl:maxCount 1;
    shacl:name "postcode"@nl;
    shacl:path <http://www.w3.org/ns/locn#postCode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "Straatnaam van het adres."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Adresvoorstelling.Straatnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Straatnaam van het adres."@nl;
    shacl:maxCount 1;
    shacl:name "straatnaam"@nl;
    shacl:path <http://www.w3.org/ns/locn#thoroughfare>
  ], [
    a shacl:PropertyShape;
    rdfs:label "volledigAdres"@nl;
    <http://purl.org/vocab/vann/usageNote> "Vermijdt fouten ten gevolge van het opsplitsen van een adres in zijn onderdelen. Geeft de voorgeschreven volgorde van de verschillende onderdelen weer."@nl;
    rdfs:comment "Het complete adres in één string, al dan niet geformatteerd."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Adresvoorstelling.VolledigAdres>;
    shacl:datatype rdf:langString;
    shacl:description "Het complete adres in één string, al dan niet geformatteerd."@nl;
    shacl:maxCount 1;
    shacl:name "volledigAdres"@nl;
    shacl:path <http://www.w3.org/ns/locn#fullAddress>
  ];
  shacl:targetClass <http://www.w3.org/ns/locn#Address> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@nl;
  <http://purl.org/vocab/vann/usageNote> "Te vervangen door een niet-abstracte klasse."@nl;
  rdfs:comment "Een agent zoals een Persoon, groep, software of fysiek artifact."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/regorg#RegisteredOrganization>,
    foaf:Agent,
    <https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#AnnotatieShape> a shacl:NodeShape;
  rdfs:label "Annotatie"@nl;
  rdfs:comment "Detailinformatie die meegegeven is bij een Uitzondering."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "Naam van het veld."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Annotatie.Naam>;
    shacl:datatype xsd:string;
    shacl:description "Naam van het veld."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "waarde"@nl;
    rdfs:comment "De waarde van het veld."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Annotatie.Waarde>;
    shacl:datatype xsd:string;
    shacl:description "De waarde van het veld."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "waarde"@nl;
    shacl:path rdf:value
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/generiek#Annotatie> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#ConceptShape> shacl:property [
    a shacl:PropertyShape;
    rdfs:label "code"@nl;
    rdfs:comment "Code waarmee het concept binnen de codelijst wordt aangeduid."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Concept.Code>;
    shacl:description "Code waarmee het concept binnen de codelijst wordt aangeduid."@nl;
    shacl:maxCount 1;
    shacl:name "code"@nl;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "voorkeursnaam"@nl;
    rdfs:comment "Naam waarmee het concept bij voorkeur wordt aangeduid."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Concept.Voorkeursnaam>;
    shacl:datatype rdf:langString;
    shacl:description "Naam waarmee het concept bij voorkeur wordt aangeduid."@nl;
    shacl:maxCount 1;
    shacl:name "voorkeursnaam"@nl;
    shacl:path skos:prefLabel
  ] .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#ContactpuntShape> a shacl:NodeShape;
  rdfs:label "Contactpunt"@nl;
  <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen, etc."@nl;
  rdfs:comment "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Adres dat men kan aanschrijven of bezoeken."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Contactpunt.Adres>;
    shacl:class <http://www.w3.org/ns/locn#Address>;
    shacl:description "Adres dat men kan aanschrijven of bezoeken."@nl;
    shacl:maxCount 1;
    shacl:name "adres"@nl;
    shacl:path <http://www.w3.org/ns/locn#address>
  ];
  shacl:targetClass schemas:ContactPoint .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#DateShape> a shacl:NodeShape;
  rdfs:label "Date";
  shacl:closed false;
  shacl:targetClass xsd:date .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#DateTimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#GeboorteShape> a shacl:NodeShape;
  rdfs:label "Geboorte"@nl;
  rdfs:comment "Het ter wereld komen van een Persoon."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "datum"@nl;
    rdfs:comment "Datum waarop de gebeurtenis plaatsvond."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Geboorte.Datum>;
    shacl:datatype xsd:date;
    shacl:description "Datum waarop de gebeurtenis plaatsvond."@nl;
    shacl:maxCount 1;
    shacl:name "datum"@nl;
    shacl:path dc:date
  ], [
    a shacl:PropertyShape;
    rdfs:label "plaats"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gemeente of stad."@nl;
    rdfs:comment "Plaats waar de gebeurtenis plaatsvond."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#Geboorte.Plaats>;
    shacl:class dc:Location;
    shacl:description "Plaats waar de gebeurtenis plaatsvond."@nl;
    shacl:maxCount 1;
    shacl:name "plaats"@nl;
    shacl:path dc:spatial
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#Geboorte> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#GeregistreerdPersoonShape> a shacl:NodeShape;
  rdfs:label "GeregistreerdPersoon"@nl;
  <http://purl.org/vocab/vann/usageNote> "Doorgaans is dit register een bevolkingsregister maar het kan bijvoorbeeld ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (bijvoorbeeld: naam en voornaam) en de Verblijfplaats van de persoon en op belangrijke levensgebeurtenissen zoals geboorte, huwelijk, overlijden, etc. Deze gegevens worden typisch geregistreerd door de overheid, ze bieden de ingeschreven persoon wettelijke bescherming en laten de overheid toe om basisstatistieken op te stellen over zijn bevolking."@nl;
  rdfs:comment "Persoon waarvan de gegevens zijn ingeschreven in een register."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "volledigeNaam"@nl;
    rdfs:comment "De volledige naam van de Persoon, doorgaans de combinatie van voornamen en achternaam."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#GeregistreerdPersoon.VolledigeNaam>;
    shacl:datatype xsd:string;
    shacl:description "De volledige naam van de Persoon, doorgaans de combinatie van voornamen en achternaam."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "volledigeNaam"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#volledigeNaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "referentiedatum"@nl;
    rdfs:comment "Datum waarvoor de toestand van de entiteit opgevraagd is."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#GeregistreerdPersoon.Referentiedatum>;
    shacl:datatype xsd:dateTime;
    shacl:description "Datum waarvoor de toestand van de entiteit opgevraagd is."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "referentiedatum"@nl;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "achternaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Ook wel familienaam genoemd omdat de achternaam een familiale verwantschap aanduidt."@nl;
    rdfs:comment "Gedeelte van de volledige naam van de Persoon ontvangen van de vorige generatie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#GeregistreerdPersoon.Achternaam>;
    shacl:datatype xsd:string;
    shacl:description "Gedeelte van de volledige naam van de Persoon ontvangen van de vorige generatie."@nl;
    shacl:maxCount 1;
    shacl:name "achternaam"@nl;
    shacl:path foaf:familyName
  ], [
    a shacl:PropertyShape;
    rdfs:label "alternatieveNaam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld pseudoniem."@nl;
    rdfs:comment "Alternatief voor de volledige naam van de Persoon."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#GeregistreerdPersoon.AlternatieveNaam>;
    shacl:datatype xsd:string;
    shacl:description "Alternatief voor de volledige naam van de Persoon."@nl;
    shacl:name "alternatieveNaam"@nl;
    shacl:path dc:alternative
  ], [
    a shacl:PropertyShape;
    rdfs:label "voornaam"@nl;
    rdfs:comment "Naam die een Persoon bij geboorte wordt gegeven. Onderscheidt de Persoon van de andere personen in de familie."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#GeregistreerdPersoon.Voornaam>;
    shacl:datatype xsd:string;
    shacl:description "Naam die een Persoon bij geboorte wordt gegeven. Onderscheidt de Persoon van de andere personen in de familie."@nl;
    shacl:name "voornaam"@nl;
    shacl:path foaf:givenName
  ], [
    a shacl:PropertyShape;
    rdfs:label "registratie"@nl;
    rdfs:comment "Identificatiecode van de persoon in het register."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#GeregistreerdPersoon.Registratie>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identificatiecode van de persoon in het register."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "registratie"@nl;
    shacl:path <https://data.vlaanderen.be/ns/persoon#registratie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "geslacht"@nl;
    <http://purl.org/vocab/vann/usageNote> "Het geslacht van een Persoon is sterk afhankelijk van de manier waarop dit gedefinieerd is, dit kan op basis van de biologische kenmerken maar ook op basis van gender, genderindentiteit, genderexpressie, etc. Voor meer informatie zie <a href=\"https://www.vlaanderen.be/dienst-diversiteitsbeleid/begrippen-rond-gender-en-seksuele-diversiteit\">Begrippen rond gender- en seksuele diversiteit</a>."@nl;
    rdfs:comment "De uiting van een Persoon's indentiteit, expressie en sociale rol."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/magda/voertuigregistratie/v0.2.1#GeregistreerdPersoon.Geslacht>;
    shacl:description "De uiting van een Persoon's indentiteit, expressie en sociale rol."@nl;
    shacl:maxCount 1;
