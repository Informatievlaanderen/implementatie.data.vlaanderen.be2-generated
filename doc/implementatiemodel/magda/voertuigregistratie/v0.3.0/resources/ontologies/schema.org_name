  <https://schema.org/text> "\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org/\",\n  \"@type\": \"City\",\n  \"name\": [{\n    \"@value\": \"Worcester\",\n    \"@language\": \"en\"\n  }, {\n    \"@value\": \"/ˈwʊstɚ/\",\n    \"@language\": \"en-fonipa\"\n  }]\n}\n</script>\n" .

