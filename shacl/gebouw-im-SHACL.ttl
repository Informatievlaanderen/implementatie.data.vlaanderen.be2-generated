    <https://implementatie.data.vlaanderen.be/ns/gebouw#GebouweenheidEnvelop>;
  shacl:xone ([
      shacl:not _:df_2_29;
      shacl:property _:df_2_13
    ] [shacl:property _:df_2_11,
