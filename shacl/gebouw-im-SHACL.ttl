<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#GeografischePositieShape> a shacl:NodeShape;
  rdfs:label "Geografische Positie"@nl;
  rdfs:comment "Geografische positie aangegeven door middel van een punt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "geometrie"@nl;
    <http://purl.org/vocab/vann/usageNote> ""@nl;
    rdfs:comment "De cartografische coöordinaten van het punt."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#GeografischePositie.Geometrie>;
    shacl:class <http://www.opengis.net/ont/sf#Point>;
    shacl:description "De cartografische coöordinaten van het punt."@nl;
    shacl:maxCount 2;
    shacl:minCount 1;
    shacl:name "geometrie"@nl;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ], [
    a shacl:PropertyShape;
    rdfs:label "methode"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld positie afgeleid van een bestaand object (bijvoorbeeld door berekening van de centroïde)."@nl;
    rdfs:comment "De manier waarop het punt werd bepaald."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#GeografischePositie.Methode>;
    shacl:description "De manier waarop het punt werd bepaald."@nl;
    shacl:maxCount 1;
    shacl:name "methode"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/generiek#methode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "specificatie"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld perceel, gebouw..."@nl;
    rdfs:comment "Het type object op basis waarvan het punt werd bepaald."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#GeografischePositie.Specificatie>;
    shacl:description "Het type object op basis waarvan het punt werd bepaald."@nl;
    shacl:maxCount 1;
    shacl:name "specificatie"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/generiek#specificatie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/generiek#GeografischePositie> .

