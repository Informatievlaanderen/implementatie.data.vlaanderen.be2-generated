<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#PolygoonShape> a shacl:NodeShape;
  rdfs:label "Polygoon"@nl;
  rdfs:comment "Een poligoon is een vlak oppervlak dat wordt begrensd door 1 buitengrens en 0 of meer binnengrenzen."@nl;
  shacl:closed false;
