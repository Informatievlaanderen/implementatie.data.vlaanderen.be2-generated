<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#ProblemdetailShape> a shacl:NodeShape;
  rdfs:label "Problemdetail"@nl;
  <http://purl.org/vocab/vann/usageNote> "Dit ter aanvulling van een HTTP statuscode,bijvoorbeeld bij een 400 (Bad request) statuscode om aan te geven waarom de request slecht was. Gebaseerd op <a href=\"https://www.rfc-editor.org/rfc/rfc7807\">RFC7807</a>."@nl;
  rdfs:comment "Meer gedetailleerde beschrijving van de fout in een HTTP response."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "detail"@nl;
    rdfs:comment "Mensleesbare beschrijving van de fout."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#Problemdetail.Detail>;
    shacl:datatype xsd:string;
    shacl:description "Mensleesbare beschrijving van de fout."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "detail"@nl;
    shacl:path dc:description
  ], [
    a shacl:PropertyShape;
    rdfs:label "instance"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bijvoorbeeld: de verwijzing naar de request."@nl;
    rdfs:comment "Verwijzing naar de instantie van het object waarop de fout betrekking heeft."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#Problemdetail.Instance>;
    shacl:datatype xsd:anyURI;
    shacl:description "Verwijzing naar de instantie van het object waarop de fout betrekking heeft."@nl;
    shacl:maxCount 1;
    shacl:name "instance"@nl;
    shacl:path dc:references
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@nl;
    <http://purl.org/vocab/vann/usageNote> "Zoals beschreven in <a href=\"https://www.rfc-editor.org/rfc/rfc7231\">RFC7231</a>. Bijvoorbeeld: 404 voor \"Not Found\"."@nl;
    rdfs:comment "HTTP foutcode."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#Problemdetail.Status>;
    shacl:datatype xsd:integer;
    shacl:description "HTTP foutcode."@nl;
    shacl:maxCount 1;
    shacl:name "status"@nl;
    shacl:path <http://www.w3.org/ns/adms#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "title"@nl;
    rdfs:comment "Korte mensleesbare beschrijving van de fout."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#Problemdetail.Title>;
    shacl:datatype xsd:string;
    shacl:description "Korte mensleesbare beschrijving van de fout."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "title"@nl;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Aard van de fout."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#Problemdetail.Type>;
    shacl:datatype xsd:anyURI;
    shacl:description "Aard van de fout."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:path dc:type
  ];
  shacl:targetClass <https://implementatie.data.vlaanderen.be/ns/generiek#Problemdetail> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#PuntShape> a shacl:NodeShape;
  rdfs:label "Punt"@nl;
  rdfs:comment "Een 0-dimensioneel geometrisch object dat een bepaalde locatie in een coördinaatruimte voorstelt. Heeft een x-coördinaat en een y-coördinaat. Kan ook een z-coördinaat (hoogte) en een m-coördinaat (afstand langs een curve) hebben."@nl;
  shacl:closed false;
  shacl:targetClass <http://www.opengis.net/ont/sf#Point> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#RuimtelijkeEenheidShape> a shacl:NodeShape;
  rdfs:label "RuimtelijkeEenheid"@nl;
  rdfs:comment "Eén gebied (of meerdere gebieden) van land en/of water, of één enkel volume (of meerdere volumes) ruimte, afgebakend voor een bepaald doel."@nl;
  shacl:closed false;
  shacl:targetClass <https://data.vlaanderen.be/ns/perceel#RuimtelijkeEenheid> .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/gebouw/v0.0.1#UriShape> a shacl:NodeShape;
  rdfs:label "Uri";
  shacl:closed false;
  shacl:targetClass xsd:anyURI .

