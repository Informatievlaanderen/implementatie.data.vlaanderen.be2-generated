<https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/perceel/v0.0.1#RuimtelijkeEenheidShape> a shacl:NodeShape;
  rdfs:label "RuimtelijkeEenheid"@nl;
  <http://purl.org/vocab/vann/usageNote> "Definitie conform ISO 19152 - Land Administration Domain Model."@nl;
  rdfs:comment "Eén gebied (of meerdere gebieden) van land en/of water, of één enkel volume (of meerdere volumes) ruimte, afgebakend voor een bepaald doel."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "identificator"@nl;
    rdfs:comment "De identificator van de Ruimtelijke Eenheid."@nl;
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/perceel/v0.0.1#RuimtelijkeEenheid.Identificator>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "De identificator van de Ruimtelijke Eenheid."@nl;
    shacl:maxCount 2;
    shacl:name "identificator"@nl;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status";
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/perceel/v0.0.1#RuimtelijkeEenheid.Status>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "status";
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://data.vlaanderen.be/ns/perceel#status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegekendAdres";
    rdfs:seeAlso <https://implementatie.data.test-vlaanderen.be/doc/implementatiemodel/grar/perceel/v0.0.1#RuimtelijkeEenheid.ToegekendAdres>;
    shacl:class <https://data.vlaanderen.be/ns/adres#Adres>;
    shacl:name "toegekendAdres";
    shacl:path <http://todo.com/toegekendAdres>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/perceel#RuimtelijkeEenheid>,
    <https://data.vlaanderen.be/ns/perceel#KadastraalPlanperceel> .

